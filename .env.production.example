# Create a fresh database with scripts/setup-admin.ps1 before starting.
# Use a trusted HTTPS reverse proxy; Node listens on loopback only.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DB_PATH=var/production.db
PUBLIC_ORIGIN=https://replace-with-your-domain.example
ADAPTER_MODE=disabled
SCHEDULER_ENABLED=1
REQUEST_LOG=1
# disabled does not enable WeChat, SMS, payment or external notifications.
# Never reuse the sample development database in production.
