# Local development only. Copy to .env and start with start.ps1.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DB_PATH=var/local.db
ADAPTER_MODE=mock

# External capabilities are opt-in; credentialed platform validation is still required.
IDENTITY_ENCRYPTION_KEY=
WECHAT_AUTH_MODE=disabled
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# HQ website uses an approved Open Platform website application and PUBLIC_ORIGIN.
WECHAT_WEB_AUTH_ENABLED=0
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_PAY_ENABLED=0
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_OFFICIAL_ENABLED=0
WECHAT_OFFICIAL_APP_ID=
WECHAT_OFFICIAL_APP_SECRET=
WECHAT_OFFICIAL_TOKEN=
WECHAT_OFFICIAL_ENCODING_KEY=
WECHAT_SUBSCRIBE_TEMPLATE_ID=
AMAP_KEY=
SMS_PROVIDER=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_TEMPLATE_ID=
SMS_SIGN_NAME=
SMS_REGION=ap-guangzhou
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Business parameters are set through audited headquarters commands, not inferred from samples.
SCHEDULER_ENABLED=1
# Optional, earliest group-approved historical billing period (YYYY-MM). Empty uses observed scheduler history.
BILLING_CATCHUP_FROM_MONTH=

# V3.3 payment routing. Leave credentials empty and channels disabled until authorized.
# Map each exact agreement collectionEntity name to per-channel appId/merchantId.
PAYMENT_MERCHANT_MAPPINGS={}
WECHAT_PAY_REFUND_NOTIFY_URL=
ALIPAY_ENABLED=0
ALIPAY_PRODUCT=
ALIPAY_PRODUCT_AUTHORIZED=0
ALIPAY_APP_ID=
ALIPAY_MERCHANT_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
# Production only accepts https://openapi.alipay.com/gateway.do with formal merchant and application credentials.
ALIPAY_GATEWAY=
ALIPAY_NOTIFY_URL=
BILLING_CATCHUP_FROM_MONTH=
