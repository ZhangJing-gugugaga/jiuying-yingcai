.home-header{margin-bottom:30rpx;padding:6rpx 0 14rpx}
.home-mark{width:76rpx;height:76rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:21rpx;background:var(--brand-deep,#174a80);color:#fff;font-size:39rpx;font-weight:650}
.home-title{color:var(--text,#1c3048);font-size:43rpx;font-weight:700;line-height:1.21}
.home-caption{margin-top:8rpx;color:var(--muted,#52677e);font-size:24rpx}
.home-message{flex-shrink:0;min-height:72rpx;padding:13rpx 21rpx;background:var(--brand-soft,#eaf4ff);color:var(--brand-deep,#174a80);font-size:24rpx}
.home-tools{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13rpx}
.home-tool{width:100%;min-height:138rpx;padding:18rpx 4rpx 16rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:11rpx;border:1rpx solid var(--border,#dfe7f2);background:var(--surface,#fff);color:var(--text,#1c3048);font-size:24rpx}
.home-tool-icon{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;border-radius:14rpx;background:var(--brand-soft,#eaf4ff);color:var(--brand-deep,#174a80);font-size:30rpx;line-height:1}
.home-summary{margin:30rpx 0 24rpx}
.section-link:last-child{border-bottom:0}

.home-intro{position:relative;display:flex;align-items:center;gap:20rpx;min-height:218rpx;padding:28rpx;border-radius:23rpx;background:var(--brand-soft,#eaf4ff);border:1rpx solid var(--border,#dfe7f2)}
.home-intro-copy{flex:1;min-width:0}
.home-intro-label{font-size:25rpx;font-weight:650;color:var(--brand-deep,#174a80)}
.home-intro-title{margin-top:7rpx;color:var(--text,#1c3048);font-size:36rpx;font-weight:700;line-height:1.28;overflow-wrap:anywhere}
.home-intro button{margin-top:18rpx;max-width:100%;width:auto}
.home-intro-image{display:block;flex:0 0 178rpx;width:178rpx;height:146rpx;border-radius:17rpx}
.home-image-note{font-weight:400;font-size:22rpx;color:var(--muted,#52677e)}

.home-services,.home-contact-card{border:1rpx solid var(--border,#dfe7f2);border-radius:23rpx;background:var(--surface,#fff);overflow:hidden}
.home-service,.home-contact{display:flex;align-items:center;justify-content:space-between;gap:16rpx;width:100%;padding:19rpx 23rpx;border-radius:0;border-bottom:1rpx solid var(--border,#dfe7f2);background:var(--surface,#fff);color:var(--text,#1c3048);text-align:left;line-height:1.45}
.home-service:last-child,.home-contact:last-child{border-bottom:0}
.home-service{min-height:104rpx}
.home-service-image{width:103rpx;height:78rpx;flex-shrink:0;border-radius:12rpx}
.home-service-copy{flex:1;min-width:0}
.home-service-title{font-size:28rpx;font-weight:650;overflow-wrap:anywhere}
.home-service-summary{color:var(--muted,#52677e);font-size:24rpx;font-weight:400;margin-top:5rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.home-chevron,.home-contact text{color:var(--brand,#0e65b7);font-size:32rpx;flex-shrink:0}
.home-content-empty{padding:25rpx;border-radius:20rpx;background:var(--surface,#fff);border:1rpx solid var(--border,#dfe7f2);color:var(--muted,#52677e);font-size:25rpx}
.home-map-card{border:1rpx solid var(--border,#dfe7f2);border-radius:22rpx;background:var(--surface,#fff);padding:25rpx;margin-bottom:24rpx}
.home-map-label{font-size:28rpx;font-weight:650}
.home-map-actions{display:flex;gap:15rpx;margin-top:17rpx}
.home-map-actions button{margin:0;min-width:0}
.home-contact{min-height:90rpx;overflow-wrap:anywhere}
