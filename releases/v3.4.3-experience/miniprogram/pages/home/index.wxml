<view class="page">
  <view class="home-header row between">
    <view class="row grow">
      <view class="home-mark" aria-hidden="true">九</view>
      <view class="grow">
        <view class="home-title">九盈英才</view>
        <view wx:if="{{managerName && !isPublic}}" class="home-caption">{{managerName}} · 加盟商工作台</view>
        <view wx:elif="{{isPublic}}" class="home-caption">集团与网点服务</view>
        <view wx:elif="{{displayDate}}" class="home-caption">{{displayDate}}</view>
      </view>
    </view>
    <button wx:if="{{isPublic}}" class="home-message" data-page="login" bindtap="nav">加盟商登录</button>
    <button wx:elif="{{session}}" class="home-message" data-page="messages" bindtap="nav">消息{{unread ? ' · '+unread : ''}}</button>
  </view>
  <view wx:if="{{loading}}" class="loading">正在加载，请稍候…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button></view>

  <block wx:if="{{!isPublic && state}}">
    <view wx:if="{{outletCount !== null}}" class="card row between home-owner">
      <view><view class="card-title">我的网点</view><view class="home-caption">{{outletCount}} 家网点{{displayDate ? ' · '+displayDate : ''}}</view></view>
    </view>
    <view class="section-head">
      <view class="section-title">待办事项</view>
      <button class="link" data-page="tasks" bindtap="nav">查看全部{{todoTotal ? ' · '+todoTotal : ''}}</button>
    </view>
    <view wx:for="{{todoGroups}}" wx:for-item="group" wx:key="status" class="card">
      <view wx:if="{{group.status==='in_progress'}}" class="card-title">处理中</view>
      <view wx:for="{{group.items}}" wx:key="id" class="list-item row">
        <view class="grow">
          <view class="row"><view class="card-title">{{item.title}}</view><text class="badge gray">{{item.category}}</text></view>
          <view wx:if="{{item.detail}}" class="muted top-gap">{{item.detail}}</view>
          <view wx:if="{{item.helpText}}" class="hint">{{item.helpText}}</view>
        </view>
        <button class="link" data-id="{{item.id}}" bindtap="openTodo" disabled="{{loading}}">{{item.actionText}}</button>
      </view>
    </view>
    <view wx:if="{{!todos.length && !loading && !error}}" class="card empty">目前没有需要您处理的事项。</view>

    <view class="section-title">常用服务</view>
    <view class="home-tools">
      <button class="home-tool" data-page="outlets" data-query="scope=private" bindtap="nav"><text class="home-tool-icon" aria-hidden="true">⌖</text><text>我的网点</text></button>
      <button class="home-tool" data-page="reports" bindtap="nav"><text class="home-tool-icon" aria-hidden="true">▤</text><text>经营月报</text></button>
      <button class="home-tool" data-page="fees" bindtap="nav"><text class="home-tool-icon" aria-hidden="true">¥</text><text>咨询服务费</text></button>
      <button class="home-tool" data-page="tasks" bindtap="nav"><text class="home-tool-icon" aria-hidden="true">✓</text><text>我的事项</text></button>
    </view>

    <view wx:if="{{managerName}}" class="card row between">
      <view class="grow">
        <view class="card-title">业务学习与培训</view>
        <view class="muted">课程、学员资料与培训进度</view>
      </view>
      <button class="outline small" data-page="training" bindtap="nav">进入培训</button>
    </view>

    <view wx:if="{{period && !loading && !error}}" class="hero home-summary">
      <view class="hero-title">本月经营概况</view>
      <block wx:if="{{hasCurrentSettlement}}">
        <view wx:if="{{asOf}}" class="muted">数据截至{{asOf}}</view>
        <view class="metrics"><view wx:for="{{metrics}}" wx:key="label" class="metric"><view class="metric-label">{{item.label}}</view><view class="metric-value">{{item.value}}</view></view></view>
      </block>
      <block wx:else>
        <view class="muted top-gap">本月数据尚未结算</view>
        <view wx:if="{{!latestSettledMonth && !reviewing}}" class="muted top-gap">当前暂无可查看的经营数据</view>
        <button wx:if="{{latestSettledMonth}}" class="outline small top-gap" bindtap="openSettled">查看最近一次已结算数据</button>
      </block>
      <view wx:if="{{reviewing}}" class="muted top-gap">部分网点数据正在审核，暂未纳入正式统计</view>
      <button class="outline small top-gap" data-page="dashboard" bindtap="nav">查看经营看板</button>
    </view>

    <view class="card">
      <view class="row between section-link" data-page="agreements" bindtap="nav"><text>服务协议</text><text class="arrow">›</text></view>
      <view class="row between section-link" data-page="finance" bindtap="nav"><text>付款与发票</text><text class="arrow">›</text></view>
      <view class="row between section-link" data-page="discover" bindtap="nav"><text>集团介绍与服务</text><text class="arrow">›</text></view>
      <view class="row between section-link" data-page="discover" data-query="section=cooperation" bindtap="nav"><text>合作咨询</text><text class="arrow">›</text></view>
    </view>
  </block>
  <block wx:elif="{{isPublic}}">
    <view class="home-map-card">
      <view class="home-map-label">服务网点</view>
      <view class="home-caption">查看中国及境外网点地址</view>
      <view class="home-map-actions">
        <button class="primary small" data-page="outlets" data-query="scope=public&mode=list" bindtap="nav">查找服务网点</button>
        <button class="outline small" data-page="outlets" data-query="scope=public&mode=map" bindtap="nav">全域网点地图</button>
      </view>
    </view>
    <view class="home-intro">
      <view class="home-intro-copy">
        <view class="home-intro-label">集团介绍</view>
        <view wx:if="{{groupIntro}}" class="home-intro-title">{{groupIntro.title}}</view>
        <view wx:elif="{{!loading && !error}}" class="home-caption">集团介绍暂未发布。</view>
        <button class="primary small" data-page="discover" data-query="section=brand" bindtap="nav">查看集团介绍</button>
      </view>
      <image wx:if="{{groupIntro.coverPath}}" class="home-intro-image" src="{{groupIntro.coverPath}}" mode="aspectFill" data-id="{{groupIntro.id}}" binderror="publicCoverFailed" aria-label="集团介绍封面" />
      <view wx:elif="{{groupIntro.coverUnavailable}}" class="home-image-note">封面暂时无法加载</view>
    </view>

    <view class="section-head">
      <view class="section-title">五大业务</view>
      <button class="link" data-page="discover" data-query="section=services" bindtap="nav">查看全部</button>
    </view>
    <view wx:if="{{publishedServices.length}}" class="home-services">
      <button wx:for="{{publishedServices}}" wx:key="id" class="home-service" data-id="{{item.id}}" bindtap="openService">
        <image wx:if="{{item.coverPath}}" class="home-service-image" src="{{item.coverPath}}" mode="aspectFill" data-id="{{item.id}}" binderror="publicCoverFailed" aria-label="{{item.title}}封面" />
        <view class="home-service-copy">
          <view class="home-service-title">{{item.title}}</view>
          <view wx:if="{{item.summary}}" class="home-service-summary">{{item.summary}}</view>
          <view wx:if="{{item.coverUnavailable}}" class="home-image-note">封面暂时无法加载</view>
        </view>
        <text class="home-chevron" aria-hidden="true">›</text>
      </button>
    </view>
    <view wx:elif="{{!loading && !error}}" class="home-content-empty">当前暂无已发布的业务介绍。</view>

    <view class="section-title">联系总部</view>
    <view class="home-contact-card">
      <button class="home-contact" data-page="support" bindtap="nav">联系客服 <text aria-hidden="true">›</text></button>
      <button class="home-contact" data-page="discover" data-query="section=cooperation" bindtap="nav">合作咨询 <text aria-hidden="true">›</text></button>
    </view>

    <view wx:if="{{publicUpdates.length}}" class="section-title">集团动态与案例</view>
    <view wx:if="{{publicUpdates.length}}" class="home-contact-card">
      <button wx:for="{{publicUpdates}}" wx:key="id" class="home-contact" data-section="{{item.key}}" bindtap="openPublicUpdate">{{item.title}} <text aria-hidden="true">›</text></button>
    </view>
  </block>
</view>
