<view class="page">
  <view wx:if="{{loading}}" class="loading">正在加载，请稍候…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button></view>
  <block wx:if="{{outlet && !error}}">
    <view class="title">{{outlet.name}}</view>
    <view class="row between">
      <text wx:if="{{internal && organizationName}}" class="muted">所属加盟商：{{organizationName}}</text>
      <text class="badge {{outlet.statusTone}}">{{outlet.statusText}}</text>
    </view>
    <view wx:if="{{internal && outlet.statusNote}}" class="hint">{{outlet.statusNote}}</view>
    <view class="card top-gap">
      <view wx:if="{{internal}}" class="card-title">网点资料</view>
      <view wx:if="{{internal && outlet.districtText}}" class="detail-row"><text>所在地区</text><text>{{outlet.districtText}}</text></view>
      <view wx:if="{{!internal && outlet.area}}" class="detail-row"><text>所在地区</text><text>{{outlet.area}}</text></view>
      <view wx:if="{{outlet.address}}" class="detail-row"><text>{{internal ? '经营地址' : '对外地址'}}</text><text>{{outlet.address}}</text></view>
      <view wx:if="{{internal && outlet.phone}}" class="detail-row"><text>联系电话</text><text>{{outlet.phone}}</text></view>
      <view wx:if="{{internal && outlet.openingText}}" class="detail-row"><text>预计开业日期</text><text>{{outlet.openingText}}</text></view>
      <view wx:if="{{internal}}" class="detail-row"><text>营业状态</text><text>{{outlet.statusText}}</text></view>
      <view wx:if="{{internal && outlet.statusSince}}" class="detail-row"><text>状态生效日期</text><text>{{outlet.statusSince}}</text></view>
      <view wx:if="{{internal}}" class="detail-row"><text>招生业务适用情况</text><text>{{outlet.enrollmentText}}</text></view>
      <button wx:if="{{outlet.address}}" class="link top-gap" bindtap="copy">复制地址</button>
    </view>
    <block wx:if="{{internal}}">
      <view class="section-title">本月经营情况</view>
      <view class="card">
        <view class="row between"><text>经营月报</text><text wx:if="{{summary}}" class="badge {{summary.settled ? 'success' : 'gray'}}">{{summary.settled ? '数据已结算' : '本月数据尚未结算'}}</text></view>
        <view wx:if="{{summaryError}}" class="hint">暂时无法获取本月经营数据，请刷新后重试。</view>
        <block wx:if="{{summary.settled}}">
          <view class="detail-row"><text>营业收入</text><text>{{summary.revenueText}}</text></view>
          <view class="detail-row"><text>有效完成订单</text><text>{{summary.ordersText}}</text></view>
          <view class="detail-row"><text>到店人次</text><text>{{summary.trafficText}}</text></view>
          <view class="detail-row"><text>实际招生人数</text><text>{{summary.enrollText}}</text></view>
        </block>
      </view>
      <view wx:if="{{workContact}}" class="card top-gap">
        <view class="detail-row"><text>{{workContact.title}}</text><text>{{workContact.phone}}</text></view>
        <button class="outline small" bindtap="dialWorkContact" loading="{{workContactDialing}}" disabled="{{workContactDialing}}">拨打工作电话</button>
      </view>
      <view class="grid">
        <button data-page="report" bindtap="action">填写经营月报</button>
        <button data-page="fees" bindtap="action">查看服务费账单</button>
        <button data-page="location" bindtap="action">提交位置核验</button>
        <button data-page="requests" bindtap="action">提交业务申请</button>
        <button data-page="support" bindtap="action">联系总部客服</button>
      </view>
      <view class="section-title">暂停营业与收费</view>
      <view class="card">
        <view class="hint">暂停营业和暂停收费需要分别申请，可在相关申请记录中查看进度。</view>
        <view class="actions top-gap">
          <button wx:if="{{outlet.status==='open'}}" class="outline" data-page="requests" data-type="statusChange" data-status="paused" bindtap="action">申请暂停营业</button>
          <button class="outline" data-page="requests" data-type="pauseFee" bindtap="action">申请暂停收费</button>
        </view>
      </view>
      <view class="section-title">营业状态变更记录</view>
      <view wx:for="{{history}}" wx:key="index" class="card">
        <view class="row between"><text>{{item.statusText}}</text><text class="muted">{{item.dateText}}</text></view>
      </view>
      <view wx:if="{{!history.length}}" class="muted">暂无营业状态变更记录。</view>
      <view class="section-title">位置变更记录</view>
      <view wx:for="{{locationHistory}}" wx:key="index" class="card">
        <view class="muted">{{item.at}}</view>
        <view wx:if="{{item.before}}" class="detail-row"><text>变更前地址</text><text>{{item.before}}</text></view>
        <view wx:if="{{item.after}}" class="detail-row"><text>变更后地址</text><text>{{item.after}}</text></view>
      </view>
      <view wx:if="{{!locationHistory.length}}" class="muted">暂无位置变更记录。</view>
      <view class="grid top-gap">
        <button data-page="location" data-history="true" bindtap="action">位置核验记录</button>
        <button data-page="requests" data-history="true" bindtap="action">相关申请记录</button>
      </view>
    </block>
  </block>
  <view wx:if="{{!outlet && !loading && !error}}" class="empty">暂时无法获取网点信息，请重试。</view>
</view>
