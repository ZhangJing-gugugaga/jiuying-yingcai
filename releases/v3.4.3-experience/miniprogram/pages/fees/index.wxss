/* Shared visual system is defined in app.wxss. */
.mock-payment-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 38, 33, 0.56);
  padding: 36rpx;
}
.mock-payment-dialog {
  width: 100%;
  max-width: 680rpx;
  max-height: 90vh;
  overflow-y: auto;
}
