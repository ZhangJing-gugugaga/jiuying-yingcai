<view class="page">
  <view class="title">咨询服务费</view>
  <view class="subtitle">按网点查看服务费账单、付款记录和费用调整。</view>
  <button class="link" data-page="finance" data-query="{{selected ? ('outlet=' + selected) : ''}}" bindtap="nav">查看付款与凭证</button>
  <view wx:if="{{loading}}" class="loading">正在加载，请稍候…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button></view>
  <view class="field">
    <input placeholder="搜索网点名称或地区" value="{{outletSearch}}" bindconfirm="outletSearch" />
    <picker range="{{outlets}}" range-key="name" value="{{outletIndex}}" bindchange="filterOutlet">
      <view class="picker">{{outlets[outletIndex].name || '全部网点'}}</view>
    </picker>
    <button wx:if="{{pagers.outlets.hasMore}}" class="link" data-collection="outlets" bindtap="more" disabled="{{loading || pagers.outlets.loading}}">加载更多网点</button>
  </view>
  <view class="row between">
    <picker mode="date" fields="month" value="{{filterMonthValue}}" bindchange="filterMonth"><view class="picker">{{filterMonthValue || '全部账单月份'}}</view></picker>
    <button class="link" bindtap="clearFilters">清除筛选</button>
  </view>
  <view class="filter">
    <view class="pill {{statusFilter==='all'?'active':''}}" data-status="all" bindtap="filterStatus">全部账单</view>
    <view class="pill {{statusFilter==='unpaid'?'active':''}}" data-status="unpaid" bindtap="filterStatus">待支付</view>
    <view class="pill {{statusFilter==='paid'?'active':''}}" data-status="paid" bindtap="filterStatus">已支付</view>
    <view class="pill {{statusFilter==='reversed'?'active':''}}" data-status="reversed" bindtap="filterStatus">已冲正</view>
  </view>
  <view class="row between">
    <text class="section-title">应付账单</text>
    <button class="link" data-page="requests" data-query="{{selected ? 'type=pauseFee&outlet='+selected : 'type=pauseFee'}}" bindtap="nav">申请暂停收费</button>
  </view>
  <view class="hint">网点暂停营业不会自动暂停咨询服务费。如需暂停收费，请单独提交申请，由总部审核。</view>
  <view wx:if="{{paymentNotice}}" class="notice">{{paymentNotice}}<button wx:if="{{paymentBillQuery}}" class="link" data-page="finance" data-query="{{paymentBillQuery}}" bindtap="nav">查看原账单</button></view>
  <button wx:if="{{payment.status==='pending' && state.adapterMode==='real'}}" class="outline" data-id="{{payment.id}}" bindtap="resume" disabled="{{busy}}">查看付款状态</button>
  <view wx:for="{{bills}}" wx:key="id" class="card">
    <view class="card-title">{{item.outletName}}</view>
    <view class="detail-row"><text>账单月份</text><text>{{item.monthText}}</text></view>
    <view wx:if="{{item.status==='reversed'}}" class="detail-row"><text>原账单金额</text><text>¥ {{item.amountText}}</text></view>
    <view wx:if="{{item.payableText}}" class="detail-row"><text>应付金额</text><text>¥ {{item.payableText}}</text></view>
    <view wx:if="{{item.paidText}}" class="detail-row"><text>已支付金额</text><text>¥ {{item.paidText}}</text></view>
    <view wx:if="{{item.unpaidText}}" class="detail-row"><text>待支付金额</text><text>¥ {{item.unpaidText}}</text></view>
    <view class="detail-row"><text>账单状态</text><text class="badge {{item.statusTone}}">{{item.statusText}}</text></view>
    <button class="link" data-page="finance" data-query="{{'ledgerBillId='+item.id+'&outlet='+item.outlet}}" bindtap="nav">查看账单</button>
    <button class="link" data-page="finance" data-query="{{'ledgerBillId='+item.id+'&outlet='+item.outlet+'&section=payments'}}" bindtap="nav">查看付款记录</button>
    <!-- DEV_ONLY_START -->
    <view wx:if="{{item.simulation}}" class="hint">测试账单</view>
    <view wx:if="{{item.status==='unpaid' && state.adapterMode==='mock'}}" class="actions">
      <button class="outline small" data-id="{{item.id}}" data-channel="wechat" bindtap="confirmSimulation" disabled="{{busy || loading}}">模拟微信支付</button>
      <button class="outline small" data-id="{{item.id}}" data-channel="alipay" bindtap="confirmSimulation" disabled="{{busy || loading}}">模拟支付宝</button>
    </view>
    <!-- DEV_ONLY_END -->
    <block wx:if="{{item.status==='unpaid'}}">
      <button wx:if="{{state.adapterMode==='real' && paymentEnabled}}" class="primary" data-id="{{item.id}}" bindtap="pay" disabled="{{busy}}">立即支付</button>
      <view wx:if="{{state.adapterMode==='real' && paymentEnabled}}" class="hint">微信支付</view>
      <view wx:if="{{state.adapterMode==='real' && !paymentEnabled}}" class="hint">微信支付暂未开放。</view>
    </block>
    <button wx:if="{{item.status==='unpaid'}}" class="outline top-gap" data-page="finance" data-query="{{'type=offline&billId='+item.id+'&ledgerBillId='+item.id+'&outlet='+item.outlet}}" bindtap="nav">登记线下付款</button>
  </view>
  <view wx:if="{{state && !bills.length && !loading && !error}}" class="empty">当前暂无符合条件的账单。</view>
  <view wx:if="{{pagers.bills.hasMore}}" class="pagination"><button class="outline small" data-collection="bills" bindtap="more" loading="{{pagers.bills.loading}}" disabled="{{loading || pagers.bills.loading}}">加载更多账单</button></view>

  <view class="section-title">付款记录</view>
  <view wx:for="{{payments}}" wx:key="id" class="card">
    <view class="row between"><text>{{item.outletName}}</text><text class="badge {{item.statusTone}}">{{item.statusText}}</text></view>
    <view class="detail-row"><text>{{item.dateText}}</text><text>¥ {{item.amountText}}</text></view>
    <view wx:if="{{item.channel}}" class="hint">{{item.channel==='alipay' ? '支付宝' : '微信支付'}}</view>
    <button wx:if="{{item.billId}}" class="link top-gap" data-page="finance" data-query="{{'ledgerBillId='+item.billId+'&outlet='+item.outlet+'&section=payments&ledgerRecordId='+item.id}}" bindtap="nav">查看原账单</button>
    <!-- DEV_ONLY_START -->
    <view wx:if="{{item.adapterMode==='mock'}}" class="hint">测试付款</view>
    <button wx:if="{{item.status==='pending' && state.adapterMode==='mock'}}" class="link" data-id="{{item.id}}" bindtap="resumeSimulation" disabled="{{busy || loading}}">继续模拟支付</button>
    <!-- DEV_ONLY_END -->
    <button wx:if="{{item.status==='pending' && item.adapterMode!=='mock' && state.adapterMode==='real'}}" class="link" data-id="{{item.id}}" bindtap="resume" disabled="{{busy}}">查看付款状态</button>
    <button wx:if="{{item.status==='pending' && item.adapterMode!=='mock' && state.adapterMode==='real'}}" class="link" data-id="{{item.id}}" bindtap="closeExpired" disabled="{{busy}}">关闭过期付款</button>
  </view>
  <view wx:if="{{state && !payments.length && !loading && !error}}" class="empty">暂无付款记录。</view>
  <view wx:if="{{pagers.payments.hasMore}}" class="pagination"><button class="outline small" data-collection="payments" bindtap="more" loading="{{pagers.payments.loading}}" disabled="{{loading || pagers.payments.loading}}">加载更多付款记录</button></view>

  <view class="section-title">实收记录</view>
  <view wx:for="{{receipts}}" wx:key="id" class="card">
    <view class="row between"><text>{{item.outletName}}</text><text>¥ {{item.amountText}}</text></view>
    <view wx:if="{{item.dateText}}" class="muted">{{item.dateText}}</view>
    <view wx:if="{{item.status==='success' && item.adapterMode!=='mock'}}" class="actions">
      <button class="outline small" data-page="finance" data-query="{{'type=refund&receiptId='+item.id+'&ledgerBillId='+item.billId+'&outlet='+item.outlet}}" bindtap="nav">退款申请</button>
      <button class="outline small" data-page="finance" data-query="{{'type=invoice&receiptId='+item.id+'&ledgerBillId='+item.billId+'&outlet='+item.outlet}}" bindtap="nav">发票申请</button>
    </view>
  </view>
  <view wx:if="{{state && !receipts.length && !loading && !error}}" class="empty">暂无实收记录。</view>
  <view wx:if="{{pagers.receipts.hasMore}}" class="pagination"><button class="outline small" data-collection="receipts" bindtap="more" loading="{{pagers.receipts.loading}}" disabled="{{loading || pagers.receipts.loading}}">加载更多实收记录</button></view>

  <view class="section-title">费用调整记录</view>
  <view class="hint">费用调整以总部财务核算结果为准。</view>
  <view wx:for="{{adjustments}}" wx:key="id" class="card">
    <view class="card-title">{{item.outletName}}</view>
    <view class="badge {{item.statusTone}} top-gap">{{item.statusText}}</view>
    <view wx:if="{{item.status==='待财务核算调整'}}" class="hint">申请已通过，费用调整正在核算。最终金额和服务期限以总部核算结果为准。</view>
    <block wx:else>
      <view wx:if="{{item.amount!=null}}" class="detail-row"><text>调整金额</text><text>¥ {{item.amountText}}</text></view>
      <view wx:if="{{item.offsetMonthText}}" class="detail-row"><text>抵扣月份</text><text>{{item.offsetMonthText}}</text></view>
      <view wx:if="{{item.serviceUntilText}}" class="detail-row"><text>服务可使用至</text><text>{{item.serviceUntilText}}</text></view>
    </block>
  </view>
  <view wx:if="{{state && !adjustments.length && !loading && !error}}" class="empty">暂无费用调整记录。</view>
  <view wx:if="{{pagers.adjustments.hasMore}}" class="pagination"><button class="outline small" data-collection="adjustments" bindtap="more" loading="{{pagers.adjustments.loading}}" disabled="{{loading || pagers.adjustments.loading}}">加载更多费用调整</button></view>
  <button class="link top-gap" data-page="agreements" bindtap="nav">查看服务协议</button>
  <!-- DEV_ONLY_START -->
  <view wx:if="{{state.adapterMode==='mock' && (simulationPrompt || payment)}}" class="mock-payment-overlay">
    <view class="card mock-payment-dialog">
      <block wx:if="{{simulationPrompt}}">
        <view class="card-title">{{simulationPrompt.channel==='alipay' ? '支付宝模拟付款' : '微信模拟付款'}}</view>
        <view class="detail-row"><text>付款网点</text><text>{{simulationPrompt.outletName}}</text></view>
        <view class="detail-row"><text>账单月份</text><text>{{simulationPrompt.monthText}}</text></view>
        <view class="detail-row"><text>待支付金额</text><text>¥ {{simulationPrompt.payableText}}</text></view>
        <view class="hint">当前为模拟支付，不会产生真实扣款。</view>
        <view wx:if="{{error}}" class="error">{{error}}</view>
        <view class="actions">
          <button class="outline" bindtap="cancelSimulationPrompt" disabled="{{busy}}">取消</button>
          <button class="primary" bindtap="startSimulation" loading="{{busy}}" disabled="{{busy || loading}}">确认模拟付款</button>
        </view>
      </block>
      <block wx:else>
        <view class="card-title">{{payment.channel==='alipay' ? '支付宝模拟付款' : '微信模拟付款'}}</view>
        <view class="hint">当前为模拟支付，不会产生真实扣款。</view>
        <view wx:if="{{error}}" class="error">{{error}}</view>
        <view wx:if="{{paymentNotice}}" class="notice">{{paymentNotice}}</view>
        <view wx:if="{{busy}}" class="loading">正在处理，请稍候…</view>
        <view class="actions">
          <button class="primary" data-outcome="success" bindtap="resolve" disabled="{{busy}}">模拟成功</button>
          <button data-outcome="failed" bindtap="resolve" disabled="{{busy}}">模拟失败</button>
        </view>
        <button class="outline top-gap" data-outcome="cancelled" bindtap="resolve" disabled="{{busy}}">取消模拟支付</button>
        <button wx:if="{{error || paymentNotice}}" class="link top-gap" bindtap="dismissSimulation" disabled="{{busy}}">返回账单</button>
      </block>
    </view>
  </view>
  <!-- DEV_ONLY_END -->
</view>
