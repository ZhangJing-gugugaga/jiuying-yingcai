<view class="page">
  <view class="title">经营看板</view>
  <view class="subtitle">查看本人名下网点的经营情况。</view>
  <view wx:if="{{loading || dashboardLoading}}" class="loading">正在加载，请稍候…</view><view wx:if="{{error}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button></view>
  <view class="two-col"><picker mode="date" fields="month" value="{{period}}" bindchange="period"><view class="picker">{{dashboardReady ? periodDisplay : period}}　⌄</view></picker><picker range="{{kinds}}" value="{{kindIndex}}" bindchange="kind"><view class="picker">{{kinds[kindIndex]}}　⌄</view></picker></view>
  <view class="field"><input placeholder="搜索网点名称或地区" value="{{outletSearch}}" bindconfirm="outletSearch"/></view><view wx:if="{{pagers.outlets.hasMore}}" class="pagination"><text class="muted">已显示 {{pagers.outlets.loaded}} / {{pagers.outlets.total}} 个网点</text><button class="outline small" data-collection="outlets" bindtap="more" loading="{{pagers.outlets.loading}}" disabled="{{loading || pagers.outlets.loading}}">加载更多</button></view><picker range="{{outlets}}" range-key="name" value="{{outletIndex}}" bindchange="outlet"><view class="picker top-gap">{{outlets[outletIndex].name}}　⌄</view></picker>
  <view class="filter"><view class="pill {{mode==='settled'?'active':''}}" data-mode="settled" bindtap="mode">已结算数据</view><view class="pill {{mode==='process'?'active':''}}" data-mode="process" bindtap="mode">已审核通过</view></view>
  <block wx:if="{{dashboardReady && !loading && !dashboardLoading && !error}}">
  <view wx:if="{{settlementPending && !loading && !error}}" class="notice"><view class="card-title">经营数据更新中</view><view>{{settlementDescription}}</view></view>
  <view wx:if="{{settlementUpdated && !loading && !error}}" class="notice">经营数据已更新。</view>
  <view wx:if="{{dataStatus}}" class="notice">{{dataStatus}}</view>
  <view wx:if="{{coverage.pendingReview > 0}}" class="hint">部分网点数据尚未完成审核</view>
  <view wx:if="{{coverage}}" class="card"><view class="row between"><view class="card-title">月报进度</view><text class="badge {{coverage.expected===0?'gray':(coverage.complete?'':'wait')}}">{{coverage.expected===0 ? '无应报月报' : (coverage.complete ? '已齐全' : '待完成')}}</text></view><view class="coverage-grid"><view class="coverage-cell"><text class="coverage-number">{{coverage.expected}}</text><text class="muted">{{kind==='month' ? '应报网点' : '应报网点月'}}</text></view><view class="coverage-cell"><text class="coverage-number">{{coverage.submitted}}</text><text class="muted">已提交</text></view><view class="coverage-cell"><text class="coverage-number">{{coverage.approved}}</text><text class="muted">已审核通过</text></view><view class="coverage-cell"><text class="coverage-number">{{coverage.pendingReview}}</text><text class="muted">总部审核中</text></view><view class="coverage-cell"><text class="coverage-number">{{coverage.exempt}}</text><text class="muted">已免报</text></view><view class="coverage-cell"><text class="coverage-number">{{coverage.overdue}}</text><text class="muted">逾期未报</text></view></view><view class="hint">已免报网点不计入应报未报数量。</view>
  <view wx:if="{{coverage.awaitingEnrollment !== undefined && coverage.notApplicable !== undefined}}" class="hint">招生业务待确认：{{coverage.awaitingEnrollment}}家；不适用：{{coverage.notApplicable}}家。</view>
  <view wx:if="{{kind==='month' && dueDisplay}}" class="hint">报送截止日期 {{dueDisplay}}</view></view><view wx:if="{{hasData}}" class="metrics"><view wx:for="{{metrics}}" wx:key="label" class="metric"><view class="metric-label">{{item.label}}</view><view class="metric-value">{{item.value}}</view></view></view>
  <view class="section-head"><view class="section-title">网点经营对比</view><view class="row"><button class="link" data-format="xlsx" bindtap="export" disabled="{{busy}}">导出Excel</button><button class="link" data-format="pdf" bindtap="export" disabled="{{busy}}">导出PDF</button></view></view>
  <view class="card"><view wx:for="{{rows}}" wx:key="outlet" class="bar-row"><view class="row between"><text>{{item.name}}</text><text>¥ {{item.revenueText}}</text></view><view class="bar-track"><view class="bar-fill" style="width:{{item.width}}%"/></view></view><view wx:if="{{!rows.length}}" class="empty">当前范围暂无可统计数据</view></view>
  <view wx:if="{{exportError}}" class="error">{{exportError}}</view>
  <view class="section-title">近6个月营业收入</view><view class="card"><view wx:for="{{trend}}" wx:key="month" class="bar-row"><view class="row between"><text>{{item.monthDisplay}} {{item.partial ? '· 数据不全' : ''}}</text><text>¥ {{item.value}}</text></view><view class="bar-track"><view class="bar-fill" style="width:{{item.width}}%"/></view></view></view>
  <block wx:if="{{kind==='month'}}"><view class="section-title">同比与环比</view><view class="hint">环比基期：{{momDisplay}} · 同比基期：{{yoyDisplay}}</view><view class="card"><view class="detail-row"><text>指标</text><text>环比 / 同比</text></view><view wx:for="{{comparisons}}" wx:key="key" class="detail-row"><text>{{item.label}}</text><text>{{item.mom}} / {{item.yoy}}</text></view></view></block>
  <view wx:if="{{kind==='month' && incomparable}}" class="hint">当前期间缺少可比较数据。</view>
  </block>
</view>
