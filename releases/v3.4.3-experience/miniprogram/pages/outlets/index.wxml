<view class="page">
  <view class="title">{{directory || isPublic ? '服务网点' : '我的网点'}}</view>
  <view wx:if="{{!directory && !isPublic}}" class="subtitle">查看网点资料、营业状态和相关业务。</view>
  <view wx:if="{{loading}}" class="loading">正在加载，请稍候…</view>
  <view wx:if="{{error}}" class="error">暂时无法获取网点信息，请重试。<button class="link top-gap" bindtap="refresh">重试</button></view>
  <view wx:if="{{state && !isPublic}}" class="filter">
    <button class="outline small" data-scope="{{directory ? 'private' : 'public'}}" bindtap="changeScope">{{directory ? '返回我的网点' : '浏览服务网点'}}</button>
  </view>
  <view class="field"><input placeholder="输入网点名称或所在地区" value="{{search}}" bindconfirm="search" maxlength="100" confirm-type="search"/></view>
  <block wx:if="{{directory}}">
    <view class="filter directory-filter">
      <button wx:for="{{geography}}" wx:key="value" class="pill {{geo===item.value ? 'active' : ''}}" data-geo="{{item.value}}" bindtap="filterGeography">{{item.label}}</button>
    </view>
    <view class="country-filter">
      <picker wx:if="{{countryChoices.length>1}}" range="{{countryChoices}}" range-key="name" value="{{countryIndex}}" bindchange="filterCountry"><view class="picker">{{countryChoices[countryIndex].name}}　⌄</view></picker>
      <button wx:else class="outline small" bindtap="openCountries">按国家或地区筛选</button>
    </view>
  </block>
  <view wx:if="{{!directory || geo!=='overseas' && (!countryCode || countryCode==='CN')}}" class="row between region-filter">
    <picker class="grow" mode="region" value="{{region}}" bindchange="region"><view class="picker">{{region.length ? region[0] + ' / ' + region[1] + ' / ' + region[2] : '按省 / 市 / 区筛选'}}　⌄</view></picker>
    <button wx:if="{{region.length}}" class="link" bindtap="clearRegion">清除地区</button>
  </view>
  <view wx:if="{{state && !directory && !isPublic}}" class="filter">
    <button wx:for="{{statusFilters}}" wx:key="value" class="pill {{statusFilter===item.value ? 'active' : ''}}" data-status="{{item.value}}" bindtap="filterStatus">{{item.label}}</button>
  </view>
  <view class="row between">
    <view class="filter">
      <button class="pill {{mode==='list' ? 'active' : ''}}" data-mode="list" bindtap="mode">网点列表</button>
      <button class="pill {{mode==='map' ? 'active' : ''}}" data-mode="map" bindtap="mode">分布地图</button>
    </view>
    <button wx:if="{{!directory && !isPublic && state}}" class="link" data-page="requests" data-query="type=newOutlet" bindtap="nav">申请新增网点</button>
  </view>
  <block wx:if="{{state && !loading && !error}}">
    <block wx:if="{{mode==='map'}}">
      <view wx:if="{{directory}}" class="row between directory-map-options">
        <text class="muted grow">{{geo==='overseas' ? '境外底图若显示不全，可按地址查找。' : '可按地址查找当前范围内的网点。'}}</text>
        <button class="link" bindtap="modeUnavailable">查看地址列表</button>
      </view>
      <view wx:if="{{mapLoading}}" class="loading">正在加载地图{{pointCount ? '，已找到 '+pointCount+' 处公开位置' : ''}}…</view>
      <view wx:if="{{mapError}}" class="error">
        {{mapError}}
        <view class="actions">
          <button wx:if="{{directory}}" class="outline small" bindtap="loadPublicMap">重试地图</button>
          <button wx:else class="outline small" bindtap="modeUnavailable">返回网点列表</button>
        </view>
      </view>
      <view wx:if="{{markers.length && !mapError}}" class="map-panel">
        <view wx:if="{{directory}}" class="row between map-toolbar">
          <text class="muted">{{pointCount}} 家网点已公开位置</text>
          <button class="link" bindtap="resetViewport">查看全部位置</button>
        </view>
        <map id="outlet-map" class="map outlet-map" latitude="{{center.lat}}" longitude="{{center.lng}}" scale="{{zoom}}" min-scale="{{minScale}}" max-scale="{{maxScale}}" markers="{{markers}}" bindmarkertap="marker" bindlabeltap="marker" bindregionchange="regionChanged" binderror="mapFailed" enable-zoom="{{true}}" enable-scroll="{{true}}" show-location="{{false}}"/>
        <view wx:if="{{selectedPoint}}" class="row between map-result">
          <text class="grow">{{selectedPoint.name}}</text>
          <button class="primary small" data-id="{{selectedPoint.id}}" bindtap="open">查看网点</button>
        </view>
        <view wx:if="{{clusterRows.length}}" class="map-result">
          <view class="card-title">这一带有 {{clusterTotal}} 家网点</view>
          <button wx:for="{{clusterRows}}" wx:key="id" class="map-outlet-link" data-id="{{item.id}}" bindtap="open"><text>{{item.name}}</text><text>›</text></button>
          <button wx:if="{{clusterRows.length<clusterTotal}}" class="outline small top-gap" bindtap="moreCluster">查看更多网点</button>
        </view>
      </view>
      <view wx:if="{{!markers.length && rows.length && !mapLoading && !mapError}}" class="empty">{{directory ? '暂无网点公开位置，可查看下方网点地址。' : '当前网点暂无可显示的地图位置，可查看下方网点地址。'}}</view>
    </block>
    <view wx:for="{{rows}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open">
      <view class="row between"><view class="card-title">{{item.name}}</view><text class="badge {{item.statusTone}}">{{item.statusText}}</text></view>
      <view wx:if="{{directory ? item.area : item.province || item.city || item.district}}" class="muted top-gap">{{directory ? item.area : item.province ? item.province+' · '+item.city+' · '+item.district : item.city}}</view>
      <view class="detail-row"><text>{{item.address}}</text><text class="arrow">›</text></view>
      <block wx:if="{{!directory}}">
        <view wx:for="{{item.summaryRows}}" wx:for-item="summary" wx:key="key" class="detail-row">
          <text>{{summary.title}} · {{summary.monthText}}</text><text>{{summary.statusText}}</text>
        </view>
        <view wx:if="{{!item.summaryRows.length}}" class="muted">经营状态摘要暂不可查看。</view>
      </block>
    </view>
    <view wx:if="{{!rows.length}}" class="empty">
      {{search || region.length || countryCode || (!directory && statusFilter!=='all') ? '未找到符合条件的网点，请调整搜索内容。' : directory ? geo==='overseas' ? '当前暂无已公开的境外网点。' : '当前暂无可查看的服务网点。' : '您当前还没有网点，可提交新增网点申请。'}}
    </view>
    <view wx:if="{{pagers.outlets.hasMore}}" class="pagination">
      <text class="muted">已显示 {{pagers.outlets.loaded}} / {{pagers.outlets.total}} 家网点</text>
      <button class="outline small" data-collection="outlets" bindtap="more" loading="{{pagers.outlets.loading}}" disabled="{{loading || pagers.outlets.loading}}">加载更多</button>
    </view>
  </block>
</view>
