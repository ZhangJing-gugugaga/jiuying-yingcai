<view class="page login">
  <view class="brand-mark">九</view>
  <view class="title">九盈英才</view>
  <view class="subtitle login-subtitle">加盟商服务</view>
  <view class="login-entry">
    <button class="{{mode==='activate' ? 'outline' : 'primary'}}" data-mode="password" bindtap="mode" disabled="{{busy}}">已有账号登录</button>
    <button class="{{mode==='activate' ? 'primary' : 'outline'}}" data-mode="activate" bindtap="mode" disabled="{{busy}}">首次激活</button>
  </view>

  <view class="card">
    <view wx:if="{{mode!=='activate' && (smsEnabled || wechatEnabled)}}" class="filter">
      <button class="pill {{mode==='password' ? 'active' : ''}}" data-mode="password" bindtap="mode" disabled="{{busy}}">账号密码</button>
      <button wx:if="{{smsEnabled}}" class="pill {{mode==='sms' ? 'active' : ''}}" data-mode="sms" bindtap="mode" disabled="{{busy}}">手机验证码</button>
      <button wx:if="{{wechatEnabled}}" class="pill {{mode==='wechat' ? 'active' : ''}}" data-mode="wechat" bindtap="mode" disabled="{{busy}}">微信登录</button>
    </view>

    <block wx:if="{{mode==='password'}}">
      <view class="hint">使用总部为您登记的账号登录。</view>
      <view class="field"><label>账号</label><input value="{{username}}" data-field="username" bindinput="input" placeholder="请输入账号" maxlength="120"/></view>
      <view class="field"><label>密码</label><input value="{{password}}" data-field="password" bindinput="input" password="{{true}}" maxlength="128" placeholder="请输入密码"/></view>
      <button class="primary" bindtap="passwordLogin" loading="{{busy}}" disabled="{{busy}}">登录</button>
    </block>

    <block wx:elif="{{mode==='activate'}}">
      <view class="hint">输入总部发放的一次性激活码，设置您的登录密码。</view>
      <view class="field"><label>激活码</label><input value="{{activationToken}}" data-field="activationToken" bindinput="input" placeholder="请输入激活码" password="{{true}}" maxlength="128"/></view>
      <view class="field"><label>设置密码</label><input value="{{password}}" data-field="password" bindinput="input" password="{{true}}" maxlength="128" placeholder="请输入登录密码"/></view>
      <view class="field"><label>确认密码</label><input value="{{confirmPassword}}" data-field="confirmPassword" bindinput="input" password="{{true}}" maxlength="128" placeholder="再次输入登录密码"/></view>
      <view class="hint">登录密码至少12位。</view>
      <button class="primary" bindtap="activate" loading="{{busy}}" disabled="{{busy}}">激活并登录</button>
    </block>

    <block wx:elif="{{mode==='sms' && smsEnabled}}">
        <view class="field"><label>总部登记手机号</label><input type="number" value="{{mobile}}" data-field="mobile" bindinput="input" maxlength="11" placeholder="请输入手机号" disabled="{{busy}}"/></view>
        <view class="field">
          <label>验证码</label>
          <view class="actions sms-actions">
            <input class="sms-code" type="number" value="{{smsCode}}" data-field="smsCode" bindinput="input" maxlength="6" placeholder="请输入短信验证码"/>
            <button class="outline small" bindtap="sendSms" disabled="{{busy || resendSeconds}}">{{resendSeconds ? resendSeconds+'秒后重发' : '获取验证码'}}</button>
          </view>
        </view>
        <!-- DEV_ONLY_START -->
        <view wx:if="{{smsMode==='mock'}}" class="notice">测试短信未实际发送。{{devCode ? '测试验证码：'+devCode : ''}}</view>
        <!-- DEV_ONLY_END -->
        <button class="primary" bindtap="smsLogin" loading="{{busy}}" disabled="{{busy}}">验证并登录</button>
    </block>

    <block wx:elif="{{mode==='wechat' && wechatEnabled}}">
        <view class="card-title">微信快捷登录</view>
        <view class="hint">微信账号需先与总部登记的负责人身份完成绑定。</view>
        <button class="primary" bindtap="wechatLogin" loading="{{busy}}" disabled="{{busy}}">微信登录</button>
    </block>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>

  <view class="row between login-help">
    <text class="hint">没有激活码或忘记密码？</text>
    <button class="link" bindtap="contact" disabled="{{busy}}">联系总部客服</button>
  </view>
  <button class="outline top-gap login-browse" bindtap="visitor" disabled="{{busy}}">浏览集团介绍与网点</button>
  <button class="link top-gap" bindtap="privacy">隐私保护指引</button>

  <!-- DEV_ONLY_START -->
  <view wx:if="{{development}}" class="card top-gap">
    <view class="card-title">开发测试</view>
    <picker range="{{choices}}" range-key="name" value="{{index}}" bindchange="select"><view class="picker">{{choices[index].name}}　⌄</view></picker>
    <view class="field"><input value="{{customActor}}" bindinput="customActor" placeholder="测试身份标识（选填）"/></view>
    <button class="outline" bindtap="enter" loading="{{busy}}" disabled="{{busy}}">使用测试身份</button>
  </view>
  <!-- DEV_ONLY_END -->
</view>
