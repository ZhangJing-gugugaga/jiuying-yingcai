<view class="page">
  <view class="title">消息</view>
  <view wx:if="{{loading}}" class="loading">正在加载，请稍候…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button></view>
  <view class="filter">
    <view class="pill {{statusFilter==='all'?'active':''}}" data-status="all" bindtap="filterStatus">全部</view>
    <view class="pill {{statusFilter==='unread'?'active':''}}" data-status="unread" bindtap="filterStatus">未读</view>
    <view class="pill {{statusFilter==='read'?'active':''}}" data-status="read" bindtap="filterStatus">已读</view>
  </view>
  <view wx:for="{{messages}}" wx:key="id" id="notice-{{item.id}}" class="card">
    <view class="row between"><text class="badge gray">{{item.category}}</text><text class="muted">{{item.read ? '已读' : '未读'}}</text></view>
    <view class="card-title top-gap"><text wx:if="{{!item.read}}" class="dot"/>{{item.title}}</view>
    <view wx:if="{{item.body}}" class="hint">{{item.body}}</view>
    <view wx:if="{{item.displayTime}}" class="muted">{{item.displayTime}}</view>
    <view class="row">
      <button wx:if="{{item.hasLink}}" class="link top-gap" data-id="{{item.id}}" bindtap="open">查看详情</button>
      <button wx:if="{{!item.read}}" class="link top-gap" data-id="{{item.id}}" bindtap="read" disabled="{{busy}}">标为已读</button>
    </view>
  </view>
  <view wx:if="{{!messages.length && !loading && !error}}" class="empty">目前没有新的消息。</view>
  <view wx:if="{{messages.length && !isPublic}}" class="hint">消息已读不会自动完成相关待办，请按页面提示完成对应事项。</view>
  <view wx:if="{{pagers.messages.hasMore}}" class="pagination"><button class="outline small" data-collection="messages" bindtap="more" loading="{{pagers.messages.loading}}" disabled="{{loading || pagers.messages.loading}}">加载更多</button></view>
</view>
