<view class="page">
  <view class="title">经营月报</view>
  <view wx:if="{{loading}}" class="loading">正在加载，请稍候…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button></view>
  <view wx:if="{{isPublic && !loading}}" class="card">
    <view class="card-title">经营月报供加盟商填写</view>
    <view class="hint">使用总部登记的账号登录后，可按网点查看及填写月报。</view>
    <view class="actions">
      <button class="primary small" data-page="login" bindtap="nav">使用账号登录</button>
      <button class="outline small" data-page="outlets" data-query="scope=public" bindtap="nav">查看服务网点</button>
    </view>
  </view>
  <block wx:elif="{{state && !isPublic}}">
  <view class="subtitle">按网点和月份填写经营数据，查看总部审核结果。</view>
    <view class="two-col">
      <picker range="{{options}}" range-key="name" value="{{outletIndex}}" bindchange="pickOutlet"><view class="picker">{{options[outletIndex].name || '全部网点'}}　⌄</view></picker>
      <picker mode="date" fields="month" value="{{month}}" bindchange="changeMonth"><view class="picker">{{monthDisplay || '经营月份'}}　⌄</view></picker>
    </view>
    <view class="hint">报送状态</view>
    <view class="filter">
      <view class="pill {{filter==='all'?'active':''}}" data-value="all" bindtap="filter">全部</view>
      <view class="pill {{filter==='missing'?'active':''}}" data-value="missing" bindtap="filter">待填写</view>
      <view class="pill {{filter==='draft'?'active':''}}" data-value="draft" bindtap="filter">草稿</view>
      <view class="pill {{filter==='pending'?'active':''}}" data-value="pending" bindtap="filter">总部审核中</view>
      <view class="pill {{filter==='finance'?'active':''}}" data-value="finance" bindtap="filter">财务复核中</view>
      <view class="pill {{filter==='returned'?'active':''}}" data-value="returned" bindtap="filter">待我修改</view>
      <view class="pill {{filter==='approved'?'active':''}}" data-value="approved" bindtap="filter">已通过</view>
      <view class="pill {{filter==='late'?'active':''}}" data-value="late" bindtap="filter">逾期补报</view>
      <view class="pill {{filter==='exempt'?'active':''}}" data-value="exempt" bindtap="filter">已免报</view>
    </view>
    <view class="hint">请按总部公布的报送日期填写。超过截止日期仍可补报，系统会标记为逾期。</view>
    <button wx:if="{{session.role==='partner'}}" class="primary top-gap" bindtap="newReport">填报经营月报</button>
    <view wx:if="{{draftRows.length}}" class="section-title">未完成的草稿</view>
    <view wx:if="{{draftRows.length}}" class="hint">您已保存但尚未提交的经营数据。</view>
    <view wx:for="{{draftRows}}" wx:key="id" class="card" data-outlet="{{item.outlet}}" data-month="{{item.month}}" bindtap="open">
      <view class="row between"><text class="card-title">{{item.outletName}}</text><text class="badge wait">草稿</text></view>
      <view class="detail-row"><text>{{item.monthDisplay}}</text><text>继续填写</text></view>
    </view>
    <view wx:if="{{pagers.drafts.hasMore}}" class="pagination"><button class="outline small" data-collection="drafts" bindtap="more" disabled="{{loading || pagers.drafts.loading}}">加载更多草稿</button></view>
    <view wx:for="{{rows}}" wx:key="id" class="card" data-outlet="{{item.outlet}}" data-month="{{item.month}}" data-id="{{item.id}}" bindtap="open">
      <view class="row between"><text class="card-title">{{item.outletName}}</text><text class="badge {{item.statusTone}}">{{item.statusText}}</text></view>
      <view class="detail-row"><text>{{item.monthDisplay}}经营月报 · V{{item.version}}</text><text>{{item.status==='returned' ? '查看处理意见' : '查看详情'}}</text></view>
      <view class="muted">{{item.effectiveText}}</view><view class="muted">{{item.submittedText}}</view>
      <view wx:if="{{item.lateSubmission || item.late}}" class="badge wait">逾期补报</view>
      <view wx:if="{{item.review}}" class="muted top-gap">{{item.review}}</view>
    </view>
    <view wx:for="{{specialRows}}" wx:key="id" class="card" data-outlet="{{item.outlet}}" data-month="{{item.month}}" bindtap="open">
      <view class="row between"><text class="card-title">{{item.outletName}}</text><text class="badge {{item.statusTone}}">{{item.statusText}}</text></view>
      <view class="detail-row"><text>{{item.monthDisplay}}经营月报</text><text>{{filter==='missing' ? '继续填写' : '查看详情'}}</text></view>
    </view>
    <view wx:if="{{!rows.length && !draftRows.length && !specialRows.length && !loading && !error}}" class="empty">{{filter==='draft' ? '暂无已保存的草稿。' : (filter==='missing' && !pagers.businessTasks.hasMore ? '您当前没有待填写的月报。' : '当前筛选条件下暂无经营月报。')}}</view>
    <view wx:if="{{pagers.reports.hasMore}}" class="pagination"><button class="outline small" data-collection="reports" bindtap="more" loading="{{pagers.reports.loading}}" disabled="{{loading || pagers.reports.loading}}">加载更多</button></view>
    <view wx:if="{{specialCollection && filter!=='draft' && pagers[specialCollection].hasMore}}" class="pagination"><button class="outline small" data-collection="{{specialCollection}}" bindtap="more" disabled="{{loading || pagers[specialCollection].loading}}">加载更多</button></view>
    <view wx:if="{{pagers.outlets.hasMore}}" class="pagination"><button class="outline small" data-collection="outlets" bindtap="more" disabled="{{loading || pagers.outlets.loading}}">加载更多网点</button></view>
  </block>
</view>
