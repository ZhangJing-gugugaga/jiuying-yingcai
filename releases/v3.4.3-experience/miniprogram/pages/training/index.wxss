.training-toolbar .field { margin-bottom: 0; }
.training-tabs, .training-actions { display: flex; gap: 16rpx; flex-wrap: wrap; }
.training-tabs button { flex: 1; font-size: 27rpx; }
.training-tabs + .field { margin-top: 24rpx; }
.training-course { margin-top: 20rpx; }
.training-text { line-height: 1.7; white-space: pre-wrap; word-break: break-word; }
.training-separator { margin-top: 24rpx; padding-top: 20rpx; border-top: 1px solid #dbe7f3; }
.training-status { font-size: 22rpx; line-height: 1.4; border-radius: 999rpx; padding: 6rpx 14rpx; white-space: nowrap; color: #174972; background: #e7f2fb; }
.training-status.ok { color: #135239; background: #e8f5ee; }
.training-status.warn { color: #804600; background: #fff1d9; }
.training-meta { margin-top: 10rpx; }
.training-note, .training-notice { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 14rpx; color: #174972; background: #edf6ff; line-height: 1.45; }
.training-notice { margin: 0 0 18rpx; }
.training-attachment { padding: 10rpx 0; }
.training-preview { display: block; width: 100%; height: 240rpx; margin: 16rpx 0; background-color: #f2f6fb; border-radius: 16rpx; }
.training-actions { margin-top: 16rpx; }
