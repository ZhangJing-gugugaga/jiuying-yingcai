<view class="page compact">
  <view class="title">我的待办</view>
  <view class="subtitle">以下事项需要您处理或补充资料。</view>
  <view wx:if="{{loading}}" class="loading">正在加载，请稍候…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button></view>
  <view class="filter">
    <view class="pill {{status==='open'?'active':''}}" data-status="open" bindtap="status">待处理</view>
    <view class="pill {{status==='in_progress'?'active':''}}" data-status="in_progress" bindtap="status">处理中</view>
    <view class="pill {{status==='resolved'?'active':''}}" data-status="resolved" bindtap="status">已完成</view>
    <view class="pill {{status==='all'?'active':''}}" data-status="all" bindtap="status">全部</view>
  </view>
  <view wx:for="{{taskRows}}" wx:key="id" class="card">
    <view class="row between"><view class="card-title">{{item.title}}</view><text class="badge {{item.statusTone}}">{{item.statusText}}</text></view>
    <view wx:if="{{item.outletName}}" class="detail-row"><text>所属网点</text><text>{{item.outletName}}</text></view>
    <view wx:if="{{item.month}}" class="detail-row"><text>所属月份</text><text>{{item.month}}</text></view>
    <view wx:if="{{item.notifiedText}}" class="detail-row"><text>通知时间</text><text>{{item.notifiedText}}</text></view>
    <view wx:if="{{item.dueText}}" class="detail-row"><text>截止日期</text><text>{{item.dueText}}</text></view>
    <button wx:if="{{item.canOpen}}" class="link top-gap" data-id="{{item.id}}" bindtap="open">{{item.completed ? '查看详情' : '去处理'}}</button>
  </view>
  <view wx:if="{{!taskRows.length && !loading && !error}}" class="empty">{{status==='open' ? '目前没有需要您处理的待办。' : '当前筛选下暂无待办。'}}</view>
  <view wx:if="{{pagers.businessTasks.hasMore}}" class="pagination">
    <text class="muted">已显示 {{pagers.businessTasks.loaded}} / {{pagers.businessTasks.total}} 条</text>
    <button class="outline small" data-collection="businessTasks" bindtap="more" loading="{{pagers.businessTasks.loading}}" disabled="{{loading || pagers.businessTasks.loading}}">加载更多</button>
  </view>
</view>
