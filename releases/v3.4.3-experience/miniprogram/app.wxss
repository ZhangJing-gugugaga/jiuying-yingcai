page {
  --brand: #0e65b7;
  --brand-deep: #174a80;
  --brand-soft: #eaf4ff;
  --brand-on-dark: #d9eaff;
  --background: #f6f9fd;
  --surface: #ffffff;
  --text: #1c3048;
  --muted: #52677e;
  --border: #dfe7f2;
  --border-strong: #afc5db;
  --surface-muted: #f0f5fb;
  --neutral-bg: #edf1f5;
  --neutral-text: #526377;
  --success-bg: #e8f5ee;
  --success-text: #256648;
  --warning-bg: #fff3d8;
  --warning-text: #78541d;
  --error-bg: #fff0ee;
  --error-text: #9f4135;
  background: #f6f9fd;
  background: var(--background);
  color: #1c3048;
  color: var(--text);
  font-family: -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,text,input,textarea,button {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

button {
  font-size: 27rpx;
  border-radius: 16rpx;
  background: #eaf4ff;
  background: var(--brand-soft);
  color: #0e65b7;
  color: var(--brand);
  line-height: 1.5;
  padding: 23rpx 26rpx;
  margin: 0;
  font-weight: 600;
}

button.primary {
  background: #0e65b7;
  background: var(--brand);
  color: #ffffff;
  color: var(--surface);
}

button.outline {
  border: 1rpx solid #afc5db;
  border: 1rpx solid var(--border-strong);
  background: transparent;
}

button.small {
  font-size: 24rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
}

button.link {
  background: transparent;
  padding: 0;
  color: #174a80;
  color: var(--brand-deep);
  text-align: left;
  font-size: 26rpx;
  font-weight: 600;
}

button.danger {
  color: #9f4135;
  color: var(--error-text);
  background: #fff0ee;
  background: var(--error-bg);
}

.page {
  padding: 38rpx 36rpx 68rpx;
}

.eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #52677e;
  color: var(--muted);
  font-weight: 600;
  text-transform: uppercase;
}

.title {
  font-size: 50rpx;
  font-weight: 650;
  letter-spacing: -2rpx;
  margin: 8rpx 0 12rpx;
  line-height: 1.3;
}

.subtitle {
  color: #52677e;
  color: var(--muted);
  font-size: 25rpx;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 650;
  margin: 44rpx 0 20rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 38rpx 0 20rpx;
}

.section-head .section-title {
  margin: 0;
}

.hero {
  background: #174a80;
  background: var(--brand-deep);
  border-radius: 28rpx;
  color: white;
  padding: 34rpx;
  position: relative;
  overflow: hidden;
}

.hero::after {
  content: "";
  position: absolute;
  right: -75rpx;
  top: -90rpx;
  width: 260rpx;
  height: 260rpx;
  border: 1rpx solid rgba(255, 255, 255, .22);
  border-radius: 50%;
  pointer-events: none;
}

.hero .muted {
  color: #d9eaff;
  color: var(--brand-on-dark);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  margin: 10rpx 0 26rpx;
  max-width: 510rpx;
}

.hero-number {
  font-size: 64rpx;
  letter-spacing: -2rpx;
  line-height: 1.1;
  margin: 10rpx 0;
}

.hero small {
  font-size: 22rpx;
}

.card {
  padding: 28rpx;
  background: #ffffff;
  background: var(--surface);
  border-radius: 22rpx;
  margin: 18rpx 0;
  border: 1rpx solid #dfe7f2;
  border: 1rpx solid var(--border);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
}

.muted {
  color: #52677e;
  color: var(--muted);
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.between {
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
  margin: 26rpx 0 4rpx;
}

.metric {
  padding: 24rpx;
  background: #ffffff;
  background: var(--surface);
  border-radius: 20rpx;
}

.metric-value {
  font-size: 36rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
  margin-top: 8rpx;
}

.metric-label {
  font-size: 23rpx;
  color: #52677e;
  color: var(--muted);
}

.hero .metrics {
  border-top: 1rpx solid rgba(255, 255, 255, .25);
  padding-top: 25rpx;
  gap: 26rpx;
}

.hero .metric {
  background: transparent;
  padding: 0;
}

.hero .metric-label {
  color: #d9eaff;
  color: var(--brand-on-dark);
}

.hero .metric-value {
  font-size: 34rpx;
}

.badge {
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 5rpx 12rpx;
  color: #256648;
  color: var(--success-text);
  background: #e8f5ee;
  background: var(--success-bg);
  white-space: nowrap;
}

.badge.wait {
  background: #fff3d8;
  background: var(--warning-bg);
  color: #78541d;
  color: var(--warning-text);
}

.badge.gray {
  background: #edf1f5;
  background: var(--neutral-bg);
  color: #526377;
  color: var(--neutral-text);
}

.badge.red {
  background: #fff0ee;
  background: var(--error-bg);
  color: #9f4135;
  color: var(--error-text);
}

.list-item {
  padding: 27rpx 0;
  border-bottom: 1rpx solid #dfe7f2;
  border-bottom: 1rpx solid var(--border);
}

.list-item:last-child {
  border-bottom: 0;
}

.arrow {
  color: #52677e;
  color: var(--muted);
  font-size: 36rpx;
}

.count {
  font-size: 24rpx;
  color: #174a80;
  color: var(--brand-deep);
}

.icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #eaf4ff;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 31rpx;
  color: #174a80;
  color: var(--brand-deep);
}

.tile {
  background: #ffffff;
  background: var(--surface);
  border: 1rpx solid #dfe7f2;
  border: 1rpx solid var(--border);
  border-radius: 22rpx;
  padding: 28rpx;
  text-align: left;
}

.tile .label {
  font-size: 27rpx;
  font-weight: 600;
  margin: 22rpx 0 4rpx;
}

.tile .muted {
  font-size: 22rpx;
}

.hint {
  font-size: 23rpx;
  color: #52677e;
  color: var(--muted);
  line-height: 1.7;
  margin: 20rpx 0;
}

.notice {
  padding: 24rpx;
  background: #eaf4ff;
  background: var(--brand-soft);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #174a80;
  color: var(--brand-deep);
  margin: 20rpx 0;
}

.error {
  padding: 24rpx;
  background: #fff0ee;
  background: var(--error-bg);
  color: #9f4135;
  color: var(--error-text);
  border-radius: 16rpx;
  margin: 20rpx 0;
  font-size: 25rpx;
}

.empty {
  padding: 64rpx 24rpx;
  text-align: center;
  color: #52677e;
  color: var(--muted);
  font-size: 27rpx;
}

.loading {
  padding: 20rpx 0;
  color: #52677e;
  color: var(--muted);
  font-size: 24rpx;
}

.field {
  margin: 24rpx 0;
}

.field label {
  display: block;
  font-size: 25rpx;
  color: #52677e;
  color: var(--muted);
  margin-bottom: 14rpx;
}

.field input,.field textarea,.picker {
  background: #f6f9fd;
  background: var(--background);
  border: 1rpx solid #dfe7f2;
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 23rpx 20rpx;
  width: 100%;
  font-size: 29rpx;
  color: #1c3048;
  color: var(--text);
  min-height: 88rpx;
}

.field input {
  height: 88rpx;
}

.field textarea {
  height: 160rpx;
}

.field .unit {
  font-size: 23rpx;
  color: #52677e;
  color: var(--muted);
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.actions button {
  flex: 1;
}

.divider {
  height: 1rpx;
  background: #dfe7f2;
  background: var(--border);
  margin: 28rpx 0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 30rpx;
  padding: 17rpx 0;
  font-size: 26rpx;
}

.detail-row text:first-child {
  color: #52677e;
  color: var(--muted);
}

.detail-row text:last-child {
  text-align: right;
  max-width: 430rpx;
}

.filter {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0;
  flex-wrap: wrap;
}

.pill {
  padding: 13rpx 23rpx;
  background: #eaf4ff;
  background: var(--brand-soft);
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #174a80;
  color: var(--brand-deep);
}

.pill.active {
  background: #0e65b7;
  background: var(--brand);
  color: #ffffff;
  color: var(--surface);
}

.map {
  width: 100%;
  height: 350rpx;
  border-radius: 22rpx;
  margin: 20rpx 0;
}

.photo {
  width: 170rpx;
  height: 170rpx;
  border-radius: 16rpx;
  margin: 20rpx 0;
}

.chat {
  max-width: 92%;
  padding: 22rpx 26rpx;
  background: #ffffff;
  background: var(--surface);
  border-radius: 20rpx;
  margin: 18rpx 0;
  color: #1c3048;
  color: var(--text);
  word-break: break-all;
}

.chat.mine {
  margin-left: auto;
  background: #eaf4ff;
  background: var(--brand-soft);
}

.bar-row {
  margin: 18rpx 0;
}

.bar-track {
  height: 12rpx;
  border-radius: 8rpx;
  background: #dfe7f2;
  background: var(--border);
  overflow: hidden;
  margin-top: 9rpx;
}

.bar-fill {
  height: 12rpx;
  background: #0e65b7;
  background: var(--brand);
  border-radius: 8rpx;
}

.brand-mark {
  width: 96rpx;
  height: 96rpx;
  border: 1rpx solid #afc5db;
  border: 1rpx solid var(--border-strong);
  border-radius: 24rpx;
  color: #174a80;
  color: var(--brand-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-bottom: 64rpx;
  background: #eaf4ff;
  background: var(--brand-soft);
}

.login {
  padding-top: 80rpx;
}

.login .title {
  font-size: 65rpx;
  line-height: 1.25;
  letter-spacing: -3rpx;
}

.login-intro {
  margin: 28rpx 0 70rpx;
  color: #52677e;
  color: var(--muted);
  font-size: 28rpx;
  max-width: 540rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  background: #0e65b7;
  background: var(--brand);
  color: #d9eaff;
  color: var(--brand-on-dark);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

.top-gap {
  margin-top: 28rpx;
}

.support-dock {
  margin-top: 30rpx;
}

.dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #0e65b7;
  background: var(--brand);
  display: inline-block;
  margin-right: 10rpx;
}

.two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
}

.two-col .field {
  margin: 12rpx 0;
}

.hero button.outline {
  color: #ffffff;
  color: var(--surface);
  border-color: rgba(255,255,255,.45);
  background: transparent;
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 24rpx 0;
  padding: 20rpx 0;
  border-top: 1rpx solid #dfe7f2;
  border-top: 1rpx solid var(--border);
}

.pagination .muted {
  font-size: 22rpx;
}

.article {
  white-space: pre-wrap;
  line-height: 1.9;
  font-size: 27rpx;
  color: #1c3048;
  color: var(--text);
}

.gold {
  color: #174a80;
  color: var(--brand-deep);
}

.compact .title {
  font-size: 44rpx;
}

.steps {
  border-left: 2rpx solid #afc5db;
  border-left: 2rpx solid var(--border-strong);
  padding-left: 25rpx;
  margin: 24rpx 0;
}

.section-link {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #dfe7f2;
  border-bottom: 1rpx solid var(--border);
}

.section-head .section-title {
  flex-shrink: 0;
}

.section-head>button {
  width: auto;
  flex-shrink: 0;
}

.detail-row {
  overflow-wrap: anywhere;
}

.picker {
  overflow-wrap: anywhere;
}

.pagination button {
  flex-shrink: 0;
}

input,textarea {
  font-family: inherit;
}

button[disabled], button.primary[disabled], button.pill[disabled] {
  background: #edf1f5;
  background: var(--neutral-bg);
  color: #526377;
  color: var(--neutral-text);
  border-color: #dfe7f2;
  border-color: var(--border);
  opacity: 1;
}
