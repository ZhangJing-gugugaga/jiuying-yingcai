<page-meta page-style="{{inlineConfirmation ? 'overflow: hidden;' : ''}}"/>
<view class="page report-page {{directReturnedEdit ? 'report-returned-editor' : ''}}">
  <view wx:if="{{loading}}" class="loading">正在同步最新信息…</view>
  <view wx:if="{{error && !showActionError}}" class="error">
    {{error}}
    <button class="link top-gap" bindtap="refresh" disabled="{{busy || loading || switching}}">重试</button>
  </view>

  <view wx:if="{{!linkedVersion && !versionUnavailable && (searchExpanded || (!outlets.length && outletSearch))}}" class="card">
    <view class="row">
      <input class="grow" placeholder="搜索网点名称或地区" value="{{searchDraft === undefined ? outletSearch : searchDraft}}" bindinput="searchInput" bindconfirm="searchOutlets" confirm-type="search" disabled="{{busy || inlineConfirmation || loading || switching}}"/>
      <button class="outline small" bindtap="searchOutlets" disabled="{{busy || inlineConfirmation || loading || switching}}">搜索</button>
    </view>
  </view>
  <view wx:if="{{!outlets.length && !loading && !error}}" class="empty">未找到符合条件的网点，请调整搜索内容。</view>
  <block wx:if="{{outlets.length}}">
    <view wx:if="{{outletId && returnedReason && (directReturnedEdit || !(canEdit && formExpanded))}}" class="report-return">
      <view class="report-return-title">
        <t-icon t-class="report-return-icon" name="error-circle-filled" size="{{directReturnedEdit ? '44rpx' : '32rpx'}}" aria-hidden="true"/>
        <text>月报已退回，请修改后重新提交</text>
      </view>
      <view class="report-return-reason"><text class="report-return-reason-label">退回原因：</text>{{returnedReason}}</view>
      <view wx:if="{{currentApprovedVersion}}" class="report-return-note">原已审核月报仍然有效。</view>
    </view>
    <view class="card report-context">
      <view wx:if="{{!directReturnedEdit}}" class="report-section-title">填报信息</view>
      <view wx:if="{{directReturnedEdit}}" class="report-facts">
        <view class="report-fact">
          <view class="report-fact-label"><t-icon t-class="report-fact-icon" name="shop" size="28rpx" aria-hidden="true"/><text>网点</text></view>
          <text class="report-fact-value report-outlet-name">{{outletNames[outletIndex + 1]}}</text>
        </view>
        <view class="report-fact">
          <view class="report-fact-label"><t-icon t-class="report-fact-icon" name="calendar" size="28rpx" aria-hidden="true"/><text>账期</text></view>
          <text class="report-fact-value">{{monthDisplay || month}}</text>
        </view>
        <view class="report-fact">
          <view class="report-fact-label"><t-icon t-class="report-fact-icon" name="time" size="28rpx" aria-hidden="true"/><text>当前状态</text></view>
          <text class="badge {{displayStatusTone}}">{{returnedReason ? '退回修改' : displayStatus}}</text>
        </view>
      </view>
      <view wx:elif="{{linkedVersion || versionUnavailable}}" class="report-identity">
        <text class="card-title report-outlet-name">{{outletNames[outletIndex + 1]}}</text>
        <text class="muted">{{monthDisplay || month}} · 经营月报</text>
      </view>
      <view wx:else class="report-scope">
        <view wx:if="{{outlets.length}}" class="field">
          <label>网点</label>
          <picker range="{{outletNames}}" value="{{outletIndex + 1}}" bindchange="chooseOutletFromPicker" disabled="{{busy || inlineConfirmation || loading || switching}}">
            <view class="picker picker-control">{{outletNames[outletIndex + 1]}}</view>
          </picker>
        </view>
        <view class="field">
          <label>经营月份</label>
          <picker mode="date" fields="month" value="{{month}}" end="{{state.today}}" bindchange="chooseMonth" disabled="{{busy || inlineConfirmation || loading || switching}}">
            <view class="picker picker-control">{{monthDisplay || month}}</view>
          </picker>
        </view>
      </view>
      <view wx:if="{{!directReturnedEdit && (displayStatus || dueDisplay)}}" class="report-status row">
        <text wx:if="{{displayStatus}}" class="badge {{displayStatusTone}}">{{displayStatus}}</text>
        <text wx:if="{{linkedVersion && linkedVersion.id!==latestSubmittedVersion.id}}" class="muted">历史月报</text>
        <text wx:if="{{dueDisplay}}" class="muted">截止 {{dueDisplay}}</text>
      </view>
      <view wx:if="{{!returnedReason && currentApprovedVersion && latestSubmittedVersion && currentApprovedVersion.id!==latestSubmittedVersion.id}}" class="hint">原已审核月报仍然有效。</view>
      <view wx:if="{{!outletId && !error}}" class="hint">选择要填报的网点后继续。</view>
      <view wx:if="{{linkedVersion.revoked}}" class="hint">该版本已撤销，不再作为当前有效月报。</view>
      <view wx:if="{{linkedVersion.review && !returnedReason}}" class="notice">{{linkedVersion.review}}</view>
      <view wx:if="{{linkedVersion.summaryOnly}}" class="hint">该历史版本仅提供摘要，可查看提交与审核记录。</view>
      <view wx:if="{{editNotice && !(directReturnedEdit && editNotice==='当前月份可以填写经营数据。')}}" class="notice report-edit-notice">{{editNotice}}</view>
      <view wx:if="{{recoveryAvailable}}" class="notice top-gap">
        <view>此网点、此月份有未保存的填写内容。</view>
        <view class="actions">
          <button class="outline" bindtap="discardRecovery">放弃未保存内容</button>
          <button class="primary" bindtap="restoreRecovery">恢复填写</button>
        </view>
      </view>
      <button wx:if="{{currentAction}}" class="primary top-gap" bindtap="continueReport" disabled="{{busy || loading || switching}}">{{currentAction}}</button>
      <button wx:elif="{{canEdit && !formExpanded && !recoveryAvailable}}" class="primary top-gap" bindtap="showReportFields" disabled="{{busy || loading || switching}}">{{returnedReason ? '修改并重新提交' : (hasDraft ? '继续填写' : '填写月报')}}</button>
      <button wx:elif="{{canCorrect && !correctionExpanded}}" class="primary top-gap" bindtap="showCorrection" disabled="{{busy || loading || switching}}">申请更正</button>
      <button wx:if="{{outletId && !canEdit && !formExpanded && !versionUnavailable && !linkedVersion.summaryOnly && (linkedVersion || latestSubmittedVersion || currentApprovedVersion || hasDraft)}}" class="link" bindtap="showReportFields">查看月报数据</button>
      <button wx:if="{{versions.length && !historyExpanded && !directReturnedEdit}}" class="link" bindtap="showVersions" disabled="{{busy || loading || switching}}">查看版本记录</button>
      <button wx:if="{{!directReturnedEdit && !linkedVersion && !versionUnavailable && (outlets.length > 1 || pagers.outlets.hasMore || outletSearch)}}" class="link" bindtap="toggleOutletSearch">{{searchExpanded ? '收起网点搜索' : '搜索其他网点'}}</button>
      <view wx:if="{{!directReturnedEdit && !linkedVersion && !versionUnavailable && pagers.outlets.hasMore}}" class="pagination">
        <button class="outline small" data-collection="outlets" bindtap="more" loading="{{pagers.outlets.loading}}" disabled="{{busy || loading || switching || pagers.outlets.loading}}">加载更多网点</button>
      </view>
    </view>

    <view wx:if="{{formExpanded && outletId && !versionUnavailable && !linkedVersion.summaryOnly}}">
      <view class="card" id="report-edit">
        <view wx:if="{{!directReturnedEdit}}" class="report-form-context">
          <view class="report-identity">
            <text class="card-title report-outlet-name">{{outletNames[outletIndex + 1]}}</text>
            <text class="muted">{{monthDisplay || month}} · 经营月报</text>
          </view>
        </view>
        <view wx:if="{{canEdit && returnedReason && !directReturnedEdit}}" class="report-return report-return-inline">
          <view class="report-return-title">
            <t-icon t-class="report-return-icon" name="error-circle-filled" size="32rpx" aria-hidden="true"/>
            <text>月报已退回，请修改后重新提交</text>
          </view>
          <view class="report-return-reason"><text class="report-return-reason-label">退回原因：</text>{{returnedReason}}</view>
          <view wx:if="{{currentApprovedVersion}}" class="report-return-note">原已审核月报仍然有效。</view>
        </view>
        <view class="report-fields-heading">
          <view class="report-section-title">{{canEdit ? '月报填报' : '月报数据'}}</view>
          <button wx:if="{{directReturnedEdit}}" class="link report-hint-toggle" bindtap="toggleFieldHints" aria-expanded="{{fieldHintsExpanded}}">{{fieldHintsExpanded ? '收起口径' : '填写口径'}}</button>
        </view>
        <view class="report-field" id="report-field-revenue">
          <number-field field="revenue" data-field="revenue" label="营业收入（元）" keyboard="digit"
            format-amount="{{true}}"
            required="{{canSubmit && editableFields.revenue}}"
            value="{{form.revenue}}" error="{{fieldErrors.revenue}}" hint="{{!directReturnedEdit || fieldHintsExpanded ? '请按集团财务确认口径填写。' : ''}}"
            placeholder="填入金额" disabled="{{!editableFields.revenue || busy || inlineConfirmation || loading || switching}}"
            focus="{{focusField==='revenue'}}" confirm-type="{{nextNumericField.revenue ? 'next' : 'done'}}"
            bind:fieldinput="input" bind:fieldblur="blurField" bind:fieldconfirm="confirmField" bind:fieldkeyboard="keyboardHeightChanged"/>
        </view>
        <view class="report-field" id="report-field-orders">
          <number-field field="orders" data-field="orders" label="有效完成订单（单）" keyboard="number"
            required="{{canSubmit && editableFields.orders}}"
            value="{{form.orders}}" error="{{fieldErrors.orders}}" hint="{{!directReturnedEdit || fieldHintsExpanded ? '按该经营月份实际完成的有效订单统计。' : ''}}"
            placeholder="填入订单数" disabled="{{!editableFields.orders || busy || inlineConfirmation || loading || switching}}"
            focus="{{focusField==='orders'}}" confirm-type="{{nextNumericField.orders ? 'next' : 'done'}}"
            bind:fieldinput="input" bind:fieldblur="blurField" bind:fieldconfirm="confirmField" bind:fieldkeyboard="keyboardHeightChanged"/>
        </view>
        <view class="report-field" id="report-field-traffic">
          <number-field field="traffic" data-field="traffic" label="到店客流（人次）" keyboard="number"
            required="{{canSubmit && editableFields.traffic}}"
            value="{{form.traffic}}" error="{{fieldErrors.traffic}}" hint="{{!directReturnedEdit || fieldHintsExpanded ? '按实际到店人次统计。' : ''}}"
            placeholder="填入到店人次" disabled="{{!editableFields.traffic || busy || inlineConfirmation || loading || switching}}"
            focus="{{focusField==='traffic'}}" confirm-type="{{nextNumericField.traffic ? 'next' : 'done'}}"
            bind:fieldinput="input" bind:fieldblur="blurField" bind:fieldconfirm="confirmField" bind:fieldkeyboard="keyboardHeightChanged"/>
        </view>
        <view class="report-field" id="report-field-enroll">
          <number-field wx:if="{{applicable}}" field="enroll" data-field="enroll" label="实际招生人数（人）" keyboard="number"
            required="{{canSubmit && editableFields.enroll}}"
            value="{{form.enroll}}" error="{{fieldErrors.enroll}}" hint="{{!directReturnedEdit || fieldHintsExpanded ? '按该经营月份实际入学或正式入读人数统计。' : ''}}"
            placeholder="填入招生人数" disabled="{{!editableFields.enroll || busy || inlineConfirmation || loading || switching}}"
            focus="{{focusField==='enroll'}}"
            bind:fieldinput="input" bind:fieldblur="blurField" bind:fieldconfirm="confirmField" bind:fieldkeyboard="keyboardHeightChanged"/>
          <block wx:else>
            <view class="report-field-label">实际招生人数（人）</view>
            <view wx:if="{{enrollmentStatus === 'pending'}}" class="notice">
              招生业务适用情况待总部确认。<text wx:if="{{canEdit}}">可先保存草稿。</text>
            </view>
            <view wx:else class="picker">本网点当前不开展招生业务。</view>
            <view wx:if="{{fieldErrors.enroll}}" class="field-error">{{fieldErrors.enroll}}</view>
          </block>
        </view>
        <button wx:if="{{canEdit && !noteExpanded}}" class="link" bindtap="toggleNote" disabled="{{busy || loading || switching}}">{{form.note ? '展开经营说明' : '添加经营说明'}}</button>
        <view wx:if="{{noteExpanded && (canEdit || form.note)}}" class="field">
          <label>经营说明（选填）</label>
          <textarea disabled="{{!editableFields.note || busy || inlineConfirmation || loading || switching}}" name="note" data-field="note" value="{{form.note}}" bindinput="input"
            cursor-spacing="24" bindkeyboardheightchange="keyboardHeightChanged" maxlength="600" placeholder="可填写本月经营情况、特殊事项或需要总部了解的情况。"/>
          <button wx:if="{{canEdit}}" class="link" bindtap="toggleNote" disabled="{{busy || loading || switching}}">收起经营说明</button>
        </view>
        <view id="report-actions" class="report-actions {{directReturnedEdit ? 'action-dock' : ''}} {{keyboardOpen ? 'report-actions-typing' : ''}}">
          <block wx:if="{{canEdit || submitting}}">
            <view wx:if="{{canSubmit && missingFields.length}}" class="hint">还需填写 {{missingFieldsText}}</view>
            <view class="actions report-action-buttons">
              <button class="outline" bindtap="draft" disabled="{{busy || inlineConfirmation || loading || switching}}">保存草稿</button>
              <button class="primary" bindtap="submit" loading="{{submitting}}" disabled="{{!canSubmit || busy || inlineConfirmation || loading || switching}}"
                aria-label="{{submitting ? '提交中…' : (returnedReason ? '重新提交月报' : '提交月报')}}">{{submitting ? '提交中…' : (directReturnedEdit ? '重新提交' : (returnedReason ? '重新提交月报' : '提交月报'))}}</button>
            </view>
          </block>
          <view wx:if="{{showActionError && error}}" class="error">{{error}}</view>
          <view wx:if="{{actionNotice}}" class="notice">{{actionNotice}}</view>
        </view>
      </view>
    </view>

    <button wx:if="{{directReturnedEdit && versions.length && !historyExpanded}}" class="link" bindtap="showVersions"
      disabled="{{busy || loading || switching}}">查看版本记录</button>
    <view wx:if="{{canCorrect && correctionExpanded}}" class="card" id="report-correct">
      <view class="card-title">选择更正方式</view>
      <view class="filter">
        <button class="pill {{correctionType === 'field' ? 'active' : ''}}" data-type="field" bindtap="correctionType" disabled="{{busy || loading || switching}}">修改单项数据</button>
        <button class="pill {{correctionType === 'full' ? 'active' : ''}}" data-type="full" bindtap="correctionType" disabled="{{busy || loading || switching}}">更正整份月报</button>
      </view>
      <view class="hint">{{correctionType === 'field' ? '请选择需要修改的指标，其他已审核数据将保持不变。' : '重新确认本月全部经营数据。'}}</view>
      <picker wx:if="{{correctionType === 'field'}}" range="{{correctionOptions}}" range-key="label" value="{{correctionFieldIndex}}" bindchange="correctionField" disabled="{{busy || loading || switching}}">
        <view class="picker picker-control">{{correctionOptions[correctionFieldIndex].label}}</view>
      </picker>
      <view class="field">
        <label>更正原因</label>
        <textarea value="{{reason}}" bindinput="reason" disabled="{{busy || loading || switching}}" placeholder="请说明本次更正的原因"/>
      </view>
      <view wx:if="{{correctionType==='full' || correctionOptions[correctionFieldIndex].field==='revenue'}}" class="hint">如更正涉及营业收入，提交后还需完成财务复核。</view>
      <view wx:if="{{correctionError || (showActionError && error)}}" class="error">{{correctionError || error}}</view>
      <button class="outline" bindtap="correct" disabled="{{busy || loading || switching}}">提交更正申请</button>
    </view>

    <block wx:if="{{historyExpanded && versions.length}}">
      <view class="section-head" id="report-history">
        <view class="section-title">历史版本</view>
        <button class="link" bindtap="showVersions">收起版本</button>
      </view>
      <view wx:if="{{linkedVersion}}" class="version-card linked-version">
        <view class="muted">所选版本</view>
        <view class="card-title">V{{linkedVersion.version}} · {{linkedVersion.statusText}}</view>
      </view>
      <view wx:if="{{outletId}}" class="version-grid">
          <view class="version-card">
            <view class="muted">当前有效月报</view>
            <view wx:if="{{currentApprovedVersion}}" class="card-title">V{{currentApprovedVersion.version}} · 已审核通过</view>
            <view wx:else class="hint">当前月份暂无已审核通过的月报。</view>
          </view>
          <view class="version-card">
            <view class="muted">最近一次提交</view>
            <view wx:if="{{latestSubmittedVersion}}" class="card-title">V{{latestSubmittedVersion.version}} · {{latestSubmittedVersion.statusText}}</view>
            <view wx:else class="hint">尚未提交月报。</view>
          </view>
        </view>
      <view wx:for="{{versions}}" wx:key="id" class="card {{item.id === linkedVersion.id ? 'linked-version' : ''}}">
        <view class="row between">
          <text>V{{item.version}} · {{item.month}}</text>
          <text class="badge {{item.statusTone}}">{{item.statusText}}</text>
        </view>
        <button wx:if="{{item.id!==linkedVersion.id}}" class="link" data-id="{{item.id}}" bindtap="selectVersion" disabled="{{busy || loading || switching}}">查看该版本</button>
        <view wx:if="{{item.revoked}}" class="muted top-gap">该版本已撤销，不再作为当前有效月报。</view>
        <view wx:elif="{{item.status==='returned' && item.id===latestSubmittedVersion.id}}" class="muted top-gap">月报需要修改，请查看总部处理意见。</view>
        <view wx:if="{{item.review}}" class="muted top-gap">{{item.review}}</view>
        <view wx:for="{{item.differences}}" wx:for-item="difference" wx:key="field" class="detail-row">
          <text>{{difference.label}}</text>
          <text>{{difference.before}} → {{difference.after}}</text>
        </view>
      </view>
    </block>
  </block>
  <view wx:if="{{showActionError && error && !outletId}}" class="error">{{error}}</view>
  <view wx:if="{{inlineConfirmation}}" class="report-confirmation">
    <view class="report-confirmation-mask" catchtap="cancelSubmit"></view>
    <view class="report-confirmation-panel" aria-role="dialog" aria-label="确认提交月报">
      <view class="report-confirmation-header">
        <view class="card-title">确认提交月报</view>
        <view class="report-confirmation-scope muted"><text>{{outletNames[outletIndex + 1]}}</text><text class="report-confirmation-period">{{monthDisplay || month}}</text></view>
      </view>
      <view class="report-confirmation-body">
        <view wx:for="{{confirmationRows}}" wx:key="field" class="detail-row {{item.field==='note' ? 'report-confirmation-note' : ''}}">
          <text>{{item.label}}</text><text>{{item.value}}</text>
        </view>
        <view class="hint">{{submitConfirmationContent}}</view>
      </view>
      <view class="actions report-confirmation-actions">
        <button class="outline" bindtap="cancelSubmit">取消</button>
        <button class="primary" bindtap="confirmSubmit">确认提交</button>
      </view>
    </view>
  </view>
</view>
