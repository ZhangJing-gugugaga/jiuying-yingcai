/* Shared visual system is defined in app.wxss. */

.version-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.version-card{padding:20rpx;border-radius:16rpx;background:#f0f5fb;background:var(--surface-muted)}.version-card .card-title{font-size:25rpx;margin-top:10rpx}

.linked-version{border:2rpx solid #0e65b7;border-color:var(--brand);background:#eaf4ff;background:var(--brand-soft)}.version-card.linked-version{margin-top:16rpx}

.report-section-title {
  border-left: 6rpx solid var(--brand);
  padding-left: var(--space-sm);
  font-size: var(--font-section);
  font-weight: 700;
  line-height: 1.2;
}
.report-scope .field {
  display: grid;
  grid-template-columns: minmax(5em, 1fr) minmax(0, 3fr);
  align-items: baseline;
  gap: var(--space-sm);
  min-width: 0;
  margin: var(--space-md) 0;
}
.report-scope label { color: var(--muted); margin: 0; }
.report-scope .picker { white-space: normal; overflow-wrap: anywhere; }
.report-identity { display: grid; gap: var(--space-xs); margin: var(--space-md) 0; }
.report-fact { display: grid; grid-template-columns: minmax(6em, auto) minmax(0, 1fr); justify-items: start;
  align-items: start; gap: var(--space-sm); padding: var(--space-xs) 0; }
.report-fact + .report-fact { border-top: 1rpx solid var(--border); }
.report-fact-label { display: flex; align-items: center; gap: var(--space-xs); color: var(--muted); }
.report-fact-icon { color: var(--brand); }
.report-outlet-name{min-width:0;overflow-wrap:anywhere}
.report-status{flex-wrap:wrap}
.report-form-context { margin-bottom: var(--space-md); }
.report-return {
  margin-bottom: var(--space-md);
  padding: var(--space-md) var(--space-lg);
  border-left: 6rpx solid var(--error-text);
  border-radius: var(--radius-control);
  background: var(--error-bg);
  color: var(--error-text);
  overflow-wrap: anywhere;
}
.report-return-title { display: flex; align-items: flex-start; gap: var(--space-xs); font-weight: 700; }
.report-return-icon { flex: none; margin-top: 3rpx; }
.report-return-reason, .report-return-note { margin-top: var(--space-xs); white-space: pre-wrap; }
.report-return-note { font-size: var(--font-caption); }
.report-return-inline { margin-bottom: var(--space-lg); }
.report-fields-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 var(--space-sm); }
.report-field { margin-top: var(--space-lg); scroll-margin-top: var(--space-lg); }
.report-returned-editor .report-context, .report-returned-editor #report-edit {
  margin: var(--space-md) 0;
  padding: var(--space-md) var(--space-lg);
}
.report-returned-editor .report-return { padding: var(--space-sm) var(--space-md); }
.report-returned-editor .report-return-reason { font-size: var(--font-caption); }
.report-returned-editor .report-edit-notice { margin: var(--space-xs) 0 0; padding: var(--space-xs) var(--space-sm); }
.report-returned-editor .report-field { margin-top: var(--space-md); }
.report-returned-editor .report-fields-heading + .report-field { margin-top: var(--space-xs); }
.report-page button.report-hint-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-height: 44px;
  margin: 0;
  padding: 0 var(--space-xs);
  font-size: var(--font-caption);
}
.report-field-label { margin-bottom: var(--space-sm); font-weight: 600; }
.report-actions { padding-top: var(--space-md); }
.report-action-buttons { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--space-sm); }
.report-actions.action-dock { padding-top: var(--space-xs); padding-bottom: calc(var(--space-xs) + env(safe-area-inset-bottom, 0px)); }
.report-actions.action-dock.report-actions-typing { position: static; }
.report-actions.action-dock .report-action-buttons { grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; }
.report-page .report-action-buttons button { width: 100%; margin: 0; }
.report-page .report-actions.action-dock .report-action-buttons button { padding: var(--space-md) var(--space-xs); line-height: 1.25; }
.version-card.linked-version + .version-grid{margin-top:16rpx}
#report-history + .version-grid{margin:0 0 20rpx}

.field-error{margin-top:8rpx;color:#a62532;color:var(--error-text);font-size:24rpx}
.report-confirmation{position:fixed;inset:0;z-index:10;display:flex;align-items:flex-end}
.report-confirmation-mask{position:absolute;inset:0;background:rgba(10,22,42,.48)}
.report-confirmation-panel{
  position:relative;
  width:100%;
  max-height:100%;
  box-sizing:border-box;
  display:flex;
  flex-direction:column;
  padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom, 0px));
  border-radius:28rpx 28rpx 0 0;
  background:#fff;
  background:var(--surface);
}
.report-confirmation-header { flex: none; padding-bottom: var(--space-sm); overflow-wrap: anywhere; }
.report-confirmation-scope { display: flex; flex-wrap: wrap; gap: 0 var(--space-sm); margin-top: var(--space-xs); }
.report-confirmation-period { white-space: nowrap; }
.report-confirmation-body { min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding-right: var(--space-xs); }
.report-confirmation-body .hint { margin: var(--space-sm) 0; }
.report-confirmation-note { flex-direction: column; align-items: stretch; gap: var(--space-xs); }
.report-confirmation-note text { white-space: pre-wrap; overflow-wrap: anywhere; }
.report-confirmation-note text:last-child { text-align: left; }
.report-confirmation-panel .report-confirmation-actions {
  flex: none;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-sm);
  margin: 0;
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--border);
}
.report-confirmation-panel .report-confirmation-actions button { width: 100%; margin: 0; min-height: 44px; }

@media (max-width: 374px) {
  .report-scope .field,.version-grid{grid-template-columns:minmax(0,1fr)}
}
