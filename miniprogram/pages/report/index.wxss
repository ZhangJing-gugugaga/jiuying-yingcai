/* Shared visual system is defined in app.wxss. */

.version-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.version-card{padding:20rpx;border-radius:16rpx;background:#f0f5fb;background:var(--surface-muted)}.version-card .card-title{font-size:25rpx;margin-top:10rpx}

.linked-version{border:2rpx solid #0e65b7;border-color:var(--brand);background:#eaf4ff;background:var(--brand-soft)}.version-card.linked-version{margin-top:16rpx}

.report-section-title {
  border-left: 6rpx solid var(--brand);
  padding-left: var(--space-sm);
  font-size: var(--font-section);
  font-weight: 700;
  line-height: 1.2;
}
.report-scope .field {
  display: grid;
  grid-template-columns: minmax(5em, 1fr) minmax(0, 3fr);
  align-items: baseline;
  gap: var(--space-sm);
  min-width: 0;
  margin: var(--space-md) 0;
}
.report-scope label { color: var(--muted); margin: 0; }
.report-scope .picker { white-space: normal; overflow-wrap: anywhere; }
.report-identity { display: grid; gap: var(--space-xs); margin: var(--space-md) 0; }
.report-fact { display: grid; grid-template-columns: minmax(4.8em, auto) minmax(0, 1fr); justify-items: start;
  align-items: start; gap: var(--space-sm); padding: var(--space-xs) 0; }
.report-fact + .report-fact { border-top: 1rpx solid var(--border); }
.report-fact > text:first-child { color: var(--muted); }
.report-outlet-name{min-width:0;overflow-wrap:anywhere}
.report-status{flex-wrap:wrap}
.report-form-context { margin-bottom: var(--space-md); }
.report-return {
  margin-bottom: var(--space-md);
  padding: var(--space-md) var(--space-lg);
  border-left: 6rpx solid var(--error-text);
  border-radius: var(--radius-control);
  background: var(--error-bg);
  color: var(--error-text);
  overflow-wrap: anywhere;
}
.report-return-title { font-weight: 700; }
.report-return-reason, .report-return-note { margin-top: var(--space-xs); white-space: pre-wrap; }
.report-return-note { font-size: var(--font-caption); }
.report-return-inline { margin-bottom: var(--space-lg); }
.report-field { margin-top: var(--space-lg); scroll-margin-top: var(--space-lg); }
.report-field-label { margin-bottom: var(--space-sm); font-weight: 600; }
.report-actions { padding-top: var(--space-md); }
.report-action-buttons { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--space-sm); }
.report-actions.action-dock { padding-top: var(--space-xs); padding-bottom: calc(var(--space-xs) + env(safe-area-inset-bottom, 0px)); }
.report-actions.action-dock .report-action-buttons { margin: 0; }
.report-page .report-action-buttons button { width: 100%; margin: 0; }
.version-card.linked-version + .version-grid{margin-top:16rpx}
#report-history + .version-grid{margin:0 0 20rpx}

.field-error{margin-top:8rpx;color:#a62532;color:var(--error-text);font-size:24rpx}
.report-confirmation{position:fixed;inset:0;z-index:10;display:flex;align-items:flex-end}
.report-confirmation-mask{position:absolute;inset:0;background:rgba(10,22,42,.48)}
.report-confirmation-panel{
  position:relative;
  width:100%;
  max-height:100%;
  overflow-y:auto;
  padding:32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius:28rpx 28rpx 0 0;
  background:#fff;
  background:var(--surface);
}
.report-confirmation-panel .actions{margin:20rpx 0 0}

@media (max-width: 374px) {
  .report-scope .field,.version-grid{grid-template-columns:minmax(0,1fr)}
}
