<view class="page tab-page">
  <view class="row between report-heading">
    <view class="title grow">经营月报</view>
    <picker wx:if="{{hasLoaded && !isPublic && month}}" mode="date" fields="month" value="{{month}}" end="{{state.today}}" bindchange="changeMonth" disabled="{{loading}}">
      <view class="picker picker-control">{{monthDisplay}}</view>
    </picker>
  </view>
  <view wx:if="{{loading && !hasLoaded}}" class="card content-skeleton">
    <text>正在加载经营月报…</text>
    <view class="content-skeleton-body" aria-hidden="true"/>
  </view>
  <view wx:elif="{{loading}}" class="loading">正在更新经营月报…</view>
  <view wx:if="{{error}}" class="error">
    {{error}}
    <button class="link top-gap" bindtap="refresh">重试</button>
    <button wx:if="{{outlet!=='all'}}" class="link" bindtap="clearOutlet">清除当前网点筛选</button>
  </view>
  <block wx:if="{{hasLoaded && !isPublic && month}}">
    <view class="card report-list-scope">
      <view class="filter">
        <button class="pill {{month===previousMonth?'active':''}}" data-value="previous" bindtap="pickMonthShortcut" disabled="{{loading}}">上月 {{previousMonth}}</button>
        <button class="pill {{month===currentMonth?'active':''}}" data-value="current" bindtap="pickMonthShortcut" disabled="{{loading}}">本月 {{currentMonth}}</button>
      </view>
      <view wx:if="{{periodHint}}" class="hint">{{periodHint}}</view>
      <button wx:if="{{session.role==='partner' && canOpenEditor}}" class="primary report-new" bindtap="newReport" disabled="{{loading || error || worklistError}}">填报经营月报</button>
      <view class="field">
        <label>网点</label>
        <picker range="{{options}}" range-key="label" value="{{outletIndex<0 ? 0 : outletIndex}}" bindchange="pickOutlet" disabled="{{loading || pagers.outlets.loading || !options.length}}">
          <view class="picker picker-control" hover-class="tap-feedback">{{!options.length ? '网点选项暂不可用' : outletIndex<0 ? '请重新选择网点' : options[outletIndex].label}}</view>
        </picker>
        <view wx:if="{{outletChoiceError}}" class="error" aria-role="alert">
          {{outletChoiceError}}
          <button class="link" bindtap="retryOutletChoices" disabled="{{pagers.outlets.loading}}">重试加载网点</button>
        </view>
      </view>
      <view wx:if="{{pagers.outlets.hasMore}}" class="pagination">
        <button class="outline small" bindtap="moreOutlets" disabled="{{loading || pagers.outlets.loading}}">加载更多网点</button>
      </view>
    </view>
    <view wx:if="{{coverage && !loading}}" class="coverage">
      <view class="row between">
        <text>应报 {{coverage.expected}} 家 · 已提交 {{coverage.submitted}} 家</text>
        <text wx:if="{{coverage.exempt}}" class="muted">免报 {{coverage.exempt}} 家</text>
      </view>
      <view wx:if="{{coverage.expected}}" class="report-progress"><view class="report-progress-fill" style="width:{{coverage.percent}}%"></view></view>
      <view wx:if="{{coverage.actionable || coverage.inReview || coverage.awaitingExemption}}" class="report-coverage-detail muted">
        <text wx:if="{{coverage.actionable}}">待填写或修改 {{coverage.actionable}} 家</text>
        <text wx:if="{{coverage.inReview}}">月报审核中 {{coverage.inReview}} 家</text>
        <text wx:if="{{coverage.awaitingExemption}}">免报待核实 {{coverage.awaitingExemption}} 家</text>
      </view>
    </view>
    <view class="filter report-filter">
      <button class="pill {{filter==='action'?'active':''}}" data-value="action" bindtap="filter" disabled="{{loading}}">待我填</button>
      <button class="pill {{filter==='reviewing'?'active':''}}" data-value="reviewing" bindtap="filter" disabled="{{loading}}">审核中</button>
      <button class="pill {{filter==='approved'?'active':''}}" data-value="approved" bindtap="filter" disabled="{{loading}}">已通过</button>
      <button class="pill {{filter==='all'?'active':''}}" data-value="all" bindtap="clearFilter" disabled="{{loading}}">全部</button>
    </view>
    <view wx:if="{{worklistError && !loading}}" class="error">
      {{worklistError}}
      <button class="link top-gap" bindtap="retryReports">重试</button>
      <button wx:if="{{outlet!=='all'}}" class="link" bindtap="clearOutlet">清除当前网点筛选</button>
    </view>
    <view wx:if="{{loadingReports && !reportRows.length && !loading}}" class="loading">正在加载经营月报…</view>
    <block wx:if="{{!loading && !error}}">
      <view wx:for="{{reportRows}}" wx:key="outletId" class="card">
        <view class="row between">
          <text class="card-title grow">{{item.outletName}}</text>
          <text class="badge {{item.statusTone}}">{{item.statusText}}</text>
        </view>
        <view class="muted top-gap">{{monthDisplay}}经营月报<text wx:if="{{item.displayVersion}}"> · V{{item.displayVersion}}</text></view>
        <view wx:if="{{item.returnNote || item.status==='returned'}}" class="hint report-return-note">总部退回意见：{{item.returnNote || '可联系总部了解详情。'}}</view>
        <view wx:if="{{item.reasonText}}" class="hint">{{item.reasonText}}</view>
        <view wx:if="{{item.effectiveVersion && item.effectiveVersion!==item.displayVersion}}" class="hint">V{{item.effectiveVersion}} 仍为当前有效月报。</view>
        <view class="row between top-gap">
          <view class="grow">
            <text wx:if="{{item.dueText}}" class="muted">{{item.dueText}}截止</text>
            <text wx:if="{{item.late}}" class="badge wait">逾期</text>
          </view>
          <button class="outline small" data-outlet="{{item.outletId}}" data-month="{{item.month}}" data-report-id="{{item.reportId || ''}}" bindtap="open">{{item.actionText}}</button>
        </view>
      </view>
      <view wx:if="{{worklist && !reportRows.length && !loadingReports && !worklistError}}">
        <t-empty class="native-empty" icon="file" description="{{filter==='all' ? '所选范围没有经营月报。' : '所选范围没有该类月报。'}}"/>
        <button wx:if="{{filter!=='all'}}" class="link top-gap" bindtap="clearFilter">查看全部</button>
      </view>
      <view wx:if="{{worklist.hasMore && !worklistError}}" class="pagination">
        <button class="outline small" bindtap="moreReports" disabled="{{loadingReports}}" loading="{{loadingReports}}">加载更多月报</button>
      </view>
    </block>
    <button class="link top-gap" data-page="dashboard" bindtap="nav">查看经营看板</button>
  </block>
</view>
