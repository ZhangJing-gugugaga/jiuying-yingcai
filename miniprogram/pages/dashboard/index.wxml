<view class="page">
  <view class="section-head">
    <view class="title">经营看板</view>
    <button wx:if="{{state.capabilities.export}}" class="link" bindtap="toggleExports" disabled="{{busy || loading || dashboardLoading || !ready}}" aria-label="导出选项">{{exportMenu ? '收起导出' : '导出选项'}}</button>
  </view>
  <view wx:if="{{exportMenu && state.capabilities.export}}" class="dashboard-exports">
    <button class="link" data-format="xlsx" bindtap="export" disabled="{{busy || loading || dashboardLoading || !ready}}">导出 Excel</button>
    <button class="link" data-format="pdf" bindtap="export" disabled="{{busy || loading || dashboardLoading || !ready}}">导出 PDF</button>
  </view>
  <view wx:if="{{!ready && (loading || dashboardLoading)}}" class="loading">正在更新所选范围…</view>
  <view wx:if="{{error}}" class="error">
    {{error}}
    <button class="link" bindtap="refresh">重试</button>
  </view>
  <view class="card dashboard-filters">
    <view class="two-col">
      <view class="field">
        <label>统计月份</label>
        <picker mode="date" fields="month" value="{{period}}" bindchange="period" disabled="{{loading}}">
          <view class="picker picker-control" hover-class="tap-feedback">{{filterPeriodDisplay || period}}</view>
        </picker>
      </view>
      <view class="field">
        <label>统计周期</label>
        <picker range="{{kinds}}" value="{{kindIndex}}" bindchange="kind" disabled="{{loading}}">
          <view class="picker picker-control" hover-class="tap-feedback">{{kinds[kindIndex]}}</view>
        </picker>
      </view>
    </view>
    <view class="field">
      <label>网点</label>
      <picker range="{{outlets}}" range-key="name" value="{{outletIndex}}" bindchange="outlet" disabled="{{loading}}">
        <view class="picker picker-control" hover-class="tap-feedback">{{outlets[outletIndex].name}}</view>
      </picker>
      <input class="top-gap" placeholder="搜索网点名称或地区" value="{{outletSearch}}" bindconfirm="outletSearch"/>
      <view wx:if="{{pagers.outlets.hasMore}}" class="pagination">
        <text class="muted">已显示 {{pagers.outlets.loaded}} / {{pagers.outlets.total}} 个网点</text>
        <button class="outline small" data-collection="outlets" bindtap="more" loading="{{pagers.outlets.loading}}" disabled="{{loading || pagers.outlets.loading}}">加载更多</button>
      </view>
    </view>
  </view>
  <view wx:if="{{exportError}}" class="error">{{exportError}}</view>
  <view wx:if="{{state.agency && state.agency.isPrimary}}" class="card agency-entry">
    <view class="row between">
      <view class="grow">
        <view class="card-title">下级报送</view>
        <view class="hint">查看直属二级代理本账期的网点报送进度，并发送站内催报。</view>
      </view>
      <button class="outline small" data-page="agency-progress" bindtap="nav">打开</button>
    </view>
  </view>

  <block wx:if="{{ready && !dashboardLoading && !error}}">
    <view class="row between">
      <view class="hint">{{periodDisplay}} · {{mode==='settled' ? '已结算数据' : '审核通过的数据'}}</view>
      <button class="link" data-mode="{{mode==='settled' ? 'process' : 'settled'}}" bindtap="mode" disabled="{{loading}}">{{mode==='settled' ? '查看审核数据' : '查看已结算数据'}}</button>
    </view>
    <view wx:if="{{dataStatus}}" class="{{settlementPending ? 'notice' : 'hint'}}">{{dataStatus}}</view>
    <view wx:if="{{hasData}}" class="metrics">
      <view wx:for="{{metrics}}" wx:key="label" class="metric">
        <view class="metric-label">{{item.label}}</view>
        <view class="metric-value">{{item.value}}</view>
      </view>
    </view>
    <view class="section-title">近 6 个月营业收入</view>
    <view wx:if="{{trendLoading}}" class="hint">正在加载历史数据…</view>
    <view wx:if="{{trendError}}" class="error">{{trendError}}<button class="link" bindtap="loadTrend">重试</button></view>
    <view wx:if="{{trend.length}}" class="card">
      <view wx:for="{{trend}}" wx:key="month" class="bar-row">
        <view class="row between"><text class="grow">{{item.monthDisplay}} {{item.partial ? '· 数据不全' : ''}}</text><text class="amount-number">{{item.hasValue ? '¥ ' + item.value : '—'}}</text></view>
        <view wx:if="{{item.hasValue}}" class="bar-track"><view class="bar-fill" style="width:{{item.width}}%"/></view>
      </view>
      <view class="row between muted chart-axis"><text>0 元</text><text>{{trendMax}} 元</text></view>
    </view>
    <view wx:if="{{rows.length && selectedOutlet==='all'}}" class="section-title">网点经营对比</view>
    <view wx:if="{{rows.length && selectedOutlet==='all'}}" class="card">
      <view wx:for="{{rows}}" wx:key="outlet" class="bar-row">
        <view class="row between"><text class="grow">{{item.name}}</text><text class="amount-number">¥ {{item.revenueText}}</text></view>
        <view class="bar-track"><view class="bar-fill" style="width:{{item.width}}%"/></view>
      </view>
    </view>
    <block wx:if="{{kind==='month'}}">
      <view class="section-head">
        <view class="section-title">同比与环比</view>
        <button class="link" bindtap="toggleComparisons">{{showComparisons ? '收起' : '展开'}}</button>
      </view>
      <block wx:if="{{showComparisons}}">
        <view wx:if="{{comparisonLoading}}" class="hint">正在加载对比数据…</view>
        <view wx:if="{{comparisonError}}" class="error">{{comparisonError}}<button class="link" bindtap="loadComparisons">重试</button></view>
        <view wx:if="{{comparisons.length}}" class="card">
          <view class="hint">环比基期 {{momDisplay}} · 同比基期 {{yoyDisplay}}</view>
          <view class="detail-row"><text>指标</text><text>环比 / 同比</text></view>
          <view wx:for="{{comparisons}}" wx:key="key" class="detail-row">
            <text>{{item.label}}</text>
            <text class="amount-number">{{item.mom==='不可比' ? '—' : item.mom}} / {{item.yoy==='不可比' ? '—' : item.yoy}}</text>
          </view>
          <view wx:if="{{incomparable}}" class="hint">当前期间缺少可比较数据。</view>
        </view>
      </block>
    </block>
  </block>
</view>
