<view class="page tab-page outlets-page" aria-busy="{{loading}}">
  <view wx:if="{{error}}" class="error">暂时无法获取网点信息，请重试。<button class="link top-gap" bindtap="refresh">重试</button></view>
  <view class="outlet-search-bar">
    <view class="outlet-search">
      <t-icon name="search" size="35rpx" aria-hidden="true"/>
      <input aria-label="搜索网点" placeholder="网点名称、城市或编号" value="{{searchDraft}}" bindinput="searchInput" bindconfirm="search" bindfocus="searchFocus" maxlength="100" confirm-type="search" cursor-spacing="24"/>
      <button wx:if="{{searchDraft || search}}" class="outlet-search-clear" bindtap="clearSearch" disabled="{{loading}}" aria-label="清除搜索">
        <t-icon name="close" size="31rpx" aria-hidden="true"/>
      </button>
      <button wx:if="{{searchDraft && searchDraft!==search}}" class="outlet-search-submit" bindtap="search" disabled="{{loading}}">搜索</button>
    </view>
    <button class="outlet-filter-toggle" bindtap="toggleRegionFilters" aria-expanded="{{showRegionFilters}}">
      <t-icon name="filter" size="36rpx" aria-hidden="true"/><text>{{showRegionFilters ? '收起' : '筛选'}}</text>
    </button>
  </view>
  <view wx:if="{{directory || isPublic}}" class="outlet-directory-controls">
    <view class="outlet-quick-filters" aria-label="服务网点地域">
      <button wx:for="{{geography}}" wx:key="value" class="outlet-quick-filter {{geo===item.value ? 'active' : ''}}" data-geo="{{item.value}}" bindtap="filterGeography"
        aria-label="{{item.label + (geo===item.value ? '，已选择' : '')}}">{{item.label}}</button>
    </view>
    <button class="link outlet-toolbar-link outlet-map-toggle" data-mode="{{mode==='map' ? 'list' : 'map'}}" bindtap="mode">
      <t-icon name="{{mode==='map' ? 'view-list' : 'map'}}" size="32rpx" aria-hidden="true"/><text>{{mode==='map' ? '返回列表' : '查看地图'}}</text>
    </button>
  </view>
  <view wx:elif="{{state}}" class="outlet-quick-filters outlet-status-filters" aria-label="网点营业状态">
    <button wx:for="{{statusFilters}}" wx:key="value" class="outlet-quick-filter {{statusFilter===item.value ? 'active' : ''}}" data-status="{{item.value}}" bindtap="filterStatus"
      aria-label="{{item.label + (statusFilter===item.value ? '，已选择' : '')}}">{{item.label}}</button>
  </view>
  <view wx:if="{{state && !isPublic}}" class="outlet-toolbar">
    <button wx:if="{{state && !isPublic}}" class="link outlet-toolbar-link" data-scope="{{directory ? 'private' : 'public'}}" bindtap="changeScope">{{directory ? '返回我的网点' : '浏览服务网点'}}</button>
    <button wx:if="{{state && !directory && !isPublic && rows.length}}" class="link outlet-toolbar-link" data-page="requests" data-query="type=newOutlet" bindtap="nav">申请新增网点</button>
  </view>
  <view wx:if="{{directory && showRecent && !searchDraft && recentSearches.length}}" class="card recent-searches">
    <view class="row between"><view class="card-title">最近搜索</view><button class="link" bindtap="clearRecent">清除记录</button></view>
    <view class="filter">
      <button wx:for="{{recentSearches}}" wx:key="*this" class="pill" data-term="{{item}}" bindtap="chooseRecent">{{item}}</button>
    </view>
  </view>
  <view wx:if="{{state && !showRegionFilters && (countryCode || region.length)}}" class="row between outlet-filter-summary">
    <text class="muted grow">{{countryCode ? countryChoices[countryIndex].name : region[0] + ' / ' + region[1] + ' / ' + region[2]}}</text>
    <button class="link" bindtap="clearFilters" disabled="{{loading}}">清除筛选</button>
  </view>
  <view wx:if="{{showRegionFilters}}" class="card outlet-filter-panel">
    <picker wx:if="{{directory && countryChoices.length>1}}" class="country-filter" range="{{countryChoices}}" range-key="name" value="{{countryIndex}}" bindchange="filterCountry">
      <view class="picker picker-control">{{countryChoices[countryIndex].name}}</view>
    </picker>
    <view wx:if="{{!directory || geo!=='overseas' && (!countryCode || countryCode==='CN')}}" class="row between region-filter">
      <picker class="grow" mode="region" value="{{region}}" bindchange="region"><view class="picker picker-control">{{region.length ? region[0] + ' / ' + region[1] + ' / ' + region[2] : '按省 / 市 / 区筛选'}}</view></picker>
      <button wx:if="{{region.length}}" class="link" bindtap="clearRegion" disabled="{{loading}}">清除地区</button>
    </view>
    <view wx:if="{{directory && geo==='overseas' && countryChoices.length<=1}}" class="muted">可按网点名称、所在地或公开地址搜索。</view>
  </view>
  <view wx:if="{{loading && !hasLoaded}}" class="card content-skeleton">
    <text>正在加载网点信息…</text>
    <view class="content-skeleton-body" aria-hidden="true"/>
  </view>
  <view wx:elif="{{loading && !retainingRows}}" class="loading">正在更新网点信息…</view>
  <view wx:if="{{loading && retainingRows}}" class="tab-refresh-status" role="status">正在更新网点信息…</view>
  <block wx:if="{{hasLoaded && state && (!loading || retainingRows) && !error}}">
    <block wx:if="{{mode==='map'}}">
      <button wx:if="{{!directory && !mapError}}" class="link" bindtap="modeUnavailable">返回网点列表</button>
      <view wx:if="{{directory}}" class="row between directory-map-options">
        <text class="muted grow">{{directory && (geo==='overseas' || countryCode && countryCode!=='CN') ? '境外底图若显示不全，可按地址查找。' : '可按地址查找当前范围内的网点。'}}</text>
        <button class="link" bindtap="modeUnavailable">查看地址列表</button>
      </view>
      <view wx:if="{{mapLoading}}" class="loading">正在加载地图{{pointCount ? '，已找到 '+pointCount+' 处公开位置' : ''}}…</view>
      <view wx:if="{{mapError}}" class="error">
        {{mapError}}
        <view class="actions">
          <button class="outline small" bindtap="retryMap">重试地图</button>
          <button wx:if="{{!directory}}" class="outline small" bindtap="modeUnavailable">返回网点列表</button>
        </view>
      </view>
      <view wx:if="{{markers.length && !mapError}}" class="map-panel">
        <view wx:if="{{directory}}" class="row between map-toolbar">
          <text class="muted">{{pointCount}} 家网点已公开位置</text>
          <button class="link" bindtap="resetViewport">查看全部位置</button>
        </view>
        <map id="outlet-map" class="map outlet-map" latitude="{{center.lat}}" longitude="{{center.lng}}" scale="{{zoom}}" min-scale="{{minScale}}" max-scale="{{maxScale}}" markers="{{markers}}" bindmarkertap="marker" bindlabeltap="marker" bindregionchange="regionChanged" binderror="mapFailed" enable-zoom="{{true}}" enable-scroll="{{true}}" show-location="{{false}}"/>
        <view wx:if="{{selectedPoint}}" class="row between map-result">
          <text class="grow">{{selectedPoint.name}}</text>
          <button class="primary small" data-id="{{selectedPoint.id}}" bindtap="open">查看网点</button>
        </view>
        <view wx:if="{{clusterRows.length}}" class="map-result">
          <view class="card-title">这一带有 {{clusterTotal}} 家网点</view>
          <button wx:for="{{clusterRows}}" wx:key="id" class="map-outlet-link" data-id="{{item.id}}" bindtap="open">{{item.name}}</button>
          <button wx:if="{{clusterRows.length<clusterTotal}}" class="outline small top-gap" bindtap="moreCluster">查看更多网点</button>
        </view>
      </view>
      <view wx:if="{{!markers.length && rows.length && !mapLoading && !mapError}}" class="empty">{{directory ? '暂无网点公开位置，可查看下方网点地址。' : '暂无可在地图中显示的位置，可查看下方网点地址。'}}</view>
    </block>
    <block wx:if="{{mode==='list' || mapError || (!mapLoading && !markers.length)}}">
    <block wx:for="{{groups}}" wx:for-item="group" wx:key="key">
      <view wx:if="{{group.label}}" class="outlet-group">{{group.label}}</view>
      <view wx:for="{{group.rows}}" wx:key="id" class="card outlet-entry {{directory || isPublic ? '' : 'outlet-private-entry'}}">
        <view class="outlet-card-link" data-id="{{item.id}}" bindtap="open" hover-class="tap-feedback" aria-role="button" aria-label="查看{{item.name}}详情" aria-disabled="{{loading}}">
          <view class="outlet-card-icon" aria-hidden="true"><t-icon name="store" size="43rpx"/></view>
          <view class="outlet-card-copy">
            <view class="outlet-heading"><view class="card-title grow">{{item.name}}</view><text wx:if="{{item.statusText}}" class="badge {{item.statusTone}}">{{item.statusText}}</text></view>
            <view wx:if="{{directory || isPublic}}" class="outlet-location">
              <text wx:if="{{item.area}}" class="muted">{{item.area}} · </text><text>{{item.address || '暂无可查看地址'}}</text>
            </view>
            <view wx:elif="{{item.area}}" class="muted outlet-area">{{item.area}}</view>
            <view wx:if="{{(directory || isPublic) && item.services.length}}" class="outlet-service-tags">
              <text wx:for="{{item.services}}" wx:for-item="service" wx:key="*this" class="outlet-service-tag">{{service}}</text>
            </view>
          </view>
          <t-icon class="outlet-detail-label" name="chevron-right" size="33rpx" aria-hidden="true"/>
        </view>
        <block wx:if="{{!directory && !isPublic}}">
          <view wx:if="{{item.businessChips.length || item.nextAction}}" class="outlet-business-footer">
            <view wx:if="{{item.businessChips.length}}" class="outlet-business-chips">
              <view wx:for="{{item.businessChips}}" wx:for-item="chip" wx:key="key" class="outlet-business-chip"
                aria-label="{{chip.title+'，'+chip.monthText+'，'+chip.statusText}}">
                <text>{{chip.label}}</text>
                <text class="badge outlet-business-state {{chip.tone}}">{{chip.stateText}}</text>
                <text wx:if="{{chip.settlementText}}" class="outlet-settlement">{{chip.settlementText}}</text>
              </view>
            </view>
            <button wx:if="{{item.nextAction}}" class="outline small outlet-next-button" data-id="{{item.id}}" bindtap="outletAction" aria-disabled="{{loading}}"
              aria-label="{{item.name+'，'+item.nextAction.text+'，'+item.nextAction.label}}">
              <text>{{item.nextAction.label}}</text>
              <text class="outlet-next-period">{{item.nextAction.monthText}}</text>
            </button>
          </view>
          <view wx:if="{{item.waitingText}}" class="muted outlet-waiting">{{item.waitingText}}</view>
        </block>
      </view>
    </block>
    <view wx:if="{{!rows.length}}" class="empty">
      {{search || region.length || countryCode || (!directory && statusFilter!=='all') ? '未找到符合条件的网点，请调整筛选。' : directory ? geo==='overseas' ? '当前暂无已公开的境外网点。' : '当前暂无可查看的服务网点。' : '您当前还没有网点，可提交新增网点申请。'}}
      <button wx:if="{{search || region.length || countryCode || (!directory && statusFilter!=='all')}}" class="link top-gap" bindtap="clearFilters">清除筛选</button>
      <button wx:elif="{{geo!=='all'}}" class="link top-gap" bindtap="clearFilters">查看全部服务网点</button>
      <button wx:elif="{{directory}}" class="link top-gap" data-page="support" bindtap="nav">联系总部</button>
      <button wx:else class="outline small top-gap" data-page="requests" data-query="type=newOutlet" bindtap="nav">申请新增网点</button>
    </view>
    <view wx:if="{{pagers.outlets.hasMore}}" class="pagination">
      <text class="muted">已显示 {{pagers.outlets.loaded}} / {{pagers.outlets.total}} 家网点</text>
      <button class="outline small" data-collection="outlets" bindtap="more" loading="{{pagers.outlets.loading}}" disabled="{{loading || pagers.outlets.loading}}">加载更多</button>
    </view>
    </block>
  </block>
</view>
