.outlet-toolbar{flex-wrap:wrap;gap:8rpx 16rpx;margin-bottom:14rpx}
.outlet-toolbar .filter{margin:0}
.outlet-search{gap:12rpx;margin:var(--space-lg) 0 var(--space-md);padding:var(--space-sm);border:1rpx solid var(--border);border-radius:var(--radius-card);background:var(--surface)}
.outlet-search{flex-wrap:wrap}
.outlet-search input{min-width:0;min-height:44px;flex-basis:220rpx;padding:0 16rpx;background:var(--surface-muted);border:1rpx solid var(--border);border-radius:var(--radius-control)}
.outlet-search button,.outlet-extra button{flex-shrink:0}
.outlet-extra{margin:0 0 12rpx;flex-wrap:wrap;gap:6rpx 12rpx}
.outlet-filter-summary{gap:12rpx;margin:0 0 12rpx}
.outlet-filter-summary button{flex-shrink:0}
.recent-searches .filter{margin:10rpx 0 0}
.recent-searches .card-title{margin:0}
.outlet-heading{align-items:flex-start;gap:10rpx}
.outlet-heading .badge{max-width:42%}
.outlet-address{margin:14rpx 0 5rpx;gap:12rpx;overflow-wrap:anywhere}
.outlet-group{margin:22rpx 0 10rpx;font-size:28rpx;font-weight:650;color:var(--text,#1c3048)}
.outlet-detail-label{display:block;margin:8rpx 0;color:var(--brand-deep,#174a80);font-size:25rpx}
.outlet-list-heading{margin-bottom:var(--space-sm)}
.outlet-private-entry { padding: var(--space-md) var(--space-lg); }
.outlet-private-link { min-height: 44px; padding: var(--space-xs) 0; }
.outlet-private-link .card-title { min-width: 0; overflow-wrap: anywhere; }
.outlet-private-link .badge { flex-shrink: 0; }
.outlet-private-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs) var(--space-sm);
  align-items: baseline;
  margin-top: var(--space-xs);
}
.outlet-private-meta .outlet-detail-label { margin: 0 0 0 auto; }
.outlet-next-task {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-xs) var(--space-sm);
  margin-top: var(--space-xs);
  padding-top: var(--space-xs);
  border-top: 1rpx solid var(--border);
}
.outlet-next-status { min-width: 0; flex-basis: 160rpx; color: var(--text); font-size: var(--font-caption); }
button.outlet-next-button:not([size="mini"]) { width: auto; min-height: 44px; max-width: 100%; margin: 0; }
.outlet-waiting { margin-top: var(--space-xs); }
.directory-filter{margin-bottom:14rpx}
.country-filter{display:block;margin:0 0 16rpx}
.region-filter{margin-bottom:12rpx}
.filter button.pill{width:auto;margin:0;line-height:1.48}
.map-panel{margin:6rpx 0 22rpx;padding:16rpx;background:#fff;background:var(--surface,#fff);border:1rpx solid #dfe7f2;border-color:var(--border,#dfe7f2);border-radius:20rpx}
.map-toolbar{padding:8rpx 8rpx 12rpx;flex-wrap:wrap}
.directory-map-options{gap:12rpx;margin:6rpx 0 14rpx;flex-wrap:wrap}
.directory-map-options button{flex-shrink:0}
.outlet-map{height:460rpx;margin:0}
.map-result{padding:18rpx 8rpx 4rpx}
.map-result>button{flex-shrink:0}
button.map-outlet-link{width:100%;padding:16rpx 4rpx;margin:3rpx 0 0;text-align:left;border-radius:0;border-bottom:1rpx solid #dfe7f2;border-color:var(--border,#dfe7f2);background:#fff;background:var(--surface,#fff);color:#174a80;color:var(--brand-deep,#174a80)}
