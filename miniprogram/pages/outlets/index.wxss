.outlets-page { padding-top: var(--space-md); }
.outlet-search-bar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--space-xs);
  align-items: center;
}
.outlet-search {
  display: flex;
  align-items: center;
  min-width: 0;
  padding-left: 16rpx;
  color: var(--muted);
  background: var(--surface-muted);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
}
.outlet-search input {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  margin-left: var(--space-xs);
  color: var(--text);
  font-size: var(--font-caption);
}
.outlets-page button.outlet-search-clear, .outlets-page button.outlet-search-submit, .outlets-page button.outlet-filter-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2xs);
  width: auto;
  min-width: 44px;
  min-height: 44px;
  padding: 0 8rpx;
  margin: 0;
  background: transparent;
  color: var(--brand-deep);
  font-size: var(--font-caption);
}
.outlets-page button.outlet-search-submit { color: var(--brand); }
.outlet-directory-controls {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--space-sm);
  align-items: end;
}
.outlet-quick-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  margin: var(--space-xs) 0 0;
  border-bottom: 1rpx solid var(--border);
}
.outlets-page button.outlet-quick-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 0 auto;
  width: auto;
  margin: 0;
  min-width: 44px;
  min-height: 44px;
  padding: 0 7rpx;
  border-radius: 0;
  border-bottom: 3rpx solid transparent;
  background: transparent;
  color: var(--muted);
  font-size: max(23rpx, 12px);
}
.outlets-page button.outlet-quick-filter.active { border-color: var(--brand); color: var(--brand); }
.outlet-status-filters { display: grid; grid-template-columns: repeat(5, minmax(44px, 1fr)); }
.outlets-page .outlet-status-filters button.outlet-quick-filter { padding: 0 4rpx; line-height: 1.25; text-wrap: balance; }
.outlet-toolbar { display: flex; flex-wrap: wrap; gap: 0 var(--space-lg); align-items: center; }
.outlets-page button.outlet-toolbar-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  width: auto;
  min-height: 44px;
  padding: 0;
  margin: 0;
  font-size: var(--font-caption);
}
.outlet-filter-summary { gap: var(--space-sm); margin-bottom: var(--space-sm); }
.recent-searches .filter { margin: var(--space-xs) 0 0; }
.recent-searches .card-title { margin: 0; }
.outlet-group { margin: var(--space-sm) 0 var(--space-xs); color: var(--muted); font-size: var(--font-caption); font-weight: 650; }
.outlet-entry { padding: var(--space-sm) var(--space-md); margin: var(--space-sm) 0; }
.outlet-card-link { display: flex; align-items: flex-start; gap: var(--space-sm); min-height: 44px; }
.outlet-card-icon {
  display: grid;
  place-items: center;
  flex: none;
  width: 82rpx;
  height: 82rpx;
  border-radius: var(--radius-control);
  background: linear-gradient(145deg, #d9ebfd, #eff6ff);
  color: var(--brand);
}
.outlet-private-entry .outlet-card-icon { width: 70rpx; height: 70rpx; }
.outlet-card-copy { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.outlet-heading { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 4rpx var(--space-xs); }
.outlet-heading .card-title { min-width: 0; margin: 0; line-height: 1.28; }
.outlet-heading .badge { flex: none; }
.outlet-area, .outlet-location { margin-top: var(--space-2xs); font-size: var(--font-caption); }
.outlet-detail-label { align-self: center; color: var(--muted); flex-shrink: 0; }
.outlet-service-tags, .outlet-business-chips { display: flex; gap: 6rpx; flex-wrap: wrap; }
.outlet-service-tags { margin-top: var(--space-xs); }
.outlet-business-chips { flex: 1 1 310rpx; min-width: 0; }
.outlet-service-tag, .outlet-business-chip {
  display: inline-flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx;
  max-width: 100%;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-badge);
  background: var(--surface-muted);
  color: var(--brand-deep);
  font-size: var(--font-caption);
  overflow-wrap: anywhere;
}
.outlet-service-tag { background: var(--brand-soft); }
.outlet-business-chip {
  column-gap: 5rpx;
  padding: 2rpx 6rpx;
  font-size: max(22rpx, 11px);
  line-height: 1.35;
}
.outlet-business-chip .outlet-business-state {
  margin: 0;
  padding: 2rpx 7rpx;
  font-size: inherit;
}
.outlet-settlement { color: var(--muted); }
.outlet-business-footer {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-top: var(--space-2xs);
}
.outlets-page button.outlet-next-button:not([size="mini"]) {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: none;
  width: auto;
  min-height: 44px;
  max-width: 100%;
  margin: 0 0 0 auto;
  padding: 4rpx 13rpx;
  line-height: 1.25;
}
.outlet-next-period { color: var(--muted); font-size: var(--font-caption); }
.outlet-waiting { margin-top: var(--space-xs); }
.country-filter{display:block;margin:0 0 16rpx}
.region-filter{margin-bottom:12rpx}
.filter button.pill{width:auto;margin:0;line-height:1.48}
.map-panel{margin:6rpx 0 22rpx;padding:16rpx;background:#fff;background:var(--surface,#fff);border:1rpx solid #dfe7f2;border-color:var(--border,#dfe7f2);border-radius:20rpx}
.map-toolbar{padding:8rpx 8rpx 12rpx;flex-wrap:wrap}
.directory-map-options{gap:12rpx;margin:6rpx 0 14rpx;flex-wrap:wrap}
.directory-map-options button{flex-shrink:0}
.outlet-map{height:460rpx;margin:0}
.map-result{padding:18rpx 8rpx 4rpx}
.map-result>button{flex-shrink:0}
button.map-outlet-link{width:100%;padding:16rpx 4rpx;margin:3rpx 0 0;text-align:left;border-radius:0;border-bottom:1rpx solid #dfe7f2;border-color:var(--border,#dfe7f2);background:#fff;background:var(--surface,#fff);color:#174a80;color:var(--brand-deep,#174a80)}
