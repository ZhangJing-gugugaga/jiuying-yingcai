<view class="page">
  <view class="section-head fees-heading">
    <view class="section-title">服务费</view>
    <button wx:if="{{!exactBill && section==='bills'}}" class="link" bindtap="toggleFilters">{{filtersOpen ? '收起筛选' : '筛选账单'}}</button>
    <button wx:if="{{!exactBill && section==='bills' && scopeReady}}" class="link" bindtap="toggleHistory">{{historyOpen ? '收起历史' : '历史记录'}}</button>
    <button wx:if="{{section!=='bills'}}" class="link" data-section="bills" bindtap="chooseSection" disabled="{{loading || busy}}">返回账单</button>
  </view>
  <view wx:if="{{historyOpen && scopeReady && !exactBill && section==='bills'}}" class="actions">
    <button class="link" data-section="records" bindtap="chooseSection" disabled="{{loading || busy}}">付款与实收历史</button>
    <button class="link" data-section="adjustments" bindtap="chooseSection" disabled="{{loading || busy}}">费用调整历史</button>
    <button class="link" bindtap="openAgreements">查看服务协议</button>
  </view>
  <view wx:if="{{loading && !hasLoaded}}" class="card content-skeleton">
    <text>正在加载服务费{{section==='bills' ? '账单' : '记录'}}…</text>
    <view class="content-skeleton-body" aria-hidden="true"/>
  </view>
  <view wx:elif="{{loading}}" class="loading">正在更新服务费{{section==='bills' ? '账单' : '记录'}}…</view>
  <view wx:if="{{error && (!paymentErrorBill || section!=='bills')}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button></view>
  <view wx:if="{{(!exactBill && filtersOpen) || error}}" class="card">
    <view class="field">
    <label>账单网点</label>
    <picker range="{{outlets}}" range-key="label" value="{{outletIndex}}" bindchange="filterOutlet" disabled="{{loading || busy}}">
      <view class="picker picker-control" hover-class="tap-feedback">{{outlets[outletIndex].label || '全部网点'}}</view>
    </picker>
    <input class="top-gap" placeholder="搜索网点名称或地区" value="{{outletSearch}}" bindconfirm="outletSearch" confirm-type="search" disabled="{{loading || busy}}"/>
    <button wx:if="{{pagers.outlets.hasMore}}" class="link" data-collection="outlets" bindtap="more" disabled="{{loading || pagers.outlets.loading}}">加载更多网点</button>
    </view>
    <view class="row between" wx:if="{{!exactBill && section==='bills'}}">
      <picker class="grow" mode="date" fields="month" value="{{filterMonthValue}}" bindchange="filterMonth" disabled="{{loading || busy}}">
        <view class="picker picker-control" hover-class="tap-feedback">{{filterMonthValue || '全部账单月份'}}</view>
      </picker>
      <button wx:if="{{filterMonthValue || statusFilter!=='all'}}" class="link" bindtap="clearFilters" disabled="{{loading || busy}}">清除账期与状态</button>
    </view>
  </view>
  <view wx:if="{{paymentNotice}}" class="notice">
    {{paymentNotice}}
    <!-- DEV_ONLY_START -->
    <view wx:if="{{payment.status==='success' && state.adapterMode==='mock'}}" class="hint">模拟付款已确认，没有产生真实扣款。</view>
    <!-- DEV_ONLY_END -->
    <button wx:if="{{payment.status==='success' && payment.billId}}" class="link" bindtap="openConfirmedBill">查看本次支付账单</button>
  </view>
  <button wx:if="{{scopeReady && payment.status==='pending' && state.adapterMode==='real'}}" class="outline" data-id="{{payment.id}}" bindtap="resume" disabled="{{busy}}">查看付款状态</button>
  <block wx:if="{{section==='bills'}}">
  <view wx:if="{{!exactBill && !filtersOpen && (selected || filterMonthValue)}}" class="hint">{{outlets[outletIndex].label}} · {{filterMonthValue || '全部账期'}}</view>
  <view wx:if="{{!exactBill}}" class="filter">
    <button class="pill {{statusFilter==='unpaid'?'active':''}}" data-status="unpaid" bindtap="filterStatus" disabled="{{loading || busy}}">待支付</button>
    <button class="pill {{statusFilter==='paid'?'active':''}}" data-status="paid" bindtap="filterStatus" disabled="{{loading || busy}}">已支付</button>
    <button class="pill {{statusFilter==='all'?'active':''}}" data-status="all" bindtap="filterStatus" disabled="{{loading || busy}}">全部账单</button>
  </view>
  <view wx:if="{{ledgerTotals && scopeReady && !loading && !exactBill && statusFilter==='unpaid'}}" class="card">
    <view class="card-title">待支付合计</view>
    <view wx:if="{{ledgerTotals.unpaid}}" class="metric-value amount-number">¥ {{ledgerTotals.unpaid}}</view>
    <view wx:else class="hint">暂未取得合计金额。单笔金额可在账单中查看。</view>
  </view>
  <view wx:elif="{{scopeReady && !loading && !exactBill && statusFilter==='unpaid'}}" class="hint">暂未取得合计金额。单笔金额可在账单中查看。</view>
  <view wx:if="{{bills.length && !exactBill}}" class="section-title">服务费账单</view>
  <view wx:for="{{bills}}" wx:key="id" class="card">
    <view class="row between"><text class="card-title grow">{{item.monthText}} · {{item.displayOutlet}}</text><text class="badge {{item.statusTone}}">{{item.statusText}}</text></view>
    <view wx:if="{{item.status==='reversed'}}" class="detail-row"><text>原账单金额</text><text class="amount-number">¥ {{item.amountText}}</text></view>
    <view wx:elif="{{item.status==='unpaid' && item.unpaidText}}" class="detail-row"><text>待支付金额</text><text class="amount-number">¥ {{item.unpaidText}}</text></view>
    <view wx:elif="{{item.payableText}}" class="detail-row"><text>应付金额</text><text class="amount-number">¥ {{item.payableText}}</text></view>
    <view wx:if="{{item.dueText && item.status==='unpaid'}}" class="hint">{{item.dueText}} 到期</view>
    <view wx:if="{{error && paymentErrorBill===item.id}}" class="error">{{error}}</view>
    <!-- DEV_ONLY_START -->
    <view wx:if="{{item.simulation}}" class="hint">测试账单</view>
    <view wx:if="{{exactBill && item.status==='unpaid' && state.adapterMode==='mock'}}" class="actions">
      <button class="outline small" data-id="{{item.id}}" data-channel="wechat" bindtap="confirmSimulation" disabled="{{busy || loading}}">模拟微信支付</button>
      <button class="outline small" data-id="{{item.id}}" data-channel="alipay" bindtap="confirmSimulation" disabled="{{busy || loading}}">模拟支付宝</button>
    </view>
    <!-- DEV_ONLY_END -->
    <block wx:if="{{exactBill && item.status==='unpaid'}}">
      <button wx:if="{{state.adapterMode==='real' && paymentEnabled}}" class="primary" data-id="{{item.id}}" bindtap="pay" disabled="{{busy || loading}}">微信支付</button>
      <view wx:if="{{state.adapterMode==='real' && !paymentEnabled}}" class="hint">微信支付暂未开放。</view>
    </block>
    <button class="link" data-id="{{item.id}}" bindtap="openBill" disabled="{{loading || busy}}">查看账单</button>
  </view>
  <view wx:if="{{state && !bills.length && !loading && !error}}" class="empty">
    {{filterMonthValue || statusFilter!=='all' ? '当前筛选下没有账单。' : '当前网点范围暂无服务费账单。'}}
    <button wx:if="{{filterMonthValue || statusFilter!=='all'}}" class="link" bindtap="clearFilters">查看所选网点的全部账单</button>
  </view>
  <view wx:if="{{pagers.bills.hasMore}}" class="pagination"><button class="outline small" data-collection="bills" bindtap="more" loading="{{pagers.bills.loading}}" disabled="{{loading || pagers.bills.loading}}">加载更多账单</button></view>
  <button wx:if="{{exactBill && scopeReady}}" class="link" bindtap="clearFilters" disabled="{{loading || busy}}">查看此网点全部账单</button>

  </block>
  <block wx:if="{{section==='records'}}">
  <view class="hint">以下记录按当前网点展示，涵盖全部账期。</view>
  <button wx:if="{{scopeReady}}" class="link" bindtap="openFinance">查看付款与凭证</button>
  <view class="section-title">付款记录</view>
  <view wx:for="{{payments}}" wx:key="id" class="card">
    <view class="row between"><text class="grow">{{item.outletName}}</text><text class="badge {{item.statusTone}}">{{item.statusText}}</text></view>
    <view class="detail-row"><text>{{item.dateText}}</text><text class="amount-number">¥ {{item.amountText}}</text></view>
    <view wx:if="{{item.channel}}" class="hint">{{item.channel==='alipay' ? '支付宝' : '微信支付'}}</view>
    <button wx:if="{{item.billId}}" class="link top-gap" data-id="{{item.id}}" data-section="payments" data-record="{{true}}" bindtap="openBill">查看原账单</button>
    <!-- DEV_ONLY_START -->
    <view wx:if="{{item.adapterMode==='mock'}}" class="hint">测试付款</view>
    <button wx:if="{{item.status==='pending' && state.adapterMode==='mock'}}" class="link" data-id="{{item.id}}" bindtap="resumeSimulation" disabled="{{busy || loading}}">继续模拟支付</button>
    <!-- DEV_ONLY_END -->
    <button wx:if="{{item.status==='pending' && item.adapterMode!=='mock' && state.adapterMode==='real'}}" class="link" data-id="{{item.id}}" bindtap="resume" disabled="{{busy}}">查看付款状态</button>
    <button wx:if="{{item.status==='pending' && item.adapterMode!=='mock' && state.adapterMode==='real'}}" class="link" data-id="{{item.id}}" bindtap="closeExpired" disabled="{{busy}}">关闭过期付款</button>
  </view>
  <view wx:if="{{state && !payments.length && !loading && !error}}" class="empty">暂无付款记录。</view>
  <view wx:if="{{pagers.payments.hasMore}}" class="pagination"><button class="outline small" data-collection="payments" bindtap="more" loading="{{pagers.payments.loading}}" disabled="{{loading || pagers.payments.loading}}">加载更多付款记录</button></view>

  <view class="section-title">实收记录</view>
  <view wx:for="{{receipts}}" wx:key="id" class="card">
    <view class="row between"><text class="grow">{{item.outletName}}</text><text class="amount-number">¥ {{item.amountText}}</text></view>
    <view wx:if="{{item.dateText}}" class="muted">{{item.dateText}}</view>
    <button wx:if="{{item.billId}}" class="link" data-id="{{item.id}}" data-record="receipt" data-section="receipts" bindtap="openBill">查看原账单</button>
  </view>
  <view wx:if="{{state && !receipts.length && !loading && !error}}" class="empty">暂无实收记录。</view>
  <view wx:if="{{pagers.receipts.hasMore}}" class="pagination"><button class="outline small" data-collection="receipts" bindtap="more" loading="{{pagers.receipts.loading}}" disabled="{{loading || pagers.receipts.loading}}">加载更多实收记录</button></view>

  </block>
  <block wx:if="{{section==='adjustments'}}">
  <view class="hint">以下调整按当前网点展示，涵盖全部账期。</view>
  <view class="section-title">费用调整记录</view>
  <view class="hint">费用调整以总部财务核算结果为准。</view>
  <view wx:for="{{adjustments}}" wx:key="id" class="card">
    <view class="card-title">{{item.outletName}}</view>
    <text class="badge {{item.status==='待财务核算调整' ? 'wait' : item.statusTone}} top-gap">{{item.statusText}}</text>
    <view wx:if="{{item.status==='待财务核算调整'}}" class="hint">申请已通过，费用调整正在核算。最终金额和服务期限以总部核算结果为准。</view>
    <block wx:else>
      <view wx:if="{{item.amount!=null}}" class="detail-row"><text>调整金额</text><text class="amount-number">¥ {{item.amountText}}</text></view>
      <view wx:if="{{item.offsetMonthText}}" class="detail-row"><text>抵扣月份</text><text>{{item.offsetMonthText}}</text></view>
      <view wx:if="{{item.serviceUntilText}}" class="detail-row"><text>服务可使用至</text><text>{{item.serviceUntilText}}</text></view>
    </block>
  </view>
  <view wx:if="{{state && !adjustments.length && !loading && !error}}" class="empty">暂无费用调整记录。</view>
  <view wx:if="{{pagers.adjustments.hasMore}}" class="pagination"><button class="outline small" data-collection="adjustments" bindtap="more" loading="{{pagers.adjustments.loading}}" disabled="{{loading || pagers.adjustments.loading}}">加载更多费用调整</button></view>
  </block>
  <!-- DEV_ONLY_START -->
  <view wx:if="{{state.adapterMode==='mock' && (simulationPrompt || payment.status==='pending')}}" class="mock-payment-overlay">
    <view class="card mock-payment-dialog">
      <block wx:if="{{simulationPrompt}}">
        <view class="card-title">{{simulationPrompt.channel==='alipay' ? '支付宝模拟付款' : '微信模拟付款'}}</view>
        <view class="detail-row"><text>付款网点</text><text>{{simulationPrompt.outletName}}</text></view>
        <view class="detail-row"><text>账单月份</text><text>{{simulationPrompt.monthText}}</text></view>
        <view class="detail-row"><text>待支付金额</text><text class="amount-number">¥ {{simulationPrompt.payableText}}</text></view>
        <view class="hint">当前为模拟支付，不会产生真实扣款。</view>
        <view wx:if="{{error}}" class="error">{{error}}</view>
        <view class="actions">
          <button class="outline" bindtap="cancelSimulationPrompt" disabled="{{busy}}">取消</button>
          <button class="primary" bindtap="startSimulation" loading="{{busy}}" disabled="{{busy || loading}}">确认模拟付款</button>
        </view>
      </block>
      <block wx:else>
        <view class="card-title">{{payment.channel==='alipay' ? '支付宝模拟付款' : '微信模拟付款'}}</view>
        <view class="hint">当前为模拟支付，不会产生真实扣款。</view>
        <view wx:if="{{error}}" class="error">{{error}}</view>
        <view wx:if="{{paymentNotice}}" class="notice">{{paymentNotice}}</view>
        <view wx:if="{{busy}}" class="loading">正在处理，请稍候…</view>
        <view class="actions">
          <button class="primary" data-outcome="success" bindtap="resolve" disabled="{{busy}}">模拟成功</button>
          <button data-outcome="failed" bindtap="resolve" disabled="{{busy}}">模拟失败</button>
        </view>
        <button class="outline top-gap" data-outcome="cancelled" bindtap="resolve" disabled="{{busy}}">取消模拟支付</button>
        <button wx:if="{{error || paymentNotice}}" class="link top-gap" bindtap="dismissSimulation" disabled="{{busy}}">返回账单</button>
      </block>
    </view>
  </view>
  <!-- DEV_ONLY_END -->
</view>
