.mock-payment-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 38, 33, 0.56);
  padding: 36rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom, 0px));
}
.mock-payment-dialog {
  width: 100%;
  max-width: 680rpx;
  max-height: 90vh;
  overflow-y: auto;
}
.fees-page { padding-top: var(--space-md); }
.fees-overview.card {
  border: 1rpx solid #cfdef5;
  background: radial-gradient(ellipse at 100% 0, #cfe4ff, transparent 67%), #edf5ff;
  color: var(--brand-deep);
  padding: var(--space-lg);
}
.fees-overview-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-sm); }
.fees-scope { flex: 1; min-width: 0; color: var(--brand-deep); }
.fees-scope-outlet, .fees-scope-period { display: flex; align-items: flex-start; gap: var(--space-xs); min-width: 0; overflow-wrap: anywhere; }
.fees-scope-outlet { font-weight: 700; }
.fees-scope-period { margin-top: var(--space-xs); color: var(--muted); font-size: var(--font-caption); }
.fees-overview-icon { flex: none; display: grid; place-items: center; width: 80rpx; height: 80rpx; border-radius: 24rpx; background: var(--surface); color: var(--brand); }
.fees-overview-label { margin-top: var(--space-md); color: var(--muted); font-size: var(--font-caption); }
.fees-overview.card .metric-value { text-align: left; font-size: var(--font-display); color: var(--brand-deep); overflow-wrap: anywhere; }
.fees-overview.card .hint { color: var(--muted); }
.fees-tools { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-sm); margin: var(--space-md) 0; }
.fees-page button.fees-tool {
  display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: var(--space-xs);
  min-height: 44px; width: 100%; min-width: 0; margin: 0; padding: 6rpx 8rpx;
  border: 1rpx solid var(--border); border-radius: var(--radius-control); background: var(--surface); color: var(--brand-deep);
}
.fees-page button.fees-tool-selected { background: var(--brand-soft); border-color: var(--brand); color: var(--brand); }
.fees-page button.fees-tool[disabled] { background: var(--neutral-bg); color: var(--neutral-text); }
.fees-history-menu { padding: var(--space-xs) var(--space-lg); }
.fees-page button.fees-history-item { display: flex; justify-content: space-between; align-items: center; gap: var(--space-xs); width: 100%; margin: 0; }
.fees-history-item + .fees-history-item { border-top: 1rpx solid var(--border); border-radius: 0; }
.fees-status-filter { margin: var(--space-sm) 0; }
.fees-bill-head { display: flex; align-items: flex-start; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); }
.fees-bill-identity { min-width: 0; flex: 1; }
.fees-bill-identity .card-title { margin: 0; overflow-wrap: anywhere; }
.fees-bill-month, .fees-amount-label { color: var(--muted); font-size: var(--font-caption); }
.fees-bill-month { margin-top: var(--space-xs); }
.fees-bill-amount { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--space-xs) var(--space-md);
  margin-top: var(--space-md); padding-top: var(--space-sm); border-top: 1rpx solid var(--border); }
.fees-amount-value { color: var(--brand-deep); font-size: var(--font-metric); font-weight: 700; }
.fees-amount-unknown { color: var(--muted); }
.fees-page button.fees-bill-link { width: auto; min-height: 44px; margin: 0; padding: 6rpx var(--space-sm); }
