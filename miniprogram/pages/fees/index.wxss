.fees-overview {
  background: var(--brand-deep);
  color: var(--surface);
  border: 0;
}

.fees-scope {
  color: var(--brand-on-dark);
  overflow-wrap: anywhere;
}

.fees-overview .metric-value {
  text-align: left;
  font-size: var(--font-display);
}

.fees-overview .hint { color: var(--brand-on-dark); }

.fees-tools {
  display: flex;
  flex-wrap: wrap;
  gap: 0 var(--space-lg);
  margin-bottom: var(--space-sm);
}

.mock-payment-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 38, 33, 0.56);
  padding: 36rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom, 0px));
}
.mock-payment-dialog {
  width: 100%;
  max-width: 680rpx;
  max-height: 90vh;
  overflow-y: auto;
}
