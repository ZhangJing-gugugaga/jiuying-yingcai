/* Shared visual system is defined in app.wxss. */
.page.login{padding-top:var(--space-xl);max-width:580px}
.login-heading{display:flex;align-items:center;gap:var(--space-lg);min-height:144rpx;padding:0 var(--space-lg);border-radius:var(--radius-card);background:repeating-linear-gradient(135deg,transparent 0 24rpx,var(--surface) 25rpx 26rpx,transparent 27rpx 52rpx),linear-gradient(120deg,var(--brand-soft),var(--surface))}
.login .brand-mark{width:88rpx;height:88rpx;flex-shrink:0;margin:0;background:transparent;border:0}
.login-brand-name{color:var(--muted);font-size:var(--font-caption)}
.login .title{font-size:var(--font-title);margin:var(--space-2xs) 0 0;letter-spacing:0}
.login .card > .primary{width:100%;margin-top:var(--space-md)}
.login-entry{display:flex;align-items:center;flex-wrap:wrap;gap:4rpx 14rpx;margin-top:12rpx}
.login-methods{display:grid;gap:var(--space-sm)}
.login-methods button{width:100%}
.login-entry button,.login-methods button{margin:0;min-height:88rpx}
.login-footer{justify-content:center}
.login-error{margin:14rpx 0}
.login .sms-actions{margin-top:0}
.login .sms-code{flex:1;min-width:0}
.login .sms-actions button{flex:0 0 auto}
.auth-control{display:block;min-width:0;margin:var(--space-md) 0;border:1rpx solid var(--border);border-radius:var(--radius-control);overflow:hidden;--td-input-bg-color:var(--background);--td-input-vertical-padding:16rpx;--td-input-label-text-color:var(--brand-deep);--td-input-default-text-color:var(--text);--td-input-placeholder-text-color:var(--muted)}
.auth-submit{display:block;margin-top:var(--space-lg)}
.staff-handoff{display:grid;gap:var(--space-sm)}
.staff-handoff-title{color:var(--text);font-size:var(--font-section);font-weight:700;line-height:1.45}
.staff-portal-url{display:block;min-width:0;color:var(--muted);font-size:var(--font-caption);word-break:break-all}
.login .card > .staff-handoff-button{width:100%;min-height:44px;margin:0;white-space:normal}
.staff-handoff .login-error{margin:0}
.login-activation.page { padding-top: 0; }
.activation-hero {
  margin: 0 calc(-1 * var(--space-xl)) var(--space-md);
  padding: var(--space-xl) var(--space-xl) 30rpx;
  background:
    radial-gradient(ellipse 78% 54% at 99% 112%, #dbe8fc 0 58%, transparent 59%),
    radial-gradient(ellipse 106% 50% at 16% -15%, rgba(248, 252, 255, .66) 0 78%, transparent 79%),
    radial-gradient(ellipse at center top, #d7e6fc, transparent 78%),
    linear-gradient(#e9f2ff, var(--background));
  text-align: center;
}
.activation-emblem {
  display: block;
  width: 246rpx;
  height: 176rpx;
  margin: 0 auto var(--space-md);
}
.activation-title { color: var(--text); font-size: max(44rpx, 22px); font-weight: 700; line-height: 1.3; }
.activation-caption { margin-top: var(--space-xs); color: var(--muted); font-size: max(27rpx, 14px); line-height: 1.45; }
.activation-card { padding: var(--space-lg); margin: 0 0 var(--space-md); }
.activation-field + .activation-field { margin-top: var(--space-lg); }
.activation-label { display: flex; align-items: center; gap: var(--space-xs); margin-bottom: var(--space-xs); font-size: max(30rpx, 16px); font-weight: 600; color: var(--text); }
.activation-input-shell {
  display: flex;
  align-items: center;
  min-width: 0;
  background: #f9fbfe;
  border: 1rpx solid var(--border-strong);
  border-radius: var(--radius-control);
}
.activation-input-shell:focus-within { border-color: var(--brand); box-shadow: 0 0 0 3rpx var(--focus-ring); }
.activation-input-shell.activation-input-error { border-color: var(--error-text); }
.activation-input-shell.activation-input-error:focus-within { box-shadow: 0 0 0 3rpx var(--error-bg); }
.activation-input { min-width: 0; flex: 1; min-height: 44px; padding: 0 16rpx; color: var(--text); font-size: max(29rpx, 15px); }
.login button.activation-visibility {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 44px;
  min-height: 44px;
  padding: 0;
  margin: 0;
  color: var(--brand-deep);
  background: transparent;
}
.login button.activation-visibility[aria-pressed="true"] { color: var(--brand); background: var(--brand-soft); }
.activation-field-error {
  margin-top: var(--space-xs);
  color: var(--error-text);
  font-size: max(25rpx, 13px);
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.login button.activation-submit { display: grid; place-items: center; width: 100%; min-height: 44px; margin: var(--space-md) 0 var(--space-xs); border-radius: var(--radius-card); font-size: max(32rpx, 17px); }
.login button.activation-submit:not([disabled]) { background: linear-gradient(100deg, #2f82eb, #0758bd); }
.activation-return { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; color: var(--muted); font-size: max(27rpx, 14px); }
.login button.activation-link, .login button.activation-support {
  display: flex; align-items: center; justify-content: center; width: auto; min-height: 44px;
  margin: 0; padding: 0 var(--space-xs); font-size: var(--font-caption);
}
.login button.activation-support { margin: 0 auto; }
.login button.activation-link { color: var(--brand); font-size: inherit; }
@media (min-width: 360px) {
  .activation-hero { padding-top: 40rpx; padding-bottom: 52rpx; }
  .activation-emblem { width: 296rpx; height: 218rpx; }
  .activation-title { font-size: 50rpx; }
  .activation-card { padding: 30rpx; margin-bottom: 0; }
  .activation-field + .activation-field { margin-top: 56rpx; }
  .login button.activation-submit { min-height: 52px; margin-top: 36rpx; }
}
@media (max-width: 359px) {
  .activation-hero { margin-left: calc(-1 * var(--space-lg)); margin-right: calc(-1 * var(--space-lg)); }
}
