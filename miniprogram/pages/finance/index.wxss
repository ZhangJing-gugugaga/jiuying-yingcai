.finance-sheet-overlay {
  position: fixed;
  z-index: 12;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 38, 33, 0.48);
  overflow-y: auto;
}

.finance-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 82vh;
  margin: 0;
  padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom, 0px));
  overflow-y: auto;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

@media (max-height:460px) {
  .finance-sheet {
    max-height: 100%;
  }
}
