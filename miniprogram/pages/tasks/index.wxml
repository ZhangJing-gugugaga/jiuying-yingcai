<view class="page compact">
  <view class="title">{{isPublic ? '通知' : (section==='tasks' && status==='resolved' ? '已完成的事项' : (section==='tasks' && status==='all' ? '全部事项' : '我的事项'))}}</view>
  <button wx:if="{{!isPublic && section==='tasks' && (status==='resolved' || status==='all')}}" class="link" data-section="notices" bindtap="selectSection" disabled="{{busy || openingRecord}}">返回通知</button>
  <view wx:if="{{session && !isPublic && section==='tasks' && status==='open'}}" class="matters-verification">
    <button class="outline" bindtap="openLocation" disabled="{{!state || loading}}">月度位置核验</button>
  </view>
  <view wx:if="{{session && !isPublic && !(section==='tasks' && (status==='resolved' || status==='all'))}}" class="matters-sections">
    <button class="pill {{section==='tasks' && status==='open'?'active':''}}" data-status="open" bindtap="status" disabled="{{busy || openingRecord}}">待我处理</button>
    <button class="pill {{section==='tasks' && status==='in_progress'?'active':''}}" data-status="in_progress" bindtap="status" disabled="{{busy || openingRecord}}">处理中</button>
    <button class="pill {{section==='notices'?'active':''}}" data-section="notices" bindtap="selectSection" disabled="{{busy || openingRecord}}" aria-label="{{hasLoaded && noticeUnread ? '通知，有未读消息' : '通知'}}">通知<text wx:if="{{hasLoaded && noticeUnread}}" class="matters-unread" aria-hidden="true"/></button>
  </view>
  <view wx:if="{{loading && !hasLoaded}}" class="card content-skeleton">
    <text>正在加载{{section==='tasks' && !isPublic ? '待办事项' : '通知'}}…</text>
    <view class="content-skeleton-body" aria-hidden="true"/>
  </view>
  <view wx:elif="{{loading}}" class="loading">正在更新{{section==='tasks' && !isPublic ? '待办事项' : '通知'}}…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button></view>
  <block wx:if="{{hasLoaded && section==='tasks' && !isPublic}}">
    <block wx:for="{{taskRows}}" wx:key="id">
      <view wx:if="{{item.groupHeading}}" class="section-title">{{item.groupHeading}}</view>
      <view class="card {{item.overdue ? 'matters-overdue' : ''}}">
        <view class="row between">
          <view class="card-title grow"><text wx:if="{{item.unreadNoticeIds.length}}" class="dot"/>{{item.title}}</view>
          <text class="badge {{item.statusTone}}">{{item.statusText}}</text>
        </view>
        <view wx:if="{{item.outletName || item.month}}" class="muted top-gap">{{item.outletName}}{{item.outletName && item.month ? ' · ' : ''}}{{item.month}}</view>
        <view wx:if="{{item.amountText}}" class="muted top-gap">{{item.amountText}}</view>
        <view class="row between top-gap">
          <view class="grow">
            <text wx:if="{{item.finishedText}}" class="muted">完成于 {{item.finishedText}}</text>
            <text wx:elif="{{item.dueText}}" class="muted">截止 {{item.dueText}}</text>
            <text wx:elif="{{item.notifiedText}}" class="muted">{{item.notifiedText}}</text>
          </view>
          <button wx:if="{{item.canOpen}}" class="outline small" data-id="{{item.id}}" bindtap="open" disabled="{{busy || openingRecord}}">{{item.actionText}}</button>
        </view>
      </view>
    </block>
    <t-empty wx:if="{{!taskRows.length && !loading && !error}}" class="native-empty" icon="task" description="{{status==='open' ? '目前没有需要您处理的事项。' : (status==='in_progress' ? '目前没有处理中的事项。' : '这里还没有事项记录。')}}"/>
    <view wx:if="{{pagers.businessTasks.hasMore}}" class="pagination">
      <text class="muted">已显示 {{pagers.businessTasks.loaded}} / {{pagers.businessTasks.total}} 条</text>
      <button class="outline small" data-collection="businessTasks" bindtap="more" loading="{{pagers.businessTasks.loading}}" disabled="{{loading || pagers.businessTasks.loading}}">加载更多</button>
    </view>
  </block>
  <block wx:elif="{{hasLoaded}}">
    <view class="filter">
      <button class="pill {{statusFilter==='all'?'active':''}}" data-status="all" bindtap="filterStatus" disabled="{{loading || busy || openingRecord}}">全部</button>
      <button class="pill {{statusFilter==='unread'?'active':''}}" data-status="unread" bindtap="filterStatus" disabled="{{loading || busy || openingRecord}}">未读</button>
      <button class="pill {{statusFilter==='read'?'active':''}}" data-status="read" bindtap="filterStatus" disabled="{{loading || busy || openingRecord}}">已读</button>
    </view>
    <view wx:for="{{noticeRows}}" wx:key="id" id="notice-{{item.id}}" class="card matters-notice">
      <view class="row between"><text class="muted grow">{{item.category}}</text><text class="badge {{item.read ? 'gray' : 'wait'}}">{{item.read ? '已读' : '未读'}}</text></view>
      <view class="card-title top-gap"><text wx:if="{{!item.read}}" class="dot"/>{{item.title}}</view>
      <view wx:if="{{item.scopeText}}" class="muted top-gap">{{item.scopeText}}</view>
      <view wx:if="{{item.body}}" class="hint">{{item.body}}</view>
      <view wx:if="{{item.displayTime}}" class="muted">{{item.displayTime}}</view>
      <view wx:if="{{item.hasLink || !item.read}}" class="actions">
        <button wx:if="{{item.hasLink}}" class="outline small" data-id="{{item.id}}" bindtap="open" disabled="{{busy || openingRecord}}">{{item.actionText}}</button>
        <button wx:if="{{!item.read}}" class="link" data-id="{{item.id}}" bindtap="read" disabled="{{busy || openingRecord}}">标为已读</button>
      </view>
    </view>
    <t-empty wx:if="{{!noticeRows.length && !loading && !error}}" class="native-empty" icon="task" description="{{messages.length ? '近期业务通知可在待我处理或处理中查看。' : (statusFilter==='unread' ? '目前没有未读通知。' : (statusFilter==='read' ? '目前没有已读通知。' : '目前没有通知。'))}}"/>
    <view wx:if="{{pagers.messages.hasMore}}" class="pagination">
      <text class="muted">已显示 {{pagers.messages.loaded}} / {{pagers.messages.total}} 条</text>
      <button class="outline small" data-collection="messages" bindtap="more" loading="{{pagers.messages.loading}}" disabled="{{loading || pagers.messages.loading}}">加载更多</button>
    </view>
    <button wx:if="{{session && !isPublic}}" class="link top-gap" data-status="resolved" bindtap="status" disabled="{{loading || busy || openingRecord}}">查看历史事项</button>
  </block>
</view>
