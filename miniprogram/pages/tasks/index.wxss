.matters-verification {
  margin: var(--space-md) 0;
}
.matters-verification button {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.matters-sections {
  display: flex;
  gap: 16rpx;
  margin: 12rpx 0;
}

.matters-sections button {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0 8rpx;
}

.matters-notice {
  scroll-margin-top: var(--space-md);
}

.matters-unread {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  margin-left: var(--space-xs);
  border-radius: 50%;
  background: var(--error-text);
}

.matters-overdue{background:#fff5f6}
