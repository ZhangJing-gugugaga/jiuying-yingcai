<view class="page">
  <view class="title">办理事项</view>
  <view wx:if="{{viewMode==='list' && boundOutlet && outlets[outletIndex].id}}" class="subtitle">{{outlets[outletIndex].selectionName}}</view>
  <button wx:if="{{viewMode!=='list'}}" class="link" bindtap="backToRecords" disabled="{{busy || locating || uploadingPhoto}}">{{supplementId && viewMode==='form' ? '返回申请详情' : '返回申请记录'}}</button>
  <view wx:if="{{loading}}" class="loading">正在加载，请稍候…</view>
  <view wx:if="{{error && viewMode!=='form'}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button></view>
  <block wx:if="{{!isPublic && viewMode==='chooseType'}}">
    <view class="subtitle">请选择要办理的事项。</view>
    <view wx:for="{{typeGroups}}" wx:for-item="group" wx:key="name" class="card">
      <view class="card-title">{{group.name}}</view>
      <button wx:for="{{group.options}}" wx:key="index" class="outline request-type" data-index="{{item.index}}" bindtap="pickRequestType" disabled="{{loading}}">
        <text>{{item.name}}</text><text class="muted">{{item.materials}}</text>
      </button>
    </view>
    <view class="hint">{{types[typeIndex].materials}}</view>
  </block>
  <view wx:if="{{!isPublic && viewMode==='form'}}" class="card">
    <view class="row between">
      <view class="card-title">{{supplementId ? '补充资料 · ' : ''}}{{types[typeIndex].name}}</view>
      <button wx:if="{{canChangeType && !supplementId}}" class="link" bindtap="chooseAgain" disabled="{{busy || loading || locating || uploadingPhoto}}">更换事项</button>
    </view>
    <view wx:if="{{boundOutlet && outlets[outletIndex].id}}" class="detail-row"><text>申请网点</text><text>{{outlets[outletIndex].selectionName}}</text></view>
    <block wx:if="{{!boundOutlet && type!=='newOutlet'}}">
      <view class="field"><input placeholder="输入网点名称或所在地区" value="{{outletSearch}}" bindconfirm="outletSearch"/></view>
      <view wx:if="{{pagers.outlets.hasMore}}" class="pagination">
        <text class="muted">已显示 {{pagers.outlets.loaded}} / {{pagers.outlets.total}} 家网点</text>
        <button class="outline small" data-collection="outlets" bindtap="more" loading="{{pagers.outlets.loading}}" disabled="{{loading || pagers.outlets.loading}}">加载更多</button>
      </view>
      <view class="field">
        <label>申请网点</label>
        <picker range="{{outlets}}" range-key="selectionName" value="{{outletIndex}}" bindchange="chooseOutlet" disabled="{{busy || loading || locating || uploadingPhoto || !!supplementId || !outlets[1]}}">
          <view class="picker picker-control">{{outlets[1] ? outlets[outletIndex].selectionName : '暂无可选网点'}}</view>
        </picker>
      </view>
    </block>
    <block wx:if="{{type==='newOutlet'}}">
      <view class="field"><label>网点名称</label><input data-field="name" value="{{form.name}}" bindinput="input"/></view>
      <view class="field"><label>国家或地区代码（选填）</label><input data-field="countryCode" value="{{form.countryCode}}" bindinput="input" maxlength="2" placeholder="留空为中国大陆，例如 SG 为新加坡"/></view>
      <view class="two-col">
        <view class="field"><label>所在省份（境外可留空）</label><input data-field="province" value="{{form.province}}" bindinput="input"/></view>
        <view class="field"><label>所在城市</label><input data-field="city" value="{{form.city}}" bindinput="input"/></view>
      </view>
      <view class="field"><label>所在区县（境外可留空）</label><input data-field="district" value="{{form.district}}" bindinput="input"/></view>
      <view class="field"><label>联系电话</label><input type="text" data-field="phone" maxlength="32" value="{{form.phone}}" bindinput="input"/></view>
      <view class="field">
        <label>预计开业日期</label>
        <picker mode="date" data-field="opening" value="{{form.opening}}" bindchange="input"><view class="picker picker-control">{{form.opening || '选择日期'}}</view></picker>
      </view>
    </block>
    <block wx:if="{{type==='newOutlet' || type==='locationChange'}}">
      <view wx:if="{{type==='locationChange' && outlets[outletIndex].address}}" class="detail-row"><text>当前经营地址</text><text>{{outlets[outletIndex].address}}</text></view>
      <view class="field">
        <label>{{type==='locationChange' ? '拟变更地址' : '详细经营地址'}}</label>
        <input data-field="address" value="{{form.address}}" bindinput="input"/>
      </view>
      <view class="actions">
        <button class="outline" data-manual="true" bindtap="locate" disabled="{{busy || loading || locating}}">地图选址</button>
        <button class="outline" data-manual="false" bindtap="locate" disabled="{{busy || loading || locating}}">获取当前位置</button>
        <button class="outline" bindtap="photo" loading="{{uploadingPhoto}}" disabled="{{busy || loading || uploadingPhoto}}">上传现场照片</button>
        <view wx:if="{{uploadingPhoto && photoProgress !== null}}" class="hint">{{photoProgress===100 ? '照片已传输，正在检查…' : '照片上传中 ' + photoProgress + '%'}}</view>
      </view>
      <view wx:if="{{locating}}" class="hint">正在确认位置，请稍候。</view>
      <view wx:if="{{coords}}" class="hint">{{coords.source==='gps' ? '已获取当前位置。' : '已在地图上确认位置。'}}提交后由总部核验。</view>
      <image wx:if="{{preview}}" src="{{preview}}" class="photo" mode="aspectFill"/>
    </block>
    <block wx:if="{{type==='pauseFee'}}">
      <view class="field">
        <label>申请暂停收费日期</label>
        <picker mode="date" data-field="from" value="{{form.from}}" bindchange="input"><view class="picker picker-control">{{form.from || '选择日期'}}</view></picker>
      </view>
      <view class="field">
        <label>申请暂停收费结束日期</label>
        <picker mode="date" data-field="to" value="{{form.to}}" bindchange="input"><view class="picker picker-control">{{form.to || '选择日期'}}</view></picker>
      </view>
      <view class="hint">暂停营业不会自动暂停咨询服务费，需单独提交暂停收费申请。</view>
    </block>
    <view wx:if="{{type==='enrollment'}}" class="detail-row"><text>网点开展招生业务</text><switch checked="{{applicable}}" color="#0e65b7" bindchange="applicability"/></view>
    <block wx:if="{{type==='statusChange'}}">
      <view wx:if="{{supplementId}}" class="field">
        <label>申请的营业状态</label>
        <view class="filter">
          <button wx:for="{{statusOptions}}" wx:key="index" class="pill {{typeIndex===item.index ? 'active' : ''}}" data-index="{{item.index}}" bindtap="pickRequestType" disabled="{{busy || loading}}">{{item.name}}</button>
        </view>
      </view>
      <view class="field">
        <label>申请生效日期</label>
        <picker mode="date" data-field="effectiveDate" value="{{form.effectiveDate}}" bindchange="input"><view class="picker picker-control">{{form.effectiveDate}}</view></picker>
      </view>
      <view wx:if="{{form.status==='paused'}}" class="hint">预计恢复日期暂未开放填写，可在申请原因中说明。</view>
      <view class="hint">如总部要求补充材料，请从原申请查看处理意见，并联系总部提交材料。</view>
    </block>
    <view wx:if="{{type==='exemptException'}}" class="field">
      <label>发生财务事项的月份</label>
      <picker mode="date" fields="month" data-field="month" value="{{form.month}}" bindchange="input"><view class="picker picker-control">{{form.month}}</view></picker>
    </view>
    <block wx:if="{{type==='accountChange'}}">
      <view wx:if="{{currentManager}}" class="detail-row"><text>当前负责人</text><text>{{currentManager}}</text></view>
      <view wx:if="{{types[typeIndex].change !== 'mobile'}}" class="field"><label>拟变更负责人</label><input data-field="managerName" value="{{form.managerName}}" bindinput="input"/></view>
      <view class="field"><label>拟绑定手机号</label><input type="number" data-field="mobile" value="{{form.mobile}}" bindinput="input"/></view>
      <view class="hint">需要提交身份证明时，请按总部要求办理。</view>
    </block>
    <view wx:if="{{type==='newOutlet'}}" class="field">
      <label>经营说明</label><textarea data-field="note" value="{{form.note}}" bindinput="input" maxlength="600"/>
    </view>
    <view wx:if="{{type!=='newOutlet' || supplementId}}" class="field">
      <label>{{supplementId ? '补充说明' : (type==='locationChange' || type==='accountChange' ? '变更原因' : '申请原因')}}</label>
      <textarea data-field="reason" value="{{form.reason}}" bindinput="input" maxlength="600" placeholder="请说明实际情况"/>
    </view>
    <view class="action-dock">
      <view wx:if="{{error && !loading}}" class="error">{{error}}</view>
      <view wx:if="{{type!=='newOutlet' && !outlets[outletIndex].id && !loading}}" class="hint">{{boundOutlet ? '无法核验此网点，请从原网点入口重新打开。' : '请先选择办理申请的网点。'}}</view>
      <view wx:if="{{(type==='newOutlet' || type==='locationChange') && (!coords || !photo)}}" class="hint">还缺{{!coords ? '地图位置' : ''}}{{!coords && !photo ? '、' : ''}}{{!photo ? '现场照片' : ''}}</view>
      <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || loading || locating || uploadingPhoto || (type!=='newOutlet' && !outlets[outletIndex].id) || ((type==='newOutlet' || type==='locationChange') && (!coords || !photo))}}">{{supplementId ? '提交补充资料' : (type==='accountChange' ? '提交变更申请' : '提交申请')}}</button>
    </view>
  </view>
  <block wx:if="{{viewMode==='list'}}">
  <button wx:if="{{!isPublic}}" class="primary" bindtap="beginRequest" disabled="{{loading || busy}}">新建申请</button>
  <view id="request-history" class="section-title">我的申请记录</view>
  <view class="filter">
    <view class="pill {{statusFilter==='all'?'active':''}}" data-status="all" bindtap="filterStatus" hover-class="tap-feedback">全部</view>
    <view class="pill {{statusFilter==='pending'?'active':''}}" data-status="pending" bindtap="filterStatus" hover-class="tap-feedback">待总部处理</view>
    <view class="pill {{statusFilter==='supplement'?'active':''}}" data-status="supplement" bindtap="filterStatus" hover-class="tap-feedback">待补充材料</view>
    <view class="pill {{statusFilter==='approved'?'active':''}}" data-status="approved" bindtap="filterStatus" hover-class="tap-feedback">已通过</view>
    <view class="pill {{statusFilter==='returned'?'active':''}}" data-status="returned" bindtap="filterStatus" hover-class="tap-feedback">未通过</view>
  </view>
  </block>
  <block wx:if="{{viewMode!=='form'}}" wx:for="{{requestRows}}" wx:key="id">
  <view wx:if="{{viewMode==='list' || historyId===item.id}}" id="request-{{item.id}}" class="card">
    <view class="row between"><view class="card-title">{{item.typeText}}</view><text class="badge {{item.statusTone}}">{{item.statusText}}</text></view>
    <view wx:if="{{item.progress}}" class="hint">{{item.progress.description}}<text wx:if="{{item.progressMonth}}"> 账期 {{item.progressMonth}}</text></view>
    <view wx:if="{{item.outletName}}" class="detail-row"><text>所属网点</text><text>{{item.outletName}}</text></view>
    <view wx:if="{{item.submittedText}}" class="detail-row"><text>提交时间</text><text>{{item.submittedText}}</text></view>
    <view wx:if="{{item.result}}" class="notice">{{item.status==='returned' || item.status==='supplement' ? '总部补件意见' : '总部处理意见'}}<view>{{item.result}}</view></view>
    <button wx:if="{{viewMode==='detail' && item.progress.billId}}" class="outline small" data-id="{{item.id}}" bindtap="openCreditBill">查看原抵扣账单</button>
    <view wx:if="{{viewMode==='detail' && item.status==='pending'}}" class="hint">申请已提交。总部处理后可在这里查看结果。</view>
    <view wx:if="{{viewMode==='detail' && item.canApplyPauseFee}}" class="hint top-gap">暂停收费需要另行申请，由总部审核。</view>
    <button wx:if="{{viewMode==='detail' && item.canApplyPauseFee}}" class="link top-gap" data-id="{{item.id}}" bindtap="applyPauseFee">另行申请暂停收费</button>
    <view wx:if="{{viewMode==='detail' && item.canApplyPauseBusiness}}" class="hint top-gap">暂停收费申请只涉及费用。如需暂停营业，可另行提交申请。</view>
    <button wx:if="{{viewMode==='detail' && item.canApplyPauseBusiness}}" class="link top-gap" data-id="{{item.id}}" bindtap="applyPauseBusiness">另行申请暂停营业</button>
    <button wx:if="{{viewMode==='detail' && item.type!=='reportRevoke' && (item.status==='supplement' || item.status==='returned')}}" class="outline small" data-id="{{item.id}}" bindtap="supplement">修改并补充资料</button>
    <button wx:if="{{viewMode==='list'}}" class="outline small" data-id="{{item.id}}" bindtap="showHistory">查看申请进度</button>
    <view wx:if="{{viewMode==='detail' && historyId===item.id}}" class="top-gap">
      <view class="card-title">办理进度</view>
      <view wx:if="{{workContact}}" class="detail-row"><text>{{workContact.title}}</text><text>{{workContact.phone}}</text></view>
      <button wx:if="{{workContact}}" class="outline small" bindtap="dialWorkContact" loading="{{workContactDialing}}" disabled="{{workContactDialing}}">拨打工作电话</button>
      <view wx:if="{{historyError}}" class="error">{{historyError}}<button class="link" bindtap="loadHistory">重试</button></view>
      <view wx:for="{{historyRows}}" wx:for-item="event" wx:key="id" class="top-gap">
        <view>{{event.label}}<text wx:if="{{event.result}}"> · {{event.result}}</text></view>
        <view wx:if="{{event.at}}" class="muted">{{event.at}}</view>
        <view wx:if="{{event.note}}" class="hint">{{event.note}}</view>
      </view>
      <view wx:if="{{!historyRows.length && !historyLoading && !historyError}}" class="muted">暂无处理记录。</view>
      <button wx:if="{{historyLoading || historyMore}}" class="link" loading="{{historyLoading}}" disabled="{{historyLoading}}" bindtap="loadHistory">加载更多处理记录</button>
    </view>
  </view>
  </block>
  <t-empty wx:if="{{viewMode==='list' && !requestRows.length && !loading && !error}}" class="native-empty" icon="file" description="当前筛选下暂无申请记录。"/>
  <view wx:if="{{viewMode==='list' && pagers.requests.hasMore}}" class="pagination">
    <text class="muted">已显示 {{pagers.requests.loaded}} / {{pagers.requests.total}} 条申请</text>
    <button class="outline small" data-collection="requests" bindtap="more" loading="{{pagers.requests.loading}}" disabled="{{loading || pagers.requests.loading}}">加载更多</button>
  </view>
</view>
