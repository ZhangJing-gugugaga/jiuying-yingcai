<view class="page compact">
  <view class="title">服务协议</view>
  <view class="subtitle">按网点查看收费约定和服务期限。</view>
  <view wx:if="{{loading}}" class="loading">正在加载，请稍候…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button></view>

  <view class="field">
    <label>协议网点</label>
    <picker range="{{outletOptions}}" range-key="label" value="{{outletIndex}}" bindchange="selectOutlet" disabled="{{loading}}">
      <view class="picker picker-control" hover-class="tap-feedback">{{outletOptions[outletIndex].label || '全部网点'}}</view>
    </picker>
  </view>
  <button wx:if="{{pagers.outlets.hasMore}}" class="link" data-collection="outlets" bindtap="more" loading="{{pagers.outlets.loading}}">加载更多网点</button>
  <block wx:for="{{agreementGroups}}" wx:key="key" wx:for-item="group">
  <view wx:if="{{group.rows.length}}" class="section-title">{{group.title}}</view>
  <view wx:for="{{group.rows}}" wx:key="id" class="card">
    <view class="row between"><text class="card-title grow">{{item.outletLabel}}</text><text class="badge {{item.statusTone}}">{{item.statusText}}</text></view>
    <view wx:if="{{item.servicePeriod}}" class="detail-row"><text>服务期间</text><text>{{item.servicePeriod}}</text></view>
    <view wx:if="{{item.amountText}}" class="detail-row"><text>月度服务费</text><text class="amount-number">¥ {{item.amountText}}</text></view>
    <button class="link" data-id="{{item.id}}" bindtap="toggleAgreement">{{expandedAgreement===item.id?'收起协议详情':'查看协议详情'}}</button>
    <block wx:if="{{expandedAgreement===item.id}}">
    <view wx:if="{{item.reference}}" class="detail-row"><text>协议编号</text><text>{{item.reference}}</text></view>
    <view wx:if="{{item.agreementStart}}" class="detail-row"><text>协议开始日期</text><text>{{item.agreementStart}}</text></view>
    <view wx:if="{{item.agreementEnd}}" class="detail-row"><text>协议终止日期</text><text>{{item.agreementEnd}}</text></view>
    <view wx:if="{{item.serviceUntil}}" class="detail-row"><text>网点已付服务可使用至</text><text>{{item.serviceUntil}}</text></view>
    <view wx:if="{{item.plan.name}}" class="detail-row"><text>服务方案</text><text>{{item.plan.name}}</text></view>
    <view wx:if="{{item.plan.version}}" class="detail-row"><text>服务方案版本</text><text>第 {{item.plan.version}} 版</text></view>
    <view wx:if="{{item.billDay}}" class="detail-row"><text>账单生成日期</text><text>每月 {{item.billDay}} 日</text></view>
    <view wx:if="{{item.dueDay}}" class="detail-row"><text>缴费截止日期</text><text>每月 {{item.dueDay}} 日</text></view>
    <view wx:if="{{item.plan.serviceEntity}}" class="detail-row"><text>服务主体</text><text>{{item.plan.serviceEntity}}</text></view>
    <view wx:if="{{item.plan.collectionEntity}}" class="detail-row"><text>收款主体</text><text>{{item.plan.collectionEntity}}</text></view>
    <view wx:if="{{item.plan.invoiceEntity}}" class="detail-row"><text>开票主体</text><text>{{item.plan.invoiceEntity}}</text></view>
    <view wx:if="{{item.plan.terms}}" class="hint">{{item.plan.terms}}</view>
    </block>
  </view>
  </block>
  <view wx:if="{{state && !rows.length && !loading && !error}}" class="empty">所选网点暂无服务协议。如已签订，请联系总部核实。</view>
  <view wx:if="{{pagers.agreements.hasMore}}" class="pagination">
    <button class="outline small" data-collection="agreements" bindtap="more" loading="{{pagers.agreements.loading}}">加载更多协议</button>
  </view>

  <view class="section-title">已发布服务方案</view>
  <view wx:for="{{publishedPlans}}" wx:key="id" class="card">
    <view class="row between">
      <view class="card-title grow">{{item.name}}</view>
      <text wx:if="{{item.amount!=null}}" class="gold amount-number">¥ {{item.amountText}} / 月</text>
    </view>
    <button wx:if="{{item.terms}}" class="link" data-id="{{item.id}}" bindtap="togglePlan">{{expandedPlan===item.id?'收起方案':'查看方案'}}</button>
    <view wx:if="{{expandedPlan===item.id && item.terms}}" class="hint">{{item.terms}}</view>
  </view>
  <view wx:if="{{state && !publishedPlans.length && !loading && !error}}" class="empty">总部暂未发布服务方案。</view>
  <view wx:if="{{pagers.pricePlans.hasMore}}" class="pagination">
    <button class="outline small" data-collection="pricePlans" bindtap="more" loading="{{pagers.pricePlans.loading}}">加载更多服务方案</button>
  </view>

  <view class="hint">首月、不足整月、暂停期间及服务顺延的费用，以双方确认的协议和总部核算结果为准。</view>
</view>
