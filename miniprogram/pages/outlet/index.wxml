<view class="page">
  <view wx:if="{{loading}}" class="loading">正在加载，请稍候…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button><button class="link" wx:if="{{isPublic || !internal}}" data-page="outlets" data-query="scope=public&mode=list" bindtap="nav">查看服务网点</button></view>
  <block wx:if="{{outlet && !error}}">
    <view class="title">{{outlet.name}}</view>
    <view class="row between">
      <text wx:if="{{internal && organizationName}}" class="muted">所属加盟商：{{organizationName}}</text>
      <text class="badge {{outlet.statusTone}}">{{outlet.statusText}}</text>
    </view>
    <image wx:if="{{publicRecord && outlet.coverPath}}" class="outlet-public-photo" src="{{outlet.coverPath}}" mode="aspectFill"
      aria-label="门店照片" data-path="{{outlet.coverPath}}" binderror="coverFailed"/>
    <block wx:if="{{internal}}">
      <view class="card outlet-section">
        <view class="card-title">月报与账单</view>
        <view class="grid outlet-actions">
          <view class="outlet-work-item">
            <t-icon name="task" size="36rpx" aria-hidden="true"/>
            <view class="outlet-work-title">经营月报</view>
            <view wx:if="{{businessSections.report}}" class="outlet-work-state">{{businessSections.report.monthText}} · {{businessSections.report.statusText}}</view>
            <button class="primary small" data-page="report" data-month="{{businessScope.report.month}}" bindtap="action">{{businessScope.report.status==='returned' ? '修改月报' : businessScope.report.status==='missing' ? '填写月报' : '查看月报'}}</button>
          </view>
          <view class="outlet-work-item">
            <t-icon name="wallet" size="36rpx" aria-hidden="true"/>
            <view class="outlet-work-title">服务费账单</view>
            <view wx:if="{{businessSections.fee}}" class="outlet-work-state">{{businessSections.fee.monthText}} · {{businessSections.fee.statusText}}</view>
            <button class="outline small" data-page="fees" data-month="{{businessScope.fee.status==='missing' ? '' : businessScope.fee.month}}" bindtap="action">查看账单</button>
          </view>
        </view>
        <view class="outlet-subsection">
          <view class="row between outlet-section-heading">
            <view class="outlet-subheading">本月经营情况</view>
            <text wx:if="{{summary}}" class="badge">{{summary.settled ? '数据已结算' : '本月数据尚未结算'}}</text>
          </view>
          <view wx:if="{{summaryError}}" class="hint">暂时无法获取本月经营数据，请刷新后重试。</view>
          <block wx:if="{{summary.settled}}">
            <view class="detail-row"><text>营业收入</text><text>{{summary.revenueText}}</text></view>
            <view class="detail-row"><text>有效完成订单</text><text>{{summary.ordersText}}</text></view>
            <view class="detail-row"><text>到店人次</text><text>{{summary.trafficText}}</text></view>
            <view class="detail-row"><text>实际招生人数</text><text>{{summary.enrollText}}</text></view>
          </block>
        </view>
      </view>
      <view class="card outlet-section">
        <view class="card-title">位置核验</view>
        <view wx:if="{{businessSections.location}}" class="outlet-location-state"><t-icon name="location" size="36rpx" aria-hidden="true"/><text>{{businessSections.location.monthText}} · {{businessSections.location.statusText}}</text></view>
        <view class="actions outlet-actions">
          <button class="outline small" data-page="location" data-month="{{businessScope.location.month}}" bindtap="action">{{businessScope.location.status==='exception' ? '查看并补充位置资料' : businessScope.location.status==='missing' ? '提交位置资料' : '月度位置核验'}}</button>
          <button class="link" data-page="location" data-history="true" bindtap="action">位置核验记录</button>
        </view>
      </view>
      <view class="card outlet-section">
        <view class="card-title">营业状态与申请</view>
        <view wx:if="{{outlet.statusNote}}" class="hint">{{outlet.statusNote}}</view>
        <view wx:if="{{outlet.statusSince}}" class="detail-row"><text>状态生效日期</text><text>{{outlet.statusSince}}</text></view>
        <view wx:if="{{outlet.status==='open' || outlet.status==='paused'}}" class="outlet-actions">
          <button wx:if="{{outlet.status==='open'}}" class="outline small" data-page="requests" data-type="statusChange" data-status="paused" bindtap="action">申请暂停营业</button>
          <button wx:elif="{{outlet.status==='paused'}}" class="outline small" data-page="requests" data-type="statusChange" data-status="open" bindtap="action">申请恢复营业</button>
        </view>
        <view class="hint">暂停营业不会自动暂停咨询服务费。两项申请由总部分别审核。</view>
        <button class="link" bindtap="toggleMatters" aria-expanded="{{mattersExpanded}}">{{mattersExpanded ? '收起其他办理事项' : '查看其他办理事项'}}</button>
        <view wx:if="{{mattersExpanded}}" class="outlet-subsection">
          <view class="outlet-subheading">服务费与申请进度</view>
          <view class="actions outlet-actions">
            <button class="outline small" data-page="requests" data-type="pauseFee" bindtap="action">申请暂停收费</button>
            <button class="outline small" data-page="requests" data-history="true" bindtap="action">其他申请及进度</button>
            <button class="outline small" data-page="requests" bindtap="action">办理网点事项</button>
          </view>
        </view>
      </view>
    </block>
    <view class="card top-gap outlet-address-card {{internal ? 'outlet-section' : ''}}">
      <view class="card-title">{{internal ? '网点资料' : '对外地址'}}</view>
      <view wx:if="{{internal}}" class="outlet-subheading outlet-actions">经营地址</view>
      <view wx:if="{{outlet.area || outlet.districtText}}" class="muted">{{outlet.area || outlet.districtText}}</view>
      <view class="outlet-address-text top-gap">{{outlet.address || '暂无可查看地址'}}</view>
      <view wx:if="{{outlet.businessHours}}" class="hint">服务时间 {{outlet.businessHours}}</view>
      <view class="actions top-gap">
        <button wx:if="{{outlet.navigationPoint}}" class="primary small" bindtap="openNavigation">打开导航</button>
        <button wx:if="{{outlet.address}}" class="outline small" bindtap="copy">复制地址</button>
        <button wx:if="{{publicRecord}}" class="outline small" bindtap="dialPublic" disabled="{{!outlet.publicPhone}}">拨打网点电话</button>
      </view>
      <view wx:if="{{publicRecord && !outlet.publicPhone}}" class="hint">该网点暂未公开电话，可联系总部咨询。</view>
      <view wx:if="{{!internal}}" class="actions">
        <button wx:if="{{publicRecord}}" class="link" bindtap="toggleFavorite" aria-pressed="{{favorite}}">{{favorite ? '取消收藏' : '收藏网点'}}</button>
        <button class="link" data-page="support" bindtap="nav">联系总部</button>
      </view>
      <view wx:if="{{internal}}" class="outlet-subsection">
        <view wx:if="{{outlet.phone}}" class="detail-row"><text>联系电话</text><text>{{outlet.phone}}</text></view>
        <view wx:if="{{outlet.openingText}}" class="detail-row"><text>预计开业日期</text><text>{{outlet.openingText}}</text></view>
        <view class="detail-row"><text>招生业务适用情况</text><text>{{outlet.enrollmentText}}</text></view>
        <view class="actions outlet-actions">
          <button class="outline small" data-page="agreements" bindtap="action">查看服务协议</button>
        </view>
      </view>
    </view>
    <block wx:if="{{internal}}">
      <view class="card outlet-section">
        <view class="row between outlet-section-heading">
          <view class="card-title">网点历史记录</view>
          <button wx:if="{{history.length || locationHistory.length}}" class="link" bindtap="toggleHistory" aria-expanded="{{historyExpanded}}">{{historyExpanded ? '收起记录' : '查看记录（'+(history.length+locationHistory.length)+'）'}}</button>
        </view>
        <view wx:if="{{!history.length && !locationHistory.length}}" class="muted">暂无营业状态和位置变更记录。</view>
        <block wx:if="{{historyExpanded}}">
          <view wx:if="{{history.length}}" class="muted top-gap">营业状态变更</view>
          <view wx:for="{{history}}" wx:key="index" class="detail-row"><text>{{item.statusText}}</text><text>{{item.dateText}}</text></view>
          <view wx:if="{{locationHistory.length}}" class="muted top-gap">位置变更</view>
          <view wx:for="{{locationHistory}}" wx:key="index" class="outlet-history-change">
            <view class="muted">{{item.at}}</view>
            <view wx:if="{{item.before}}" class="detail-row"><text>变更前地址</text><text>{{item.before}}</text></view>
            <view wx:if="{{item.after}}" class="detail-row"><text>变更后地址</text><text>{{item.after}}</text></view>
          </view>
        </block>
      </view>
      <view class="card outlet-section">
        <view class="card-title">网点支持</view>
        <view wx:if="{{workContact}}" class="detail-row"><text>{{workContact.title}}</text><text>{{workContact.phone}}</text></view>
        <view class="actions outlet-actions">
          <button wx:if="{{workContact}}" class="outline small" bindtap="dialWorkContact" loading="{{workContactDialing}}" disabled="{{workContactDialing}}">拨打工作电话</button>
          <button class="outline small" data-page="support" bindtap="action">联系总部</button>
        </view>
      </view>
    </block>
  </block>
  <view wx:if="{{!outlet && !loading && !error}}" class="empty">暂时无法获取网点信息。<button class="link top-gap" data-page="outlets" data-query="scope=public&mode=list" bindtap="nav">查看服务网点</button></view>
</view>
