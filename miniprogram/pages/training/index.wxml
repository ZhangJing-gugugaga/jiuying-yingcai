<view class="page training-page">
  <view class="title">业务学习与培训</view>
  <view wx:if="{{loading}}" class="loading">正在读取培训信息…</view>
  <view wx:if="{{error || trainingError}}" class="error" role="alert">
    {{error || trainingError}}<button class="link" bindtap="refresh" disabled="{{busy || selecting || loading}}">重新读取</button>
  </view>
  <view wx:if="{{trainingNotice}}" class="training-notice" aria-live="polite">{{trainingNotice}}</view>
  <block wx:if="{{state && isPartner}}">
    <view class="card training-toolbar">
      <view class="training-tabs">
        <button class="{{tab==='courses' ? 'primary' : 'outline'}}" data-tab="courses" bindtap="selectTab">学习课程</button>
        <button class="{{tab==='records' ? 'primary' : 'outline'}}" data-tab="records" bindtap="selectTab">学员进度</button>
      </view>
      <view wx:if="{{outlets.length}}" class="field">
        <label>办理网点</label>
        <picker range="{{outlets}}" range-key="name" value="{{outletIndex}}" bindchange="selectOutlet" disabled="{{busy || selecting || loading}}">
          <view class="picker picker-control" hover-class="tap-feedback">{{outlets[outletIndex].name}}</view>
        </picker>
      </view>
      <view wx:elif="{{!loading}}" class="hint">当前账号暂无可办理培训的网点。</view>
      <button wx:if="{{pagers.outlets.hasMore}}" class="link" data-collection="outlets" bindtap="more" disabled="{{busy || selecting || loading}}">加载更多网点</button>
    </view>

    <block wx:if="{{tab==='courses'}}">
      <view wx:if="{{!courses.length && !coursesLoading && !trainingError && !error}}" class="card empty">总部暂未发布培训课程。</view>
      <view wx:for="{{courses}}" wx:key="id" class="card">
        <view class="row between"><text class="card-title">{{item.title}}</text>
          <button class="link" data-id="{{item.id}}" bindtap="openCourse">{{selectedCourse===item.id ? '收起' : '查看课程'}}</button>
        </view>
        <view wx:if="{{selectedCourse===item.id}}" class="training-course">
          <view class="training-text">{{item.content}}</view>
          <view wx:if="{{canEnroll}}" class="field training-separator">
            <label>学员姓名或培训编号</label>
            <input value="{{learner}}" bindinput="learnerInput" bindblur="learnerInput" maxlength="40" placeholder="填写后登记本课程学员" disabled="{{busy}}" />
            <button class="primary small top-gap" data-id="{{item.id}}" bindtap="begin" loading="{{busy}}" disabled="{{busy}}">登记学员</button>
          </view>
          <view wx:elif="{{!selectedOutletId}}" class="hint">请先选择办理网点，再登记学员。</view>
          <view wx:else class="hint">当前网点暂不开放学员登记，请切换可办理的网点。</view>
        </view>
      </view>
      <view wx:if="{{coursesLoading}}" class="loading">正在读取课程…</view>
      <button wx:if="{{courseNext !== null}}" class="outline" bindtap="moreCourses" disabled="{{coursesLoading}}">查看更多课程</button>
    </block>

    <block wx:else>
      <view wx:if="{{!records.length && !loading && !recordsLoading && !trainingError && !error}}" class="card empty">{{selectedOutletId ? '当前网点暂无学员培训记录。' : '选择网点后查看学员培训记录。'}}</view>
      <view wx:for="{{records}}" wx:key="id" class="card">
        <view class="row between">
          <text class="card-title grow">{{item.learner}}</text>
          <text class="badge {{item.status==='returned' ? 'red' : (item.statusStyle==='warn' ? 'wait' : item.statusStyle)}}">{{item.label}}</text>
        </view>
        <view class="muted training-meta">{{item.courseTitle}} · {{item.outletName}}</view>
        <view wx:if="{{item.updatedText}}" class="hint">更新于 {{item.updatedText}}</view>
        <button wx:if="{{recordId!==item.id}}" class="{{item.status==='returned' ? 'primary' : 'outline'}} small top-gap" data-id="{{item.id}}" bindtap="openMaterials" disabled="{{busy || selecting || loading}}">
          {{item.status==='returned' ? '查看退回并补件' : '查看记录'}}
        </button>
        <view wx:if="{{recordId===item.id}}" class="training-separator">
          <view wx:if="{{item.note}}" class="training-note {{item.status==='returned' ? 'returned' : ''}}">
            <view class="training-section-title">{{item.status==='returned' ? '退回原因' : '总部意见'}}</view>
            <view>{{item.note}}</view>
          </view>
          <view wx:if="{{recordRefreshError}}" class="training-error" role="alert">
            {{recordRefreshError}}<button class="link" bindtap="refresh" disabled="{{busy || selecting || loading}}">重新读取</button>
          </view>
          <view wx:if="{{materialNotice}}" class="training-notice" aria-live="polite">{{materialNotice}}</view>
          <view wx:elif="{{item.nextStep}}" class="training-next">{{item.nextStep}}</view>
          <view wx:if="{{uploadError}}" class="training-error" role="alert">{{uploadError}}</view>
          <view wx:if="{{item.mayUpload}}" class="top-gap">
            <view class="hint">提交一张培训资料图片，大小不超过 5 MB。请遮挡证件号码、住址等与培训无关的信息。</view>
            <image wx:if="{{uploadDraft}}" class="training-preview" src="{{uploadDraft.filePath}}" mode="aspectFit" aria-label="待提交资料预览" />
            <view class="row training-actions">
              <button class="{{uploadDraft ? 'outline' : 'primary'}} small" bindtap="chooseMaterial" loading="{{selecting}}" disabled="{{busy || selecting || loading}}">{{uploadDraft ? '重新选择' : (item.status==='returned' ? '重新上传资料' : '选择资料图片')}}</button>
              <button wx:if="{{uploadDraft}}" class="primary small" bindtap="submitMaterial" loading="{{busy}}" disabled="{{busy || selecting || loading}}">{{item.status==='returned' ? '提交补充资料' : '提交资料'}}</button>
            </view>
          </view>
          <view class="training-section-title training-separator">已提交的资料</view>
          <view wx:if="{{materialsLoading}}" class="loading">正在读取资料…</view>
          <view wx:elif="{{materialsError}}" class="training-error" role="alert">
            {{materialsError}}<button class="link" bindtap="retryMaterials">重新读取</button>
          </view>
          <view wx:elif="{{!materials.length}}" class="hint">还没有提交的资料。</view>
          <view wx:if="{{previewError}}" class="training-error" role="alert">{{previewError}}</view>
          <view wx:for="{{materials}}" wx:for-item="attachment" wx:key="id" class="row between training-attachment">
            <text class="training-file-name">第{{attachment.revision}}次 · {{attachment.name}}</text>
            <button class="link" data-id="{{attachment.id}}" bindtap="viewMaterial" disabled="{{busy}}">查看</button>
          </view>
          <button wx:if="{{materialsNext !== null}}" class="link" bindtap="moreMaterials" disabled="{{materialsLoading}}">查看更多提交</button>
          <view class="training-separator">
            <button class="link" bindtap="toggleHistory">{{historyOpen ? '收起处理记录' : '查看处理记录'}}</button>
            <block wx:if="{{historyOpen}}">
              <view wx:if="{{historyLoading}}" class="loading">正在读取处理记录…</view>
              <view wx:elif="{{historyError}}" class="training-error" role="alert">
                {{historyError}}<button class="link" bindtap="retryHistory">重新读取</button>
              </view>
              <view wx:elif="{{!history.length}}" class="hint">暂无处理记录。</view>
              <view wx:for="{{history}}" wx:for-item="event" wx:key="version" class="training-meta">
                <text>{{event.label}} · {{event.date}}</text>
                <view wx:if="{{event.note}}" class="hint">{{event.note}}</view>
              </view>
              <button wx:if="{{historyNext !== null}}" class="link" bindtap="moreHistory" disabled="{{historyLoading}}">查看更多处理记录</button>
            </block>
          </view>
          <button class="link" data-id="{{item.id}}" bindtap="openMaterials" disabled="{{busy || selecting || loading}}">收起学员记录</button>
        </view>
      </view>
      <view wx:if="{{recordsLoading}}" class="loading">正在读取学员进度…</view>
      <button wx:if="{{recordNext !== null}}" class="outline" bindtap="moreRecords" disabled="{{recordsLoading}}">查看更多学员</button>
    </block>
  </block>
  <view wx:if="{{state && !isPartner && !loading}}" class="card empty">请使用网点负责人账号查看培训内容。</view>
</view>
