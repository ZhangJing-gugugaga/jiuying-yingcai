/* Shared visual system is defined in app.wxss. */
.profile-login{flex-shrink:0;margin:0;min-height:88rpx}
.profile-retry{gap:10rpx;margin:0 0 16rpx}
.profile-retry button{flex-shrink:0}
.profile-link,.profile-favorites-button,.profile-favorite{display:flex;align-items:center;justify-content:space-between;gap:12rpx;width:100%;min-height:88rpx;margin:0;background:transparent;color:var(--text,#1c3048);text-align:left;line-height:1.45;padding:12rpx 0}
.profile-link + .profile-link{border-top:1rpx solid var(--border,#dfe7f2);border-radius:0}
.profile-favorite{border-bottom:1rpx solid var(--border,#dfe7f2);border-radius:0;overflow-wrap:anywhere}
.profile-favorites-button{font-weight:650}
.profile-version{font-size:24rpx;margin:4rpx 0 10rpx}
