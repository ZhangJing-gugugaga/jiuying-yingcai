<view class="page tab-page home-page {{publicView ? 'home-public' : 'home-member'}}">
  <block wx:if="{{!publicView && session.role==='partner'}}">
    <view class="workbench-hero">
      <image class="home-public-art" src="/assets/home-skyline.webp" mode="aspectFill" aria-hidden="true"/>
      <view class="workbench-hero-copy">
        <view class="home-public-brand"><text class="home-mark" aria-hidden="true">九</text><text>九盈英才</text></view>
        <view class="workbench-greeting">{{managerName ? '您好，'+managerName : '加盟商工作台'}}</view>
        <view class="home-caption">加盟商负责人</view>
      </view>
      <button class="workbench-notices" data-page="tasks" data-query="section=notices" bindtap="nav" aria-label="{{hasUnreadNotices ? '通知，有未读消息' : '通知'}}">
        <t-badge wx:if="{{hasUnreadNotices}}" dot="{{true}}"><t-icon name="notification" size="41rpx" aria-hidden="true"/></t-badge>
        <t-icon wx:else name="notification" size="41rpx" aria-hidden="true"/>
      </button>
    </view>

    <view wx:if="{{loading && !hasLoaded && outletCount===null}}" class="card content-skeleton">
      <text>正在查看授权网点…</text>
      <view class="content-skeleton-body" aria-hidden="true"/>
    </view>
    <view wx:elif="{{outletCount!==null}}" id="workbench-scope" class="workbench-scope">
      <t-icon class="workbench-scope-icon" name="shop" size="39rpx" aria-hidden="true"/>
      <view class="workbench-scope-content">
        <view wx:if="{{outletCount===0}}" class="workbench-scope-name">尚无授权网点</view>
        <button wx:elif="{{outletCount>1}}" class="workbench-scope-line workbench-scope-trigger" bindtap="toggleWorkbenchScope"
          disabled="{{loading}}" aria-expanded="{{scopeExpanded}}" aria-label="{{'切换网点，当前范围：'+scopeName}}">
          <text class="workbench-meta">{{scopeOutlet ? '当前网点' : outletCount+' 家网点'}}</text>
          <text class="workbench-scope-name">{{scopeName}}</text>
          <t-icon class="workbench-scope-arrow" name="{{scopeExpanded ? 'chevron-up' : 'chevron-down'}}" size="30rpx" aria-hidden="true"/>
        </button>
        <view wx:else class="workbench-scope-line">
          <text class="workbench-meta">当前网点</text>
          <text class="workbench-scope-name">{{scopeName}}</text>
        </view>
        <view wx:if="{{outletCount===0}}" class="workbench-meta">{{firstOutlet.detail}}</view>
      </view>
      <text wx:if="{{scopeStatus}}" class="badge {{scopeTone}}">{{scopeStatus}}</text>
      <view wx:if="{{scopeExpanded}}" class="workbench-scope-choices" aria-role="group" aria-label="工作台网点范围">
        <scroll-view class="{{scopeOutlets.length>4 ? 'workbench-scope-scroll' : ''}}" scroll-y="{{scopeOutlets.length>4}}">
          <button class="workbench-scope-choice" data-all="{{true}}" bindtap="chooseWorkbenchOutlet" aria-pressed="{{!scopeOutlet}}">
            <text>全部授权网点</text>
            <t-icon wx:if="{{!scopeOutlet}}" class="workbench-scope-check" name="check" size="34rpx" aria-hidden="true"/>
          </button>
          <button wx:for="{{scopeOutlets}}" wx:key="id" class="workbench-scope-choice" data-id="{{item.id}}" bindtap="chooseWorkbenchOutlet" aria-pressed="{{scopeOutlet===item.id}}">
            <view class="workbench-scope-choice-copy">
              <text>{{item.name}}</text>
              <text wx:if="{{item.city || item.district}}" class="workbench-meta">{{item.city}}{{item.city && item.district ? ' · ' : ''}}{{item.district}}</text>
            </view>
            <t-icon wx:if="{{scopeOutlet===item.id}}" class="workbench-scope-check" name="check" size="34rpx" aria-hidden="true"/>
          </button>
        </scroll-view>
        <button wx:if="{{pagers.outlets.hasMore}}" class="workbench-scope-action link" data-collection="outlets" bindtap="more"
          loading="{{pagers.outlets.loading}}" disabled="{{loading || pagers.outlets.loading}}">加载更多可选网点</button>
      </view>
    </view>
    <button wx:if="{{firstOutlet.actionText && !error}}" class="workbench-scope-action outline small" bindtap="openFirstOutlet">{{firstOutlet.actionText}}</button>
    <button wx:if="{{firstOutlet.status==='error'}}" class="workbench-scope-action outline small" bindtap="refresh">重试读取首店申请</button>

    <view class="home-tools {{trainingRecord ? '' : 'home-tools-five'}}">
      <button class="home-tool" data-page="reports" bindtap="openScopedTool" hover-class="tap-feedback">
        <t-icon class="home-tool-icon ice" name="file" size="35rpx" aria-hidden="true"/>
        <view class="home-tool-copy"><text class="home-tool-label">经营月报</text><text class="home-tool-note">填报 · 查进度</text></view>
      </button>
      <button class="home-tool" data-page="fees" bindtap="openScopedTool" hover-class="tap-feedback">
        <t-icon class="home-tool-icon amber" name="wallet" size="35rpx" aria-hidden="true"/>
        <view class="home-tool-copy"><text class="home-tool-label">咨询服务费</text><text class="home-tool-note">账单 · 付款</text></view>
      </button>
      <button class="home-tool" data-page="support" bindtap="openScopedTool" hover-class="tap-feedback">
        <t-icon class="home-tool-icon violet" name="service" size="35rpx" aria-hidden="true"/>
        <view class="home-tool-copy"><text class="home-tool-label">客服工单</text><text class="home-tool-note">咨询 · 查进度</text></view>
      </button>
      <button wx:if="{{trainingRecord}}" class="home-tool" bindtap="openTrainingSupplement" hover-class="tap-feedback" disabled="{{loading || trainingLoading}}">
        <t-icon class="home-tool-icon mint" name="education" size="35rpx" aria-hidden="true"/>
        <view class="home-tool-copy"><text class="home-tool-label">培训补件</text><text class="home-tool-note">补交学员资料</text></view>
      </button>
      <button class="home-tool" data-page="outlets" bindtap="openOutlets" hover-class="tap-feedback">
        <t-icon class="home-tool-icon ice" name="shop" size="35rpx" aria-hidden="true"/>
        <view class="home-tool-copy"><text class="home-tool-label">我的网点</text><text class="home-tool-note">{{firstOutlet.actionText || '网点状态管理'}}</text></view>
      </button>
      <button class="home-tool" bindtap="toggleMoreBusiness" hover-class="tap-feedback" aria-expanded="{{moreBusiness}}">
        <t-icon class="home-tool-icon violet" name="view-module" size="35rpx" aria-hidden="true"/>
        <view class="home-tool-copy"><text class="home-tool-label">更多业务</text><text class="home-tool-note">停业停费等</text></view>
      </button>
    </view>
    <view wx:if="{{moreBusiness}}" class="home-public-section workbench-more">
      <block wx:if="{{!scopeOutlet}}">
        <button wx:if="{{outletCount>1}}" class="outline small" bindtap="toggleWorkbenchScope" data-from-more="{{true}}" disabled="{{loading}}">选择办理网点</button>
        <button wx:else class="outline small" bindtap="openOutlets" disabled="{{loading}}">查看我的网点</button>
      </block>
      <block wx:else>
        <button wx:if="{{scopeTone==='ok'}}" class="outline small" data-page="requests" data-type="statusChange" bindtap="openOutletBusiness">申请暂停营业</button>
        <button wx:if="{{scopeStatus==='营业中' || scopeStatus==='暂停营业'}}" class="outline small" data-page="requests" data-type="pauseFee" bindtap="openOutletBusiness">申请暂停收费</button>
        <button class="outline small" data-page="location" bindtap="openOutletBusiness">月度位置核验</button>
      </block>
    </view>

    <view wx:if="{{(loading && hasLoaded) || (taskLoading && activeRows.length) || (recentLoading && recentRows.length)}}"
      class="tab-refresh-status" role="status">正在更新工作台…</view>
    <view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="refresh">重试</button></view>
    <view wx:if="{{taskOpenError}}" class="error" aria-live="polite">{{taskOpenError}}</view>
    <view class="home-public-section workbench-section">
      <view class="home-section-head">
        <view class="home-section-title">当前待办{{openTotal===null ? '' : '（'+openTotal+'）'}}</view>
        <button class="home-text-action" data-status="open" bindtap="openWorkbenchList">查看全部待办 <text aria-hidden="true">›</text></button>
      </view>
      <view wx:if="{{taskError}}" class="workbench-meta">暂时无法读取待办。<button class="home-text-action" bindtap="loadWorkbenchTasks">重试</button></view>
      <view wx:elif="{{taskLoading && !error && !activeRows.length}}" class="workbench-meta" aria-live="polite">正在加载待办…</view>
      <view wx:elif="{{!error && !activeRows.length}}" class="workbench-meta">当前暂无待办。</view>
      <view wx:for="{{activeRows}}" wx:key="id" class="workbench-task workbench-pending {{item.reason ? 'workbench-pending-with-reason' : ''}}">
        <t-icon class="workbench-task-icon {{item.tone}}" name="{{item.icon}}" size="40rpx" aria-hidden="true"/>
        <view class="workbench-task-copy">
          <view class="workbench-task-title">{{item.title}}</view>
          <view wx:if="{{item.scope}}" class="workbench-meta workbench-row-meta">
            <text wx:if="{{item.outletName}}" class="workbench-row-outlet">{{item.outletName}}</text>
            <text wx:if="{{item.scopeDetail}}" class="workbench-row-detail">{{item.scopeDetail}}</text>
          </view>
        </view>
        <text class="workbench-badge workbench-task-state {{item.tone}}">{{item.status}}</text>
        <view wx:if="{{item.reason}}" class="workbench-reason">{{item.reason}}</view>
        <button wx:if="{{item.canOpen}}" class="workbench-task-action" data-id="{{item.id}}" bindtap="openWorkbenchTask" aria-disabled="{{loading || taskLoading}}" disabled="{{openingTask}}"
          aria-label="{{item.actionText+'，'+item.title+(item.scope ? '，'+item.scope : '')}}">
          {{item.actionText}} <text aria-hidden="true">›</text>
        </button>
      </view>
    </view>
    <view class="home-public-section workbench-section">
      <view class="home-section-head">
        <view class="home-section-title">最近业务记录</view>
        <button class="home-text-action" data-section="records" bindtap="openWorkbenchList">查看全部记录 <text aria-hidden="true">›</text></button>
      </view>
      <view wx:if="{{recentError}}" class="workbench-meta">暂时无法读取记录。<button class="home-text-action" bindtap="loadWorkbenchTasks">重试</button></view>
      <view wx:elif="{{recentLoading && !error && !recentRows.length}}" class="workbench-meta" aria-live="polite">正在加载记录…</view>
      <view wx:elif="{{!error && !recentRows.length}}" class="workbench-meta">当前暂无业务记录。</view>
      <view wx:for="{{recentRows}}" wx:key="rowKey" class="workbench-task workbench-record" data-key="{{item.rowKey}}"
        bindtap="openWorkbenchTask" hover-class="tap-feedback" aria-role="button" aria-disabled="{{loading || recentLoading}}"
        aria-label="{{'查看'+item.displayTitle+(item.outletName ? '，'+item.outletName : '')+(item.timeText ? '，'+item.timeText : '')+'，'+item.statusText}}">
        <t-icon class="workbench-task-icon {{item.tone}}" name="{{item.icon}}" size="40rpx" aria-hidden="true"/>
        <view class="workbench-task-copy">
          <view class="workbench-task-title">{{item.displayTitle}}</view>
          <view wx:if="{{item.outletName || item.timeText}}" class="workbench-meta workbench-row-meta">
            <text wx:if="{{item.outletName}}" class="workbench-row-outlet">{{item.outletName}}</text>
            <text wx:if="{{item.timeText}}" class="workbench-row-detail">{{item.timeText}}</text>
          </view>
        </view>
        <view class="workbench-record-state">
          <text class="workbench-badge {{item.statusTone}}">{{item.statusText}}</text>
          <t-icon name="chevron-right" size="31rpx" aria-hidden="true"/>
        </view>
      </view>
    </view>
  </block>
  <block wx:elif="{{publicView}}">
    <view class="home-public-hero">
      <image class="home-public-art" src="/assets/home-skyline.webp" mode="aspectFill" aria-hidden="true"/>
      <view class="home-public-hero-copy">
        <view class="home-public-brand"><text class="home-mark" aria-hidden="true">九</text><text>九盈英才</text></view>
        <view class="home-public-title"><text>专业服务</text><text>共创发展</text></view>
        <view class="home-public-caption">教育赋能 · 运营支持 · 品牌共建</view>
      </view>
    </view>

    <view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="refresh">重试</button></view>

    <view class="home-public-section home-business">
      <view class="home-section-head">
        <view class="home-section-title">五大业务</view>
        <button class="home-text-action" data-page="discover" data-query="section=services" bindtap="nav">了解更多业务 <text aria-hidden="true">›</text></button>
      </view>
      <view wx:if="{{publishedServices.length}}" class="home-services {{publishedServices.length===5 ? 'home-services-five' : ''}}">
        <button wx:for="{{publishedServices}}" wx:key="id" class="home-service {{item.tileTone}}" data-id="{{item.id}}" bindtap="openService" hover-class="tap-feedback">
          <image wx:if="{{item.coverPath}}" class="home-service-image" src="{{item.coverPath}}" mode="aspectFill" lazy-load data-id="{{item.id}}" data-cover-path="{{item.coverPath}}" binderror="publicCoverFailed" aria-hidden="true"/>
          <t-icon wx:else name="{{item.tileIcon}}" size="46rpx" aria-hidden="true"/>
          <text class="home-service-title">{{item.title}}</text>
          <text wx:if="{{item.summary}}" class="home-service-summary">{{item.summary}}</text>
        </button>
      </view>
      <view wx:elif="{{loading}}" class="loading home-content-status">正在加载业务介绍…</view>
      <view wx:elif="{{hasLoaded && !error}}" class="home-content-status">业务介绍暂未发布。</view>
    </view>

    <view class="home-public-section home-network">
      <image class="home-network-art" src="/assets/home-coverage.webp" mode="aspectFill" aria-hidden="true"/>
      <view class="home-section-head">
        <view class="home-section-title">服务网点</view>
        <button class="home-text-action" data-page="outlets" data-query="scope=public&mode=map" bindtap="nav">全域地图 <text aria-hidden="true">›</text></button>
      </view>
      <view class="home-network-caption">按地区查找网点地址与营业状态</view>
      <view class="home-network-actions">
        <button class="home-region home-region-primary" data-page="outlets" data-query="scope=public&mode=list&geo=mainland" bindtap="nav" hover-class="tap-feedback">
          <t-icon name="location" size="34rpx" aria-hidden="true"/><text>国内网点</text><t-icon name="chevron-right" size="28rpx" aria-hidden="true"/>
        </button>
        <button class="home-region" data-page="outlets" data-query="scope=public&mode=list&geo=overseas" bindtap="nav" hover-class="tap-feedback">
          <t-icon name="internet" size="34rpx" aria-hidden="true"/><text>境外网点</text><t-icon name="chevron-right" size="28rpx" aria-hidden="true"/>
        </button>
      </view>
    </view>

    <view class="home-public-section home-group {{groupIntro.coverPath ? 'home-group-with-cover' : ''}}"
      data-page="discover" data-query="section=brand" bindtap="nav" hover-class="tap-feedback" aria-role="button">
      <view class="home-group-copy">
        <view class="home-section-title">集团介绍</view>
        <block wx:if="{{groupIntro}}">
          <view wx:if="{{groupIntro.title!=='九盈英才'}}" class="home-group-title">{{groupIntro.title}}</view>
          <view wx:if="{{groupIntro.summary || groupIntro.body || groupIntro.text || groupIntro.intro}}" class="home-group-summary">{{groupIntro.summary || groupIntro.body || groupIntro.text || groupIntro.intro}}</view>
        </block>
        <view wx:elif="{{hasLoaded && !error}}" class="home-content-status">集团介绍暂未发布。</view>
        <view class="home-group-link">了解九盈英才 <text aria-hidden="true">›</text></view>
      </view>
      <image wx:if="{{groupIntro.coverPath}}" class="home-group-image" src="{{groupIntro.coverPath}}" mode="aspectFill" lazy-load data-id="{{groupIntro.id}}" data-cover-path="{{groupIntro.coverPath}}" binderror="groupCoverFailed" aria-hidden="true"/>
    </view>

    <view class="home-public-section">
      <view class="home-section-head home-contact-head">
        <view class="home-section-title">联系我们</view>
        <button wx:if="{{session && session.role==='public'}}" class="home-text-action" data-page="messages" bindtap="nav" aria-label="{{hasUnreadNotices ? '通知，有未读消息' : '通知'}}">
          <t-badge wx:if="{{hasUnreadNotices}}" dot="{{true}}" offset="{{[0, 2]}}"><t-icon name="notification" size="32rpx" aria-hidden="true"/></t-badge>
          <t-icon wx:else name="notification" size="32rpx" aria-hidden="true"/><text>通知</text>
        </button>
      </view>
      <view class="home-contact-actions {{headquartersPhone ? 'home-contact-with-phone' : ''}}">
        <button wx:if="{{headquartersPhone}}" class="home-contact" bindtap="dialHeadquarters" hover-class="tap-feedback" aria-label="拨打总部电话 {{headquartersPhone}}"><t-icon name="call" size="36rpx" aria-hidden="true"/><view><text>服务电话</text><text class="home-contact-detail">{{headquartersPhone}}</text></view></button>
        <button class="home-contact" data-page="support" bindtap="nav" hover-class="tap-feedback"><t-icon name="service" size="36rpx" aria-hidden="true"/><text>联系总部</text></button>
        <button class="home-contact" data-page="join" bindtap="nav" hover-class="tap-feedback"><t-icon name="user-add" size="36rpx" aria-hidden="true"/><text>申请加盟</text></button>
        <button class="home-contact" data-page="discover" data-query="section=cooperation" bindtap="nav" hover-class="tap-feedback"><t-icon name="chat" size="36rpx" aria-hidden="true"/><text>合作咨询</text></button>
      </view>
    </view>

    <button wx:if="{{!session || session.role==='public'}}" class="home-signin" data-page="login" bindtap="nav" hover-class="tap-feedback">
      <t-icon name="user" size="48rpx" aria-hidden="true"/>
      <view class="home-signin-copy"><view>加盟商登录</view><text>已合作网点负责人办理经营与服务事项</text></view>
      <t-icon name="chevron-right" size="36rpx" aria-hidden="true"/>
    </button>
    <button wx:else class="home-signin" bindtap="returnWorkbench" hover-class="tap-feedback">
      <t-icon name="home" size="42rpx" aria-hidden="true"/><view class="home-signin-copy">返回工作台</view><t-icon name="chevron-right" size="36rpx" aria-hidden="true"/>
    </button>
    <view class="home-public-wave" aria-hidden="true"/>
  </block>
  <!-- DEV_ONLY_START -->
  <view wx:if="{{roleTrial && roleTrialMode !== 'authenticated'}}" class="card home-trial">
    <view class="section-title">隔离试用</view>
    <button class="outline" bindtap="openTrialApplication" disabled="{{roleTrialBusy}}">加盟付款试用</button>
    <button wx:if="{{session.role === 'partner'}}" class="link" bindtap="openTrialReport">查看试用月报</button>
    <button wx:else class="link" bindtap="openTrialWorkbench" disabled="{{roleTrialBusy}}">切回加盟商工作台</button>
    <view wx:if="{{roleTrialError}}" class="error">{{roleTrialError}}<button class="link" bindtap="onShow">重试</button></view>
  </view>
  <!-- DEV_ONLY_END -->
</view>
