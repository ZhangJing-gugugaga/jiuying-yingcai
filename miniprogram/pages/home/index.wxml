<view class="page tab-page home-page {{publicView ? 'home-public' : 'home-member'}}">
  <view class="home-header row between">
    <view class="row grow">
      <view class="home-mark" aria-hidden="true">九</view>
      <view class="grow">
        <view class="home-title">九盈英才</view>
        <view wx:if="{{managerName && !publicView}}" class="home-caption">{{managerName}}{{outletCount !== null ? ' · '+outletCount+' 家网点' : ''}}</view>
        <view wx:elif="{{publicView}}" class="home-caption">集团与网点服务</view>
        <view wx:else class="home-caption">{{displayDate || '加盟商工作台'}}</view>
      </view>
    </view>
    <block wx:if="{{publicView}}">
      <button wx:if="{{!session || session.role==='public'}}" class="home-login" data-page="login" bindtap="nav">加盟商登录</button>
      <button wx:elif="{{session}}" class="home-login" bindtap="returnWorkbench">返回工作台</button>
    </block>
  </view>

  <block wx:if="{{!publicView && session.role==='partner'}}">
    <view class="section-head"><view class="section-title">经营办理</view></view>
    <view class="home-tools">
      <button class="home-tool" data-page="outlets" data-query="scope=private" bindtap="openOutlets" hover-class="tap-feedback">
        <t-icon class="home-tool-icon ice" name="shop" size="41rpx" aria-hidden="true"/>
        <text class="home-tool-label">我的网点</text>
        <text class="home-tool-note">{{firstOutlet ? firstOutlet.actionText || '查看网点与申请' : outletCount ? outletCount+' 家网点' : '查看网点与申请'}}</text>
      </button>
      <button class="home-tool" data-page="reports" data-query="outlet=all" bindtap="nav" hover-class="tap-feedback">
        <t-icon class="home-tool-icon mint" name="file" size="41rpx" aria-hidden="true"/>
        <text class="home-tool-label">经营月报</text>
        <text class="home-tool-note">填报与审核进度</text>
      </button>
      <button class="home-tool" data-page="fees" bindtap="nav" hover-class="tap-feedback">
        <t-icon class="home-tool-icon amber" name="wallet" size="41rpx" aria-hidden="true"/>
        <text class="home-tool-label">咨询服务费</text>
        <text class="home-tool-note">账单与付款记录</text>
      </button>
      <button class="home-tool" data-page="tasks" bindtap="nav" hover-class="tap-feedback" aria-label="{{hasUnreadNotices ? '我的事项，有未读通知' : '我的事项'}}">
        <t-badge wx:if="{{hasUnreadNotices}}" dot="{{true}}" offset="{{[1, 4]}}">
          <t-icon class="home-tool-icon ice" name="task" size="41rpx" aria-hidden="true"/>
        </t-badge>
        <t-icon wx:else class="home-tool-icon ice" name="task" size="41rpx" aria-hidden="true"/>
        <text class="home-tool-label">我的事项</text>
        <text class="home-tool-note">{{openTotal > 0 ? openTotal+' 项待处理' : hasUnreadNotices ? '有未读通知' : '待办与通知'}}</text>
      </button>
    </view>
    <view wx:if="{{loading && !hasLoaded}}" class="card content-skeleton">
      <text>正在查看网点和待办…</text>
      <view class="content-skeleton-body" aria-hidden="true"/>
    </view>
    <view wx:elif="{{loading}}" class="loading">正在更新工作台…</view>
    <view wx:if="{{error || taskError}}" class="error">
      {{error || '暂时无法读取待办数量。'}}<button class="link" bindtap="refresh">重试</button>
    </view>
  </block>
  <block wx:elif="{{publicView}}">
    <view wx:if="{{error}}" class="error">{{error}}<button class="link top-gap" bindtap="refresh">重试</button></view>
    <view class="home-public-hero">
      <view class="home-public-hero-copy">
        <view class="home-public-title">{{groupIntro.title || '集团业务与服务'}}</view>
        <t-button theme="primary" shape="round" data-page="discover" data-query="section=services" bind:tap="nav">查看集团业务</t-button>
      </view>
      <image class="home-public-art" src="/assets/home-network.webp" mode="aspectFit" aria-hidden="true"/>
    </view>

    <view class="home-public-primary">
      <button class="home-feature" data-page="outlets" data-query="scope=public&mode=list" bindtap="nav" hover-class="tap-feedback">
        <t-icon class="home-feature-icon ice" name="location" size="45rpx" aria-hidden="true"/>
        <view class="home-feature-copy"><view class="home-feature-label">公开网点</view><view class="home-feature-detail">国内与境外</view></view>
      </button>
      <button class="home-feature" data-page="support" bindtap="nav" hover-class="tap-feedback">
        <t-icon class="home-feature-icon mint" name="service" size="45rpx" aria-hidden="true"/>
        <view class="home-feature-copy"><view class="home-feature-label">联系总部</view><view class="home-feature-detail">咨询与办事</view></view>
      </button>
    </view>

    <view class="home-public-shortcuts">
      <t-grid column="{{4}}" hover="{{true}}">
        <t-grid-item text="集团介绍" icon="home" data-page="discover" data-query="section=brand" bind:click="nav"/>
        <t-grid-item text="全域地图" aria-label="全域网点地图" icon="map" data-page="outlets" data-query="scope=public&mode=map" bind:click="nav"/>
        <t-grid-item text="申请加盟" icon="user-add" data-page="join" bind:click="nav"/>
        <t-grid-item text="合作咨询" icon="chat" data-page="discover" data-query="section=cooperation" bind:click="nav"/>
      </t-grid>
      <view wx:if="{{(session && session.role==='public') || headquartersPhone}}" class="home-public-followup">
        <button wx:if="{{session && session.role==='public'}}" class="home-contact" data-page="messages" bindtap="nav" aria-label="{{hasUnreadNotices ? '通知，有未读消息' : '通知'}}">
          <t-badge wx:if="{{hasUnreadNotices}}" dot="{{true}}" offset="{{[0, 2]}}"><t-icon name="notification" size="34rpx" aria-hidden="true"/></t-badge>
          <t-icon wx:else name="notification" size="34rpx" aria-hidden="true"/>
          <text>通知</text>
        </button>
        <button wx:if="{{headquartersPhone}}" class="home-contact" bindtap="dialHeadquarters" aria-label="拨打总部电话 {{headquartersPhone}}"><t-icon name="call" size="34rpx" aria-hidden="true"/><text>拨打总部电话</text></button>
      </view>
    </view>

    <view class="section-head">
      <view class="section-title">五大业务</view>
    </view>
    <view wx:if="{{publishedServices.length}}" class="home-services">
      <button wx:for="{{publishedServices}}" wx:key="id" class="home-service" data-id="{{item.id}}" bindtap="openService">
        <image wx:if="{{item.coverPath}}" class="home-service-image" src="{{item.coverPath}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="publicCoverFailed" aria-label="{{item.title}}封面" />
        <view wx:else class="home-service-placeholder" aria-hidden="true"><t-icon name="layers" size="48rpx"/></view>
        <view class="home-service-title">{{item.title}}</view>
      </button>
    </view>
    <view wx:elif="{{loading && !hasLoaded}}" class="card content-skeleton">
      <text>正在加载业务介绍…</text>
      <view class="content-skeleton-body" aria-hidden="true"/>
    </view>
    <view wx:elif="{{loading}}" class="loading">正在更新业务介绍…</view>
    <t-empty wx:elif="{{hasLoaded && !error}}" class="native-empty" icon="file" description="业务介绍准备中。"/>
  </block>
  <!-- DEV_ONLY_START -->
  <view wx:if="{{roleTrial && roleTrialMode !== 'authenticated'}}" class="card home-trial">
    <view class="section-title">隔离试用</view>
    <button class="outline" bindtap="openTrialApplication" disabled="{{roleTrialBusy}}">加盟付款试用</button>
    <button wx:if="{{session.role === 'partner'}}" class="link" bindtap="openTrialReport">查看试用月报</button>
    <button wx:else class="link" bindtap="openTrialWorkbench" disabled="{{roleTrialBusy}}">切回加盟商工作台</button>
    <view wx:if="{{roleTrialError}}" class="error">{{roleTrialError}}<button class="link" bindtap="onShow">重试</button></view>
  </view>
  <!-- DEV_ONLY_END -->
</view>
