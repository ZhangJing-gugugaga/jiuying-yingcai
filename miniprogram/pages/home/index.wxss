.home-page {
  --home-ice: #eaf3ff;
  --home-sky: #d7e8ff;
  --home-mint: #e6f5f0;
  --home-teal: #186b59;
  --home-amber: #fff3df;
  --home-rust: #8c5419;
  --home-pattern: rgba(37, 98, 190, .1);
  --home-shadow: rgba(21, 53, 105, .07);
  --td-grid-item-text-color: var(--text);
  --td-grid-item-bg-color: transparent;
  --td-grid-item-padding: 20rpx 1rpx 18rpx;
}
.home-header { margin-bottom: var(--space-md); flex-wrap: wrap; }
.home-member .home-header {
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  background:
    repeating-linear-gradient(128deg, transparent 0 28rpx, var(--home-pattern) 29rpx 30rpx, transparent 31rpx 56rpx),
    linear-gradient(110deg, var(--surface) 28%, var(--home-ice));
}
.home-header > .grow { flex-basis: 320rpx; }
.home-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, var(--brand), var(--brand-deep));
  color: var(--surface);
  font-size: 39rpx;
  font-weight: 650;
}
.home-title { font-size: 39rpx; font-weight: 700; line-height: 1.24; }
.home-caption { margin-top: 5rpx; color: var(--muted); font-size: var(--font-caption); }
.home-login {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  max-width: 100%;
  min-height: 44px;
  padding: 12rpx 21rpx;
  border: 1rpx solid var(--border-strong);
  background: var(--surface);
  color: var(--brand-deep);
  font-size: var(--font-caption);
}
button.home-login:not([size="mini"]) {
  width: auto;
  margin: 0;
}
.home-tools, .home-public-primary, .home-services {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-sm);
}
.home-tools { margin-bottom: var(--space-md); }
.home-tool {
  display: grid;
  justify-items: start;
  align-content: center;
  gap: 6rpx;
  min-height: max(188rpx, 84px);
  padding: var(--space-md);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  background: var(--surface);
  color: var(--brand-deep);
  text-align: left;
  box-shadow: 0 5rpx 22rpx var(--home-shadow);
}
button.home-tool:not([size="mini"]) {
  width: 100%;
  min-width: 0;
  margin: 0;
}
.home-tool-label { margin-top: var(--space-xs); font-size: 32rpx; font-weight: 700; }
.home-tool-note { max-width: 100%; color: var(--muted); font-size: var(--font-caption); overflow-wrap: anywhere; }
.home-tool-icon, .home-feature-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.home-tool-icon { width: 62rpx; height: 62rpx; border-radius: 18rpx; }
.home-trial { margin-top: var(--space-xl); }

.home-public-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  min-height: 284rpx;
  border-radius: 32rpx;
  padding: 30rpx var(--space-lg);
  background:
    radial-gradient(circle at 9% 15%, var(--surface) 0, transparent 51%),
    repeating-linear-gradient(0deg, transparent 0 31rpx, var(--home-pattern) 32rpx 33rpx),
    repeating-linear-gradient(90deg, transparent 0 31rpx, var(--home-pattern) 32rpx 33rpx),
    linear-gradient(115deg, var(--home-ice), var(--home-sky));
  color: var(--brand-deep);
}
.home-public-hero::before {
  content: "";
  position: absolute;
  width: 430rpx;
  height: 265rpx;
  right: -140rpx;
  bottom: -150rpx;
  border: 1rpx solid var(--home-pattern);
  border-radius: 50%;
  box-shadow: 0 0 0 26rpx var(--home-pattern), 0 0 0 53rpx var(--home-pattern);
  transform: rotate(-20deg);
}
.home-public-hero-copy { position: relative; z-index: 1; width: 58%; }
.home-public-art {
  position: absolute;
  top: 50%;
  right: 0;
  transform: translateY(-50%);
  width: 46%;
  height: 100%;
  mix-blend-mode: multiply;
  -webkit-mask-image: radial-gradient(ellipse 66% 62% at 54% 50%, #000 54%, transparent 100%);
  mask-image: radial-gradient(ellipse 66% 62% at 54% 50%, #000 54%, transparent 100%);
  pointer-events: none;
}
.home-public-title { font-size: 44rpx; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }
.home-public-hero-copy t-button { display: inline-block; margin-top: var(--space-lg); }
.home-public-primary { margin: var(--space-md) 0; }
.home-public-primary > .home-feature:first-child { background: linear-gradient(148deg, #f3f8ff, var(--surface) 62%); }
.home-public-primary > .home-feature:last-child { background: linear-gradient(148deg, #edf9f5, var(--surface) 62%); }
.home-public-shortcuts {
  padding: 4rpx 10rpx 0;
  margin: 0 0 var(--space-xl);
  border: 1rpx solid var(--border);
  border-radius: 26rpx;
  background: var(--surface);
  color: var(--brand);
  overflow: hidden;
  box-shadow: 0 5rpx 22rpx var(--home-shadow);
}
.home-public-followup {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  padding: 2rpx 14rpx;
  border-top: 1rpx solid var(--border);
}
button.home-contact:not([size="mini"]) {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: auto;
  min-height: 44px;
  padding: 8rpx 2rpx;
  margin: 0;
  background: transparent;
  color: var(--brand-deep);
  font-size: 25rpx;
}
button.home-feature:not([size="mini"]) {
  display: flex;
  align-items: center;
  gap: 13rpx;
  width: 100%;
  min-height: 128rpx;
  padding: 18rpx 13rpx;
  margin: 0;
  border: 1rpx solid var(--border);
  border-radius: 26rpx;
  background: var(--surface);
  color: var(--text);
  text-align: left;
  box-shadow: 0 5rpx 22rpx var(--home-shadow);
}
.home-feature-copy { min-width: 0; }
.home-feature-label { font-size: 30rpx; font-weight: 700; line-height: 1.3; }
.home-feature-detail { margin-top: 6rpx; font-size: 22rpx; color: var(--muted); font-weight: 400; }
.home-feature-icon { width: 72rpx; height: 72rpx; border-radius: 21rpx; }
.ice { background: var(--home-ice); color: var(--brand); }
.amber { background: var(--home-amber); color: var(--home-rust); }
.mint { background: var(--home-mint); color: var(--home-teal); }
.home-service {
  display: grid;
  align-content: start;
  gap: var(--space-sm);
  width: 100%;
  min-width: 0;
  padding: var(--space-sm);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  background: var(--surface);
  color: var(--text);
  text-align: left;
}
.home-service-image, .home-service-placeholder {
  width: 100%;
  height: 132rpx;
  border-radius: var(--radius-control);
  background: var(--home-ice);
}
.home-service-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  background: linear-gradient(120deg, var(--home-ice), var(--home-sky));
}
.home-service-title {
  padding: 0 var(--space-xs) var(--space-xs);
  font-size: var(--font-body);
  font-weight: 650;
  overflow-wrap: anywhere;
}
@media (max-width: 359px) {
  .home-header > .grow { flex-basis: 288rpx; }
  .home-tool { padding: var(--space-sm); }
  .home-tool-label { font-size: 30rpx; }
  .home-public-title { font-size: 39rpx; }
  .home-public-hero { padding: 26rpx 20rpx; }
  .home-feature-icon { width: 62rpx; height: 62rpx; }
  .home-feature-label { font-size: 28rpx; }
}
