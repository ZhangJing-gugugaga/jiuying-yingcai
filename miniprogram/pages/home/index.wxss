.home-page {
  --home-ice: #eaf3ff;
  --home-mint: #e6f5f0;
  --home-teal: #186b59;
  --home-amber: #fff3df;
  --home-rust: #8c5419;
  --home-shadow: rgba(21, 53, 105, .07);
}
.home-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, var(--brand), var(--brand-deep));
  color: var(--surface);
  font-size: 39rpx;
  font-weight: 650;
}
.home-caption { margin-top: 5rpx; color: var(--muted); font-size: var(--font-caption); }
.workbench-hero {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 240rpx;
  margin: calc(-1 * var(--space-xl)) calc(-1 * var(--space-xl)) 0;
  padding: 28rpx 28rpx 52rpx;
  background: linear-gradient(125deg, #eff7ff 10%, #bfddff);
  color: var(--brand-deep);
  overflow: hidden;
}
.workbench-hero-copy { z-index: 1; max-width: 75%; }
.workbench-greeting { margin-top: 20rpx; color: var(--text); font-size: 38rpx; font-weight: 700; overflow-wrap: anywhere; }
.home-page button.workbench-notices {
  z-index: 1;
  width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  display: grid;
  place-items: center;
  background: var(--surface);
  color: var(--brand);
  border-radius: 50%;
}
.workbench-scope {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: -32rpx;
  margin-bottom: var(--space-md);
  padding: 12rpx var(--space-md);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: 0 6rpx 18rpx var(--home-shadow);
}
.workbench-scope-content { min-width: 0; flex: 1; }
.workbench-scope-name { color: var(--text); font-size: 28rpx; font-weight: 700; overflow-wrap: anywhere; }
.workbench-scope-picker { display: flex; align-items: center; gap: var(--space-xs); min-height: 44px; }
.workbench-scope-icon { display: grid; place-items: center; width: 64rpx; height: 64rpx; flex: none; color: var(--brand); background: var(--home-ice); border-radius: 50%; }
.home-page button.workbench-scope-action { width: 100%; margin: 0 0 var(--space-md); }
.workbench-meta { color: var(--muted); font-size: var(--font-caption); overflow-wrap: anywhere; }
.home-tools {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  margin-bottom: var(--space-md);
  padding: 6rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  box-shadow: 0 6rpx 18rpx var(--home-shadow);
}
button.home-tool:not([size="mini"]) {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
  min-height: max(96rpx, 44px);
  margin: 0;
  padding: 13rpx 7rpx;
  border-right: 1rpx solid var(--border);
  border-bottom: 1rpx solid var(--border);
  border-radius: 0;
  background: transparent;
  color: var(--text);
  text-align: left;
}
.home-tool:nth-child(3n), .home-tool:last-child { border-right: 0; }
.home-tool:nth-child(n+4) { border-bottom: 0; }
.home-tool-copy { min-width: 0; flex: 1; line-height: 1.32; }
.home-tool-label, .home-tool-note { display: block; overflow-wrap: anywhere; }
.home-tool-label { font-size: max(24rpx, 12px); font-weight: 700; }
.home-tool-note { margin-top: 3rpx; color: var(--muted); font-size: max(20rpx, 10px); }
.home-tool-icon, .workbench-task-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
}
.workbench-task-icon { width: 66rpx; height: 66rpx; }
.workbench-task {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) minmax(0, auto);
  align-items: start;
  gap: var(--space-sm);
  padding: var(--space-md) 0;
  border-top: 1rpx solid var(--border);
}
.workbench-task-title, .workbench-reason { overflow-wrap: anywhere; }
.workbench-task-title { font-weight: 700; }
.workbench-reason { color: var(--error-text); font-size: var(--font-caption); white-space: pre-wrap; }
.workbench-task-actions { display: grid; justify-items: end; gap: 6rpx; }
.workbench-record { min-height: 44px; align-items: center; }
.workbench-record-state { display: flex; align-items: center; gap: var(--space-xs); color: var(--muted); }
.workbench-badge { padding: 3rpx 13rpx; border-radius: 999rpx; font-size: var(--font-caption); }
.home-page button.workbench-task-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2xs);
  width: auto;
  min-height: 44px;
  padding: 3rpx 12rpx;
  margin: 0;
  border: 1rpx solid var(--brand);
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--brand);
  font-size: var(--font-caption);
}
.workbench-more { display: flex; gap: var(--space-sm); flex-wrap: wrap; }
.workbench-more button { width: auto; }
.home-trial { margin-top: var(--space-xl); }
.ice, .blue { background: var(--home-ice); color: var(--brand); }
.amber { background: var(--home-amber); color: var(--home-rust); }
.mint, .green { background: var(--home-mint); color: var(--home-teal); }
.violet { background: #eeeaff; color: #594ac2; }
.red { background: var(--error-bg); color: var(--error-text); }
.gray { background: var(--surface-muted); color: var(--muted); }

.home-public-hero {
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  min-height: 272rpx;
  margin: calc(-1 * var(--space-xl)) calc(-1 * var(--space-xl)) 0;
  padding: 28rpx 34rpx 40rpx;
  background: linear-gradient(125deg, #f2f8ff 15%, #c6e1ff);
  color: #122b53;
}
.home-public-art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.home-public-hero-copy { position: relative; z-index: 1; max-width: 61%; }
.home-public-brand { display: flex; align-items: center; gap: 12rpx; font-size: 28rpx; font-weight: 700; }
.home-public-brand .home-mark { width: 46rpx; height: 46rpx; border-radius: 12rpx; font-size: 26rpx; }
.home-public-title { margin-top: 18rpx; font-size: 40rpx; font-weight: 750; line-height: 1.24; }
.home-public-caption { margin-top: 10rpx; color: var(--muted); font-size: var(--font-caption); }
.home-public-section {
  margin-top: 16rpx;
  padding: 14rpx 18rpx 18rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: 0 5rpx 18rpx var(--home-shadow);
}
.home-section-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4rpx 12rpx; }
.home-section-title {
  padding-left: 12rpx;
  border-left: 6rpx solid var(--brand);
  color: #122b53;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.18;
}
.home-public-section > .home-section-title { margin: 12rpx 0 16rpx; }
.home-page button.home-text-action {
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  width: auto;
  min-height: 44px;
  margin: 0;
  padding: 4rpx 0;
  background: transparent;
  color: var(--brand-deep);
  font-size: var(--font-caption);
  white-space: normal;
}
.home-public button.home-group-link { margin-bottom: -10rpx; }
.home-services { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 9rpx; }
.home-public button.home-service {
  display: grid;
  justify-items: center;
  align-content: start;
  gap: 10rpx;
  width: 100%;
  min-width: 0;
  min-height: max(120rpx, 44px);
  margin: 0;
  padding: 12rpx 5rpx;
  border-radius: 16rpx;
  background: var(--tile-bg, #eaf3ff);
  color: var(--tile-icon, #1767be);
  white-space: normal;
}
.home-service-title { color: var(--text); font-size: max(23rpx, 12px); font-weight: 650; line-height: 1.35; overflow-wrap: anywhere; }
.home-service-summary {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--muted);
  font-size: max(20rpx, 10px);
  line-height: 1.30;
}
.home-service-image { width: 100%; height: 62rpx; border-radius: 9rpx; }
.home-service.sky { --tile-bg: #e6f4fc; --tile-icon: #076d9f; }
.home-service.violet { --tile-bg: #eeeaff; --tile-icon: #594ac2; }
.home-service.gold { --tile-bg: #fcf1e2; --tile-icon: #a15408; }
.home-service.green { --tile-bg: #e5f6ee; --tile-icon: #107652; }
.home-content-status { margin: 10rpx 0; color: var(--muted); font-size: var(--font-caption); }
.home-network {
  position: relative;
  overflow: hidden;
  background: var(--surface);
}
.home-network-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.home-network .home-section-head, .home-network-actions, .home-network-caption { position: relative; }
.home-network-caption { margin: 0 0 var(--space-sm); color: var(--muted); font-size: var(--font-caption); }
.home-network-actions, .home-contact-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.home-public button.home-region, .home-public button.home-contact {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 8rpx 10rpx;
  border: 1rpx solid #cbdff7;
  border-radius: var(--radius-control);
  background: var(--surface);
  color: var(--brand-deep);
  font-size: max(25rpx, 13px);
  white-space: normal;
}
.home-public button.home-region { border-radius: 999rpx; }
.home-public button.home-region-primary { border-color: var(--brand); background: var(--brand); color: #fff; }
.home-contact-detail { display: block; color: var(--muted); font-size: var(--font-caption); overflow-wrap: anywhere; }
.home-group { display: flex; align-items: flex-start; gap: 16rpx; }
.home-group-copy { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.home-group-title { font-weight: 650; }
.home-group-summary {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: var(--font-caption);
}
.home-group-image { flex: none; width: 34%; height: 116rpx; border-radius: 16rpx; }
.home-public button.home-signin {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 44px;
  gap: 15rpx;
  margin: 20rpx 0 4rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(110deg, #085eb8, #176ec3);
  color: #fff;
  text-align: left;
  white-space: normal;
}
.home-signin-copy { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 700; }
.home-signin-copy text { display: block; margin-top: 4rpx; font-size: var(--font-caption); font-weight: 400; }

@media (max-width: 359px) {
  .home-public-hero, .workbench-hero { margin-left: calc(-1 * var(--space-lg)); margin-right: calc(-1 * var(--space-lg)); }
  button.home-tool:not([size="mini"]) { flex-direction: column; align-items: flex-start; }
  .workbench-task { grid-template-columns: auto minmax(0, 1fr); }
  .workbench-task-actions { grid-column: 2; display: flex; align-items: center; flex-wrap: wrap; }
  .workbench-record-state { grid-column: 2; justify-content: space-between; }
  .home-services { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
