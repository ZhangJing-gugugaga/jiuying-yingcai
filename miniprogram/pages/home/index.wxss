.home-header{margin-bottom:30rpx;padding:6rpx 0 14rpx;flex-wrap:wrap}
.home-header>.grow{flex-basis:340rpx}
.home-mark{width:76rpx;height:76rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:21rpx;background:var(--brand-deep,#174a80);color:#fff;font-size:39rpx;font-weight:650}
.home-title{color:var(--text,#1c3048);font-size:43rpx;font-weight:700;line-height:1.21}
.home-caption{margin-top:8rpx;color:var(--muted,#52677e);font-size:24rpx}
.home-login{max-width:100%;min-height:44px;padding:13rpx 21rpx;background:var(--brand-soft,#eaf4ff);color:var(--brand-deep,#174a80);font-size:24rpx}
.home-todo-card .list-item{padding:14rpx 0}
.home-todo-card .list-item:first-child{padding-top:0}
.home-todo-card .list-item:last-child{padding-bottom:0;border-bottom:0}
.home-todo-card button{flex-shrink:0}
.home-todo-card .home-todo-overdue{padding:14rpx 12rpx;border-radius:14rpx;background:var(--error-bg,#fff0ee)}
.home-due{margin-top:5rpx;font-size:24rpx;color:var(--muted,#52677e)}
.home-todo-overdue .home-due{color:var(--error-text,#9f4135)}
.home-progress-link{margin:0 0 8rpx auto}
.home-tools{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx}
.home-tool{width:100%;min-height:max(88rpx,44px);padding:12rpx 8rpx;border:1rpx solid var(--border,#dfe7f2);background:var(--surface,#fff);color:var(--text,#1c3048);font-size:26rpx}
.home-summary{margin:30rpx 0 24rpx}

.home-services{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin-bottom:30rpx}
.home-service{display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;gap:10rpx;width:100%;min-width:0;margin:0;padding:10rpx 10rpx 14rpx;border:1rpx solid var(--border,#dfe7f2);border-radius:20rpx;background:var(--surface,#fff);color:var(--text,#1c3048);text-align:center;line-height:1.4}
.home-service-image,.home-service-placeholder{width:100%;height:104rpx;border-radius:12rpx;background:var(--brand-soft,#eaf4ff)}
.home-service-placeholder{display:flex;align-items:center;justify-content:center;color:var(--brand-deep,#174a80);font-size:38rpx;font-weight:650}
.home-service-title{font-size:26rpx;font-weight:650;overflow-wrap:anywhere}
.home-content-empty{padding:25rpx;border-radius:20rpx;background:var(--surface,#fff);border:1rpx solid var(--border,#dfe7f2);color:var(--muted,#52677e);font-size:25rpx}
.home-map-card{border-radius:28rpx;background:linear-gradient(120deg,var(--brand-deep,#174a80),var(--brand,#0e65b7));color:#fff;padding:32rpx 28rpx;margin-bottom:18rpx}
.home-map-label{font-size:40rpx;font-weight:700;line-height:1.32;overflow-wrap:anywhere}
.home-map-caption{margin-top:12rpx;color:#e0edfa;font-size:27rpx}
.home-map-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:17rpx}
.home-map-actions button{margin:0;min-width:0}
.home-map-actions .primary{background:#fff;color:var(--brand-deep,#174a80)}
.home-map-actions .outline{background:transparent;color:#fff;border-color:#a8cfef}
.home-contact-card{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12rpx;border:1rpx solid var(--border,#dfe7f2);border-radius:22rpx;background:var(--surface,#fff);padding:0 16rpx}
.home-contact{flex:1 1 180rpx;display:flex;align-items:center;min-width:0;margin:0;padding:14rpx 10rpx;background:transparent;color:var(--text,#1c3048);text-align:left;line-height:1.45;overflow-wrap:anywhere}
.home-dial{margin:0}
.home-secondary{padding-top:0;padding-bottom:0}
.home-secondary button{width:100%}
.home-secondary button + button{border-top:1rpx solid var(--border,#dfe7f2);border-radius:0}
