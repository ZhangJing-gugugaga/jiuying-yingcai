.home-page {
  --home-ice: #eaf3ff;
  --home-mint: #e6f5f0;
  --home-teal: #186b59;
  --home-amber: #fff3df;
  --home-rust: #8c5419;
  --home-shadow: rgba(21, 53, 105, .07);
  --workbench-scope-overlap: 32rpx;
}
.home-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, var(--brand), var(--brand-deep));
  color: var(--surface);
  font-size: 39rpx;
  font-weight: 650;
}
.home-caption { margin-top: 5rpx; color: var(--muted); font-size: var(--font-caption); }
.workbench-hero {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 190rpx;
  margin: calc(-1 * var(--space-xl)) calc(-1 * var(--space-xl)) 0;
  padding: 12rpx 28rpx calc(var(--workbench-scope-overlap) + 4rpx);
  background: linear-gradient(125deg, #eff7ff 10%, #bfddff);
  color: var(--brand-deep);
  overflow: hidden;
}
.workbench-hero-copy { z-index: 1; max-width: 75%; }
.workbench-tagline {
  margin-top: 5rpx;
  color: var(--brand-deep);
  font-size: var(--font-caption);
  overflow-wrap: anywhere;
}
.workbench-greeting { margin-top: 4rpx; color: var(--text); font-size: 38rpx; font-weight: 700; overflow-wrap: anywhere; }
.home-page button.workbench-notices {
  z-index: 1;
  width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  display: grid;
  place-items: center;
  background: var(--surface);
  color: var(--brand);
  border-radius: 50%;
}
.workbench-scope {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: calc(-1 * var(--workbench-scope-overlap));
  margin-bottom: 12rpx;
  padding: 3rpx var(--space-md);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: 0 6rpx 18rpx var(--home-shadow);
}
.workbench-scope-content { min-width: 0; flex: 1; }
.workbench-scope-name { min-width: 0; color: var(--text); font-size: 28rpx; font-weight: 700; overflow-wrap: anywhere; }
.workbench-scope-line { display: flex; align-items: center; gap: var(--space-xs); }
.workbench-scope-line .workbench-meta, .workbench-scope-arrow { flex: none; }
.home-page button.workbench-scope-trigger, .home-page button.workbench-scope-choice {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 44px;
  margin: 0;
  padding: 4rpx 0;
  background: transparent;
  color: var(--text);
  text-align: left;
}
.workbench-scope-choices {
  flex: 1 0 100%;
  min-width: 0;
  border-top: 1rpx solid var(--border);
}
.workbench-scope-scroll { height: 240px; }
.home-page button.workbench-scope-choice {
  justify-content: space-between;
  gap: var(--space-sm);
  border-radius: 0;
  border-bottom: 1rpx solid var(--border);
  padding: 8rpx var(--space-sm);
}
.home-page button.workbench-scope-choice[aria-pressed="true"] { color: var(--brand); }
.workbench-scope-choice-copy { min-width: 0; overflow-wrap: anywhere; }
.workbench-scope-choice-copy .workbench-meta { display: block; }
.workbench-scope-check { flex: none; color: var(--brand); }
.workbench-scope-icon { display: grid; place-items: center; width: 64rpx; height: 64rpx; flex: none; color: var(--brand); background: var(--home-ice); border-radius: 50%; }
.home-page button.workbench-scope-action { width: 100%; margin: 0 0 var(--space-md); }
.workbench-meta { color: var(--muted); font-size: var(--font-caption); overflow-wrap: anywhere; }
.workbench-row-meta { display: flex; align-items: baseline; gap: 0 8rpx; }
.workbench-row-outlet { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.workbench-row-detail { flex: none; max-width: 100%; }
.home-tools {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  overflow: hidden;
  margin-bottom: 12rpx;
  padding: 2rpx 6rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  box-shadow: 0 6rpx 18rpx var(--home-shadow);
}
button.home-tool:not([size="mini"]) {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
  grid-column: span 2;
  min-height: 44px;
  margin: 0;
  padding: 8rpx 7rpx;
  border-right: 1rpx solid var(--border);
  border-bottom: 1rpx solid var(--border);
  border-radius: 0;
  background: transparent;
  color: var(--text);
  text-align: left;
}
.home-tools button.home-tool:nth-child(3n), .home-tools button.home-tool:last-child { border-right: 0; }
.home-tools-five button.home-tool:nth-child(n+4) { grid-column: span 3; }
.home-tools button.home-tool:nth-child(n+4) { border-bottom: 0; }
.home-tool-copy { min-width: 0; flex: 1; line-height: 1.32; }
.home-tool-label, .home-tool-note { display: block; overflow-wrap: anywhere; }
.home-tool-label { font-size: max(24rpx, 12px); font-weight: 700; }
.home-tool-note { margin-top: 3rpx; color: var(--muted); font-size: max(20rpx, 10px); }
.home-tool-icon, .workbench-task-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.home-tool-icon { width: 60rpx; height: 60rpx; }
@media (max-width: 350px) {
  button.home-tool:not([size="mini"]) { gap: 4rpx; padding: 8rpx 3rpx; }
  .home-tool-icon { width: 54rpx; height: 54rpx; }
}
.workbench-task-icon { width: 66rpx; height: 66rpx; }
.workbench-task {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) minmax(0, auto);
  align-items: start;
  gap: var(--space-sm);
  padding: 4rpx 0;
  border-top: 1rpx solid var(--border);
}
.workbench-task-title, .workbench-reason { overflow-wrap: anywhere; }
.workbench-task-title { font-size: max(27rpx, 14px); font-weight: 700; line-height: 1.3; }
.workbench-task .workbench-row-meta, .workbench-reason {
  font-size: max(23rpx, 12px);
  line-height: 1.35;
}
.workbench-reason {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--error-text);
  white-space: pre-wrap;
}
.workbench-pending {
  grid-template-columns: auto minmax(0, 1fr) minmax(0, max-content) auto;
  grid-template-rows: auto auto auto;
  align-content: center;
  align-items: center;
  column-gap: var(--space-xs);
  row-gap: 0;
}
.workbench-pending .workbench-task-icon { grid-column: 1; grid-row: 1 / 4; }
.workbench-pending .workbench-task-title { grid-column: 2; grid-row: 1; }
.workbench-pending .workbench-row-meta {
  grid-column: 2 / 4;
  grid-row: 2;
  flex-wrap: wrap;
}
.workbench-pending .workbench-task-state {
  grid-column: 3;
  grid-row: 1;
  max-width: 5em;
  padding: 3rpx 8rpx;
  text-align: center;
  overflow-wrap: anywhere;
}
.workbench-pending .workbench-reason { grid-column: 2 / 4; grid-row: 3; }
.workbench-record { min-height: 44px; align-items: center; }
.workbench-record .workbench-row-outlet { min-width: min(4em, 40%); }
.workbench-record .workbench-row-detail { max-width: max(calc(60% - 8rpx), calc(100% - 4em - 8rpx)); }
.workbench-row-outlet-qualified { white-space: normal; overflow-wrap: anywhere; }
.workbench-row-meta-qualified { flex-wrap: wrap; }
.workbench-record .workbench-row-meta-qualified .workbench-row-detail { max-width: 100%; }
.workbench-record .workbench-row-detail { white-space: nowrap; }
.workbench-record-state { display: flex; align-items: center; gap: var(--space-xs); color: var(--muted); overflow-wrap: anywhere; }
.workbench-badge { padding: 3rpx 13rpx; border-radius: 999rpx; font-size: var(--font-caption); }
.home-page button.workbench-task-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  grid-column: 4;
  grid-row: 1 / 4;
  width: 72px;
  max-width: 100%;
  min-height: 44px;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  color: var(--brand);
  font-size: var(--font-caption);
}
.workbench-action-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3px;
  width: 100%;
  min-height: 26px;
  padding: 2px 5px;
  border: 1rpx solid var(--brand);
  border-radius: 999rpx;
  background: var(--surface);
  line-height: 1.25;
}
.workbench-action-label {
  min-width: 0;
  overflow-wrap: anywhere;
}
@media (max-width: 350px) {
  .workbench-pending .workbench-task-title { grid-column: 2 / 4; }
  .workbench-pending .workbench-task-state { grid-column: 4; justify-self: end; }
  .home-page .workbench-pending button.workbench-task-action { grid-row: 2 / 4; }
}
.workbench-more { display: flex; gap: var(--space-sm); flex-wrap: wrap; }
.workbench-more-scope { flex-basis: 100%; color: var(--muted); font-size: var(--font-caption); overflow-wrap: anywhere; }
.workbench-more button { width: auto; }
.home-trial { margin-top: var(--space-xl); }
.ice, .blue { background: var(--home-ice); color: var(--brand); }
.amber { background: var(--home-amber); color: var(--home-rust); }
.mint, .green { background: var(--home-mint); color: var(--home-teal); }
.violet { background: #eeeaff; color: #594ac2; }
.red { background: var(--error-bg); color: var(--error-text); }
.gray { background: var(--surface-muted); color: var(--muted); }

.home-page.home-public {
  --home-public-gutter: 20rpx;
  padding-left: var(--home-public-gutter);
  padding-right: var(--home-public-gutter);
}
.home-public-hero {
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  min-height: 276rpx;
  margin: calc(-1 * var(--space-xl)) calc(-1 * var(--home-public-gutter)) 0;
  padding: 28rpx 34rpx 40rpx;
  background: linear-gradient(125deg, #f2f8ff 15%, #c6e1ff);
  color: #122b53;
}
.home-public-art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.home-public-hero-copy { position: relative; z-index: 1; max-width: 66%; }
.home-public-brand { display: flex; align-items: center; gap: 12rpx; font-size: 28rpx; font-weight: 700; }
.home-public-brand .home-mark { width: 46rpx; height: 46rpx; border-radius: 12rpx; font-size: 26rpx; }
.home-brand-logo { width: 46rpx; height: 46rpx; flex: none; }
.home-public-title { display: flex; flex-wrap: wrap; gap: 0 12rpx; margin-top: 18rpx; font-size: 44rpx; font-weight: 750; line-height: 1.24; }
.home-public-title text { white-space: nowrap; }
.home-public-caption { margin-top: 10rpx; color: var(--muted); font-size: var(--font-caption); }
.home-public-hero-copy::after {
  display: block;
  width: 48rpx;
  height: 4rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: var(--brand);
  content: "";
}
.home-public-section {
  --home-section-title-inset: 18rpx;
  margin-top: 16rpx;
  padding: 14rpx 18rpx 18rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: 0 5rpx 18rpx var(--home-shadow);
}
.home-section-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4rpx 12rpx; }
.home-section-title {
  padding-left: 12rpx;
  border-left: 6rpx solid var(--brand);
  color: #122b53;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.18;
}
.home-public .home-public-section { margin-top: 14rpx; padding: 0 18rpx 6rpx; }
.home-public-section.workbench-section { margin-top: 12rpx; padding-block: 2rpx 9rpx; }
.workbench-compact .workbench-scope { margin-bottom: 8rpx; }
.workbench-compact .home-tools { margin-bottom: 8rpx; }
.workbench-compact .workbench-section { margin-top: 8rpx; padding-block: 0 5rpx; }
.workbench-compact .workbench-task { padding-block: 0; }
@media (min-width: 375px) {
  .workbench-compact .workbench-hero { padding-top: 6rpx; }
  .workbench-compact .workbench-tagline,
  .workbench-compact .workbench-greeting { margin-top: 2rpx; }
  .workbench-compact .home-caption { margin-top: 0; }
  .workbench-compact .workbench-tagline,
  .workbench-compact .home-caption { line-height: 1.28; }
  .workbench-compact .workbench-scope { padding-block: 1rpx; }
  .workbench-compact .workbench-task-state { line-height: 1.15; }
  .workbench-compact .workbench-reason { -webkit-line-clamp: 1; }
}
.home-public .home-business { margin-top: 0; }
.home-page button.home-text-action {
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  width: auto;
  min-height: 44px;
  margin: 0;
  padding: 4rpx 0;
  background: transparent;
  color: var(--brand-deep);
  font-size: var(--font-caption);
  white-space: normal;
}
.home-services { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12rpx; }
.home-public button.home-service {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  justify-items: center;
  align-content: start;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
  min-height: max(120rpx, 44px);
  margin: 0;
  padding: 12rpx 2rpx;
  border-radius: 16rpx;
  background: var(--tile-bg, #eaf3ff);
  color: var(--tile-icon, #1767be);
  white-space: normal;
}
.home-service-title { color: var(--text); font-size: max(23rpx, 12px); font-weight: 650; line-height: 1.35; overflow-wrap: anywhere; }
.home-service-summary {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--muted);
  font-size: max(20rpx, 10px);
  line-height: 1.30;
  overflow-wrap: anywhere;
}
.home-service-image { width: 100%; height: 62rpx; border-radius: 9rpx; }
.home-service.sky { --tile-bg: #e6f4fc; --tile-icon: #076d9f; }
.home-service.violet { --tile-bg: #eeeaff; --tile-icon: #594ac2; }
.home-service.gold { --tile-bg: #fcf1e2; --tile-icon: #a15408; }
.home-service.green { --tile-bg: #e5f6ee; --tile-icon: #107652; }
.home-content-status { margin: 10rpx 0; color: var(--muted); font-size: var(--font-caption); }
.home-network {
  position: relative;
  overflow: hidden;
  background: var(--surface);
}
.home-network-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.home-network .home-section-head, .home-network-actions, .home-network-caption { position: relative; }
.home-network-caption { margin: 0 0 4rpx var(--home-section-title-inset); color: var(--muted); font-size: var(--font-caption); }
.home-network-actions, .home-contact-actions { display: grid; gap: 10rpx; }
.home-network-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: max(446rpx, 17em); }
.home-contact-actions { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.home-contact-channels { display: flex; gap: 10rpx; }
.home-public .home-contact-channels button.home-contact { flex: 1; width: auto; min-width: 0; justify-content: center; }
.home-contact-icon { flex: none; color: var(--brand); }
.home-contact-copy { min-width: 0; color: var(--text); text-align: left; overflow-wrap: anywhere; }
.home-contact-secondary { margin-top: 10rpx; }
.home-contact-head { min-height: 44px; }
.home-public button.home-region, .home-public button.home-contact {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 8rpx 10rpx;
  border: 1rpx solid #cbdff7;
  border-radius: var(--radius-control);
  background: var(--surface);
  color: var(--brand-deep);
  font-size: max(25rpx, 13px);
  white-space: normal;
}
.home-public button.home-region { border-radius: 999rpx; background: #f3f8ff; }
.home-public button.home-contact { padding: 5rpx; gap: 5rpx; font-size: max(22rpx, 12px); }
.home-public button.home-region-primary { border-color: var(--brand); background: var(--brand); color: #fff; }
.home-contact-detail {
  display: block;
  color: var(--muted);
  font-size: max(20rpx, 10px);
  font-weight: 400;
  line-height: 1.25;
  overflow-wrap: anywhere;
}
.home-group-with-cover {
  display: grid;
  grid-template-columns: minmax(0, 1fr) clamp(90px, 31vw, 136px);
  column-gap: 12rpx;
}
.home-public .home-group { min-height: 44px; padding-block: 8rpx 6rpx; }
.home-group-copy { min-width: 0; overflow-wrap: anywhere; }
.home-group-copy .home-section-title { margin-bottom: 4rpx; }
.home-group-title, .home-group-summary, .home-group-link, .home-group-copy .home-content-status {
  margin-left: var(--home-section-title-inset);
}
.home-group-link { margin-top: 4rpx; color: var(--brand); font-size: var(--font-caption); font-weight: 650; }
.home-group-title { font-weight: 650; }
.home-group-summary {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  color: var(--muted);
  font-size: max(23rpx, 12px);
  line-height: 1.35;
}
.home-group-image {
  grid-column: 2;
  grid-row: 1;
  align-self: center;
  width: 100%;
  height: 164rpx;
  border-radius: 16rpx;
}
.home-public button.home-signin {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 44px;
  gap: 15rpx;
  margin: 8rpx 0 4rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-card);
  background: radial-gradient(ellipse at 100% 0%, rgba(145, 208, 255, .42), transparent 46%),
    linear-gradient(110deg, #095db8, #176ec3);
  color: #fff;
  text-align: left;
  white-space: normal;
}
.home-signin-copy { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 700; }
.home-signin-copy text { display: block; margin-top: 4rpx; font-size: var(--font-caption); font-weight: 400; }
.home-public-wave {
  height: 52rpx;
  margin: 12rpx calc(-1 * var(--home-public-gutter)) 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 75% 143%, #c3defa 0 49%, transparent 50%),
    radial-gradient(ellipse at 22% 154%, #e1eeff 0 61%, transparent 62%);
}

@media (max-width: 359px) {
  .workbench-hero { margin-left: calc(-1 * var(--space-lg)); margin-right: calc(-1 * var(--space-lg)); }
  .workbench-task-icon { width: 54rpx; height: 54rpx; }
  .home-public .home-public-section:not(.home-business) { margin-top: 8rpx; }
  .home-group-with-cover { grid-template-columns: minmax(0, 1fr) max(80px, calc(31vw - var(--home-section-title-inset))); }
  .home-services { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .home-services-five { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6rpx; }
  .home-public .home-services-five button.home-service { padding-block: 6rpx; gap: 5rpx; }
  .home-services-five .home-service-title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .home-services-five .home-service-summary { text-wrap: balance; }
}

@media (max-width: 299px) {
  .home-services-five { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
