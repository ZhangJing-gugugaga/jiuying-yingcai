.home-page {
  --home-ice: #eaf3ff;
  --home-sky: #d7e8ff;
  --home-mint: #e6f5f0;
  --home-teal: #186b59;
  --home-amber: #fff3df;
  --home-rust: #8c5419;
  --home-pattern: rgba(37, 98, 190, .1);
  --home-shadow: rgba(21, 53, 105, .07);
}
.home-header { margin-bottom: var(--space-md); flex-wrap: wrap; }
.home-member .home-header {
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  background:
    repeating-linear-gradient(128deg, transparent 0 28rpx, var(--home-pattern) 29rpx 30rpx, transparent 31rpx 56rpx),
    linear-gradient(110deg, var(--surface) 28%, var(--home-ice));
}
.home-header > .grow { flex-basis: 320rpx; }
.home-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, var(--brand), var(--brand-deep));
  color: var(--surface);
  font-size: 39rpx;
  font-weight: 650;
}
.home-title { font-size: 39rpx; font-weight: 700; line-height: 1.24; }
.home-caption { margin-top: 5rpx; color: var(--muted); font-size: var(--font-caption); }
.home-tools {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-sm);
}
.home-tools { margin-bottom: var(--space-md); }
.home-tool {
  display: grid;
  justify-items: start;
  align-content: center;
  gap: 6rpx;
  min-height: max(188rpx, 84px);
  padding: var(--space-md);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  background: var(--surface);
  color: var(--brand-deep);
  text-align: left;
  box-shadow: 0 5rpx 22rpx var(--home-shadow);
}
button.home-tool:not([size="mini"]) {
  width: 100%;
  min-width: 0;
  margin: 0;
}
.home-tool-label { margin-top: var(--space-xs); font-size: 32rpx; font-weight: 700; }
.home-tool-note { max-width: 100%; color: var(--muted); font-size: var(--font-caption); overflow-wrap: anywhere; }
.home-tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.home-tool-icon { width: 62rpx; height: 62rpx; border-radius: 18rpx; }
.home-trial { margin-top: var(--space-xl); }

.ice { background: var(--home-ice); color: var(--brand); }
.amber { background: var(--home-amber); color: var(--home-rust); }
.mint { background: var(--home-mint); color: var(--home-teal); }

.home-public-hero {
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  min-height: 272rpx;
  margin: -24rpx -24rpx 0;
  padding: 28rpx 34rpx 40rpx;
  background: linear-gradient(125deg, #f2f8ff 15%, #c6e1ff);
  color: #122b53;
}
.home-public-art {
  position: absolute;
  top: 0;
  right: 0;
  width: 55%;
  height: 100%;
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 30%);
  mask-image: linear-gradient(90deg, transparent, #000 30%);
}
.home-public-hero-copy { position: relative; z-index: 1; max-width: 61%; }
.home-public-brand { display: flex; align-items: center; gap: 12rpx; font-size: 28rpx; font-weight: 700; }
.home-public-brand .home-mark { width: 46rpx; height: 46rpx; border-radius: 12rpx; font-size: 26rpx; }
.home-public-title { margin-top: 18rpx; font-size: 40rpx; font-weight: 750; line-height: 1.24; }
.home-public-caption { margin-top: 10rpx; color: var(--muted); font-size: var(--font-caption); }
.home-public-section {
  margin-top: 16rpx;
  padding: 14rpx 18rpx 18rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: 0 5rpx 18rpx var(--home-shadow);
}
.home-section-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4rpx 12rpx; }
.home-section-title {
  padding-left: 12rpx;
  border-left: 6rpx solid var(--brand);
  color: #122b53;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.18;
}
.home-public-section > .home-section-title { margin: 12rpx 0 16rpx; }
.home-public button.home-text-action {
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  width: auto;
  min-height: 44px;
  margin: 0;
  padding: 4rpx 0;
  background: transparent;
  color: var(--brand-deep);
  font-size: var(--font-caption);
  white-space: normal;
}
.home-public button.home-group-link { margin-bottom: -10rpx; }
.home-services { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 9rpx; }
.home-public button.home-service {
  display: grid;
  justify-items: center;
  align-content: start;
  gap: 10rpx;
  width: 100%;
  min-width: 0;
  min-height: max(120rpx, 44px);
  margin: 0;
  padding: 12rpx 5rpx;
  border-radius: 16rpx;
  background: var(--tile-bg, #eaf3ff);
  color: var(--tile-icon, #1767be);
  white-space: normal;
}
.home-service-title { color: var(--text); font-size: max(23rpx, 12px); font-weight: 650; line-height: 1.35; overflow-wrap: anywhere; }
.home-service-image { width: 100%; height: 62rpx; border-radius: 9rpx; }
.home-service.sky { --tile-bg: #e6f4fc; --tile-icon: #076d9f; }
.home-service.violet { --tile-bg: #eeeaff; --tile-icon: #594ac2; }
.home-service.gold { --tile-bg: #fcf1e2; --tile-icon: #a15408; }
.home-service.green { --tile-bg: #e5f6ee; --tile-icon: #107652; }
.home-content-status { margin: 10rpx 0; color: var(--muted); font-size: var(--font-caption); }
.home-network {
  background: radial-gradient(ellipse at 100% 100%, #dbeeff, transparent 70%), var(--surface);
}
.home-network-actions, .home-contact-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.home-public button.home-region, .home-public button.home-contact {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 8rpx 10rpx;
  border: 1rpx solid #cbdff7;
  border-radius: var(--radius-control);
  background: var(--surface);
  color: var(--brand-deep);
  font-size: max(25rpx, 13px);
  white-space: normal;
}
.home-public button.home-region { border-radius: 999rpx; }
.home-public button.home-region-primary { border-color: var(--brand); background: var(--brand); color: #fff; }
.home-contact-detail { display: block; color: var(--muted); font-size: var(--font-caption); overflow-wrap: anywhere; }
.home-group { display: flex; align-items: flex-start; gap: 16rpx; }
.home-group-copy { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.home-group-title { font-weight: 650; }
.home-group-summary {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: var(--font-caption);
}
.home-group-image { flex: none; width: 34%; height: 116rpx; border-radius: 16rpx; }
.home-public button.home-signin {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 44px;
  gap: 15rpx;
  margin: 20rpx 0 4rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(110deg, #085eb8, #176ec3);
  color: #fff;
  text-align: left;
  white-space: normal;
}
.home-signin-copy { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 700; }
.home-signin-copy text { display: block; margin-top: 4rpx; font-size: var(--font-caption); font-weight: 400; }

@media (max-width: 359px) {
  .home-header > .grow { flex-basis: 288rpx; }
  .home-tool { padding: var(--space-sm); }
  .home-tool-label { font-size: 30rpx; }
  .home-services { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
