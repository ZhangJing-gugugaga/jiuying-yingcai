page, .activity-tabs {
  --brand: #1555c0;
  --brand-deep: #122e5d;
  --brand-soft: #eaf1ff;
  --brand-on-dark: #e2ecff;
  --background: #f3f6fb;
  --surface: #ffffff;
  --text: #132541;
  --muted: #4f627c;
  --border: #dce5f1;
  --border-strong: #a6b8d2;
  --surface-muted: #f0f4fa;
  --panel-shadow: rgba(19, 43, 84, .055);
  --focus-ring: rgba(21, 85, 192, .18);
  --neutral-bg: #edf1f5;
  --neutral-text: #526377;
  --success-bg: #e8f5ee;
  --success-text: #256648;
  --warning-bg: #fff3d8;
  --warning-text: #78541d;
  --error-bg: #fff0ee;
  --error-text: #9f4135;
  --hero-glow: rgba(255, 255, 255, .12);
  --hero-divider: rgba(255, 255, 255, .25);
  --hero-button-border: rgba(255, 255, 255, .45);

  --font-caption: 24rpx;
  --font-body: 28rpx;
  --font-section: 31rpx;
  --font-metric: 36rpx;
  --font-title: 44rpx;
  --font-display: 48rpx;
  --font-hero: 56rpx;

  --space-2xs: 4rpx;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-2xl: 64rpx;

  --radius-badge: 8rpx;
  --radius-control: 16rpx;
  --radius-card: 28rpx;
  --tab-bar-height: 116rpx;
  --td-button-primary-bg-color: var(--brand);
  --td-button-primary-border-color: var(--brand);
  --td-button-primary-active-bg-color: var(--brand-deep);
  --td-button-primary-color: var(--surface);
}
