.page {
  padding: var(--space-xl) var(--space-xl) var(--space-2xl);
  padding-bottom: calc(var(--space-2xl) + env(safe-area-inset-bottom, 0px));
  max-width: 820px;
  margin: 0 auto;
}

.tab-page {
  padding-bottom: calc(var(--tab-bar-height) + var(--space-xl) + env(safe-area-inset-bottom, 0px));
}

.title {
  font-size: var(--font-title);
  font-weight: 650;
  margin: var(--space-2xs) 0 var(--space-md);
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.subtitle {
  color: var(--muted);
  font-size: var(--font-body);
  margin-bottom: var(--space-lg);
  overflow-wrap: anywhere;
}

.section-title {
  font-size: var(--font-section);
  font-weight: 650;
  margin: var(--space-xl) 0 var(--space-md);
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.section-head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-md);
  margin: var(--space-xl) 0 var(--space-md);
}

.section-head .section-title {
  margin: 0;
  min-width: 0;
  overflow-wrap: anywhere;
}

.section-head > button {
  width: auto;
  max-width: 100%;
}

.row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.between {
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
  word-wrap: break-word;
  overflow-wrap: anywhere;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-lg);
}

.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-lg);
  margin: var(--space-xl) 0 var(--space-2xs);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-md);
  margin-top: var(--space-xl);
}

.actions button {
  flex: 1 1 180rpx;
  min-width: 0;
}

.divider {
  height: 1rpx;
  background: var(--border);
  margin: var(--space-xl) 0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: var(--space-xl);
  padding: var(--space-md) 0;
  font-size: var(--font-body);
  overflow-wrap: anywhere;
}

.detail-row + .detail-row {
  border-top: 1rpx solid var(--border);
}

.detail-row > text {
  min-width: 0;
  word-wrap: break-word;
  overflow-wrap: anywhere;
}

.detail-row > text:first-child {
  color: var(--muted);
}

.detail-row > text:last-child {
  text-align: right;
  max-width: 64%;
}

.filter {
  display: flex;
  gap: var(--space-sm);
  margin: var(--space-lg) 0;
  flex-wrap: wrap;
}

.top-gap {
  margin-top: var(--space-xl);
}

.two-col {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-lg);
}

.two-col .field {
  margin: var(--space-sm) 0;
}

.pagination {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  margin: var(--space-lg) 0;
  padding: var(--space-lg) 0;
  border-top: 1rpx solid var(--border);
}

.pagination .muted {
  font-size: var(--font-caption);
}

.compact .title {
  font-size: var(--font-title);
}

.pagination button {
  flex-shrink: 0;
}

.action-dock {
  position: sticky;
  bottom: 0;
  z-index: 2;
  border-top: 1rpx solid var(--border);
  background: var(--surface);
  padding: var(--space-md) 0;
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom, 0px));
}

.amount-number {
  font-variant-numeric: tabular-nums;
  text-align: right;
  min-width: 0;
  overflow-wrap: anywhere;
}

@media (max-width: 359px) {
  .page {
    padding-left: var(--space-lg);
    padding-right: var(--space-lg);
  }

  .two-col {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xs);
  }
}

.metric-value,
.hero-number {
  font-variant-numeric: tabular-nums;
  min-width: 0;
  overflow-wrap: anywhere;
}
