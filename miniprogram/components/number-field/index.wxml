<view class="number-field">
  <label class="number-label" for="number-{{field}}">{{label}}<text wx:if="{{required}}" class="number-required" aria-hidden="true">*</text></label>
  <view class="number-control-wrap">
    <input id="number-{{field}}" class="number-control {{focused ? 'focused' : ''}} {{error ? 'invalid' : ''}} {{!focused && formattedValue ? 'number-control-formatted' : ''}}"
      name="{{field}}" type="{{keyboard}}" value="{{value}}" placeholder="{{placeholder}}" disabled="{{disabled}}"
      focus="{{focus && !disabled}}" confirm-type="{{confirmType}}" confirm-hold="{{confirmType==='next'}}"
      aria-label="{{label + (required ? '，必填' : '') + (error ? '，' + error : '')}}" aria-invalid="{{!!error}}" cursor-spacing="24"
      bindfocus="handleFocus" bindinput="handleInput" bindblur="handleBlur"
      bindconfirm="handleConfirm" bindkeyboardheightchange="handleKeyboardHeightChange"/>
    <text wx:if="{{!focused && formattedValue}}" class="number-preview" aria-hidden="true">{{formattedValue}}</text>
  </view>
  <view wx:if="{{error}}" class="number-error" aria-live="polite">{{error}}</view>
  <view wx:elif="{{hint}}" class="number-hint">{{hint}}</view>
</view>
