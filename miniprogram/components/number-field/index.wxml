<view class="number-field">
  <label class="number-label" for="number-{{field}}">{{label}}</label>
  <input id="number-{{field}}" class="number-control {{focused ? 'focused' : ''}} {{error ? 'invalid' : ''}}"
    name="{{field}}" type="{{keyboard}}" value="{{value}}" placeholder="{{placeholder}}" disabled="{{disabled}}"
    aria-label="{{error ? label + '，' + error : label}}" cursor-spacing="24"
    bindfocus="handleFocus" bindinput="handleInput" bindblur="handleBlur"/>
  <view wx:if="{{error}}" class="number-error" aria-live="polite">{{error}}</view>
  <view wx:elif="{{hint}}" class="number-hint">{{hint}}</view>
</view>
