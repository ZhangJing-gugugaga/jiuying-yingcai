@import "../styles/tokens.wxss";

.activity-tabs {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  box-sizing: border-box;
  min-height: var(--tab-bar-height);
  min-height: calc(var(--tab-bar-height) + env(safe-area-inset-bottom, 0px));
  padding: 0 env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
  border-top: 1rpx solid var(--border);
  background-color: var(--surface);
}

.activity-tab {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-width: 0;
  min-height: 88rpx;
  min-height: max(88rpx, 44px);
  gap: var(--space-2xs, 4rpx);
  color: var(--muted);
  font-size: max(25rpx, 13px);
  line-height: 1.3;
}

.activity-tab-active {
  color: var(--brand);
  font-weight: 650;
}

.activity-tab:active {
  background-color: var(--surface-muted);
}

.activity-tab-icon {
  width: max(46rpx, 23px);
  height: max(46rpx, 23px);
  flex: none;
}

.activity-tab-label {
  white-space: normal;
  text-align: center;
  overflow-wrap: anywhere;
}
